<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <AcceptEula>wix7</AcceptEula>
    <OutputName>RouterPilot-2.0.1-x64</OutputName>
    <InstallerPublishDir>$(MSBuildThisFileDirectory)obj\publish\win-x64\</InstallerPublishDir>
  </PropertyGroup>

  <Target Name="PublishApplicationForInstaller" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="$(InstallerPublishDir)" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\RouterPilot\RouterPilot.csproj"
             Targets="Restore"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64" />
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\RouterPilot\RouterPilot.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(InstallerPublishDir)" />
  </Target>

  <ItemGroup>
    <BindPath Include="$(InstallerPublishDir)"
              BindName="publish" />
  </ItemGroup>
</Project>
