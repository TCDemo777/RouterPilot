<UserControl x:Class="RouterPilot.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.WindowBackground}"
             Foreground="{DynamicResource Brush.TextPrimary}">
    <UserControl.Resources>
        <Style x:Key="About.OutputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="About.ToolbarButton" TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid
          ClipToBounds="True"
          Background="{DynamicResource Brush.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,24,24,0">
            <TextBlock Style="{DynamicResource Text.PageTitle}"
                       Text="About"/>
                    <TextBlock Margin="0,5,0,0"
                       Style="{DynamicResource Text.Secondary}"
                       Text="Desktop management for GL.iNet routers"/>
        </StackPanel>

        <TabControl Grid.Row="2"
                     Margin="24,0,0,0"
                     Style="{StaticResource RouterPilotTabControlStyle}"
                     ItemContainerStyle="{StaticResource RouterPilotTabItemStyle}"
                     VerticalContentAlignment="Stretch"
                    Background="{DynamicResource Brush.WindowBackground}"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0">
            <TabItem Header="About">
                <Grid x:Name="AboutSurface">
                <ScrollViewer x:Name="AboutContentHost"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,24,24">
                        <Border Style="{DynamicResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="136" Height="136" Padding="8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="26">
                                    <Image Width="120"
                                       Height="120"
                                       Stretch="Uniform"
                                       x:Name="RouterPilotLogo"
                                       RenderTransformOrigin="0.5,0.5"
                                       MouseLeftButtonUp="RouterPilotLogo_Changed"
                                       Source="/Assets/RouterPilotLogo.png">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                <RotateTransform Angle="0"/>
                                                <TranslateTransform X="0" Y="0"/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{DynamicResource Text.CardValue}"
                                               Text="RouterPilot"/>
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{DynamicResource Text.Secondary}"
                                               Text="Companion for GL.iNet Routers &amp; AdGuard Home"/>
                                    <StackPanel Margin="0,3,0,0"
                                                Orientation="Horizontal">
                                        <TextBlock x:Name="VersionTextBlock"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="Version"/>
                                        <Border Margin="10,0,0,0"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.SurfaceMuted}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Text="Stable"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="BuildDateTextBlock"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="Build date"/>
                                    <TextBlock Margin="0,11,0,0"
                                               FontSize="14"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               Text="A modern Windows desktop companion for monitoring and managing supported GL.iNet routers running AdGuard Home."/>
                                    <TextBlock Margin="0,11,0,0"
                                               FontWeight="SemiBold"
                                               Text="Created and maintained by Tristan"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="Released under the GNU General Public License v3.0 only (GPL-3.0-only)."/>

                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Style="{DynamicResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,22,0">
                                    <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                               Text="Support Development"/>
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="14"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               Text="RouterPilot is free and open source and is developed independently in my spare time."/>
                                    <TextBlock Margin="0,7,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               Text="If it has helped you manage your GL.iNet router or saved you time, you can support future development through GitHub Sponsors. Every contribution helps fund development time, testing hardware and future features."/>
                                    <TextBlock Margin="0,9,0,0"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="Thank you for using RouterPilot."/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button
                                        MinWidth="178"
                                        Height="40"
                                        Padding="16,7"
                                        VerticalAlignment="Center"
                                        Click="SupportDevelopment_Click"
                                        Content="★ Support Development"/>
                                    <Button MinWidth="170"
                                            Height="40"
                                            Margin="8,0,0,0"
                                            Padding="16,7"
                                            Click="BuyMeACoffee_Click"
                                            Content="☕ Buy Me a Coffee"
                                            ToolTip="Support RouterPilot development"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                           Text="Resources"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Margin="0,0,8,8" Padding="14,6">
                                        <TextBlock>
                                            <Hyperlink NavigateUri="https://github.com/TCDemo777/RouterPilot"
                                                       RequestNavigate="GitHubLink_RequestNavigate">GitHub</Hyperlink>
                                        </TextBlock>
                                    </Button>
                                    <Button Margin="0,0,8,8" Padding="14,6">
                                        <TextBlock>
                                            <Hyperlink NavigateUri="https://github.com/TCDemo777/RouterPilot#readme"
                                                       RequestNavigate="GitHubLink_RequestNavigate">Documentation</Hyperlink>
                                        </TextBlock>
                                    </Button>
                                    <Button Margin="0,0,8,8" Padding="14,6">
                                        <TextBlock>
                                            <Hyperlink NavigateUri="https://github.com/TCDemo777/RouterPilot/issues/new"
                                                       RequestNavigate="GitHubLink_RequestNavigate">Report an issue</Hyperlink>
                                        </TextBlock>
                                    </Button>
                                    <Button Margin="0,0,8,8"
                                            Padding="14,6"
                                            Click="OpenLicense_Click"
                                            Content="Licence"/>
                                    <Button Margin="0,0,8,8"
                                            Padding="14,6"
                                            Click="OpenThirdPartyNotices_Click"
                                            Content="Third-Party Notices"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Padding="14"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Updates"/>
                                    <TextBlock x:Name="CurrentUpdateVersionTextBlock" Margin="0,4,0,0"
                                               Style="{DynamicResource Text.Secondary}"/>
                                    <TextBlock x:Name="LatestVersionTextBlock" Margin="0,3,0,0"
                                               Style="{DynamicResource Text.Secondary}"/>
                                    <TextBlock x:Name="LastUpdateCheckTextBlock" Margin="0,3,0,0"
                                               Style="{DynamicResource Text.Muted}"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <Button x:Name="OpenReleaseNotesButton" MinWidth="142" Margin="0,0,8,0"
                                            Style="{DynamicResource Button.Secondary}"
                                            Click="OpenReleaseNotes_Click" Content="Open Release Notes" IsEnabled="False"/>
                                    <Button x:Name="CheckForUpdatesButton" MinWidth="142"
                                            Style="{DynamicResource Button.Primary}"
                                            Click="CheckForUpdates_Click" Content="Check for Updates"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                           Text="Credits &amp; Acknowledgements"/>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="RouterPilot is an independent project. Product names and trademarks remain the property of their respective owners."/>

                                <TextBlock Margin="0,18,0,0"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Text="GL.iNet"/>
                                <TextBlock Margin="0,5,0,0"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="RouterPilot communicates with supported GL.iNet routers and their management interfaces to surface router health, network information and administration features."/>
                                <TextBlock Margin="0,5,0,0">
                                    <Hyperlink NavigateUri="https://www.gl-inet.com/"
                                               RequestNavigate="GitHubLink_RequestNavigate">Visit GL.iNet</Hyperlink>
                                </TextBlock>

                                <Separator Margin="0,16,0,16"/>

                                <TextBlock FontSize="15"
                                           FontWeight="Bold"
                                           Text="AdGuard Home"/>
                                <TextBlock Margin="0,5,0,0"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="DNS filtering, protection controls, statistics, client activity and query-log data are provided through AdGuard Home."/>
                                <TextBlock Margin="0,5,0,0">
                                    <Hyperlink NavigateUri="https://adguard.com/adguard-home/overview.html"
                                               RequestNavigate="GitHubLink_RequestNavigate">Visit AdGuard Home</Hyperlink>
                                </TextBlock>

                                <Separator Margin="0,16,0,16"/>

                                <TextBlock FontSize="15"
                                           FontWeight="Bold"
                                           Text="Microsoft"/>
                                <TextBlock Margin="0,5,0,0"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="Built with .NET 9 and Windows Presentation Foundation, with Microsoft.Extensions hosting, configuration, dependency-injection and logging components."/>
                                <TextBlock Margin="0,5,0,0">
                                    <Hyperlink NavigateUri="https://dotnet.microsoft.com/"
                                               RequestNavigate="GitHubLink_RequestNavigate">Visit .NET</Hyperlink>
                                </TextBlock>

                                <Separator Margin="0,16,0,16"/>

                                <TextBlock FontSize="15"
                                           FontWeight="Bold"
                                           Text="Open-source components"/>
                                <TextBlock Margin="0,5,0,10"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="Direct package references from RouterPilot.csproj. Full notices are included in THIRD_PARTY_NOTICES.txt."/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="2.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="Component"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="Bold" Text="Licence"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="Bold" Text="Purpose"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,7,12,0" Text="CommunityToolkit.Mvvm 8.4.2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,7,0,0" Text="MVVM helpers"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,7,12,0" Text="CryptSharpStandard 1.0.0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,7,12,0" Text="ISC"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,7,0,0" Text="Router password hashing"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,7,12,0" Text="Hardcodet.NotifyIcon.Wpf 2.0.1"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,7,0,0" Text="Notification-area icon"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,7,12,0" Text="LiveChartsCore WPF 2.0.5"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,7,0,0" Text="Analytics charts"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,7,12,0" Text="Microsoft.Extensions.Configuration.Json 10.0.10"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,7,0,0" Text="JSON configuration"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,7,12,0" Text="Microsoft.Extensions.DependencyInjection 10.0.10"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="6" Grid.Column="2" Margin="0,7,0,0" Text="Dependency injection"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,7,12,0" Text="Microsoft.Extensions.Hosting 10.0.10"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="7" Grid.Column="2" Margin="0,7,0,0" Text="Application hosting"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,7,12,0" Text="Microsoft.Extensions.Logging.Debug 10.0.10"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="8" Grid.Column="2" Margin="0,7,0,0" Text="Debug logging"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,7,12,0" Text="SSH.NET 2025.1.0"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="9" Grid.Column="2" Margin="0,7,0,0" Text="SSH connectivity"/>
                                </Grid>

                                <Border Margin="0,18,0,0"
                                        Padding="14"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock FontStyle="Italic"
                                               TextWrapping="Wrap"
                                               Text="Special thanks to the GL.iNet and AdGuard teams and communities for providing the platforms, documentation and APIs that make independent tools such as RouterPilot possible."/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="FlightDeckPreflight"
                        Visibility="Collapsed"
                        Margin="0,12,24,24"
                        Padding="24"
                        ClipToBounds="True"
                        Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Canvas x:Name="CelestialCardLayer"
                                Grid.RowSpan="2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                IsHitTestVisible="False"
                                Panel.ZIndex="0"/>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock x:Name="PreflightTitle"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       Text="PRE-FLIGHT CHECKS..."/>
                            <StackPanel x:Name="PreflightChecksPanel" Margin="0,18,18,0">
                                <TextBlock x:Name="DnsCheckText" FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" Text="DNS ............... OK" Opacity="0"/>
                                <TextBlock x:Name="RoutingCheckText" Margin="0,6,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" Text="ROUTING ........... OK" Opacity="0"/>
                                <TextBlock x:Name="PacketsCheckText" Margin="0,6,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" Text="PACKETS ........... BOARDED" Opacity="0"/>
                                <TextBlock x:Name="CoffeeCheckText" Margin="0,6,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" Text="COFFEE ............ CRITICAL" Opacity="0">
                                    <TextBlock.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Viewbox Grid.Row="1" Margin="0,22,0,0" Stretch="Uniform" MaxHeight="460">
                            <Canvas Width="900" Height="430" ClipToBounds="False" Background="Transparent">
                                <Canvas x:Name="RandomSceneBackground" Width="900" Height="430" IsHitTestVisible="False"/>
                                <!-- road and site boundary -->
                                <Rectangle x:Name="LaunchRoad" Canvas.Left="16" Canvas.Top="374" Width="868" Height="34" RadiusX="8" RadiusY="8" Fill="{DynamicResource Brush.SurfaceMuted}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"/>
                                <Rectangle x:Name="LaunchRoadEdge" Canvas.Left="26" Canvas.Top="390" Width="848" Height="2" Fill="{DynamicResource Brush.Border}" Opacity="0.65"/>
                                <Rectangle Canvas.Left="86" Canvas.Top="386" Width="42" Height="3" Fill="{DynamicResource Brush.Accent}" Opacity="0.6"/>
                                <Rectangle Canvas.Left="180" Canvas.Top="386" Width="42" Height="3" Fill="{DynamicResource Brush.Accent}" Opacity="0.6"/>
                                <Rectangle Canvas.Left="716" Canvas.Top="386" Width="42" Height="3" Fill="{DynamicResource Brush.Accent}" Opacity="0.6"/>
                                <TextBlock Canvas.Left="18" Canvas.Top="354" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Text="ROUTERPILOT LAUNCH COMPLEX"/>
                                <!-- launch control building -->
                                <Canvas x:Name="LaunchControlGroup">
                                <Rectangle x:Name="LaunchControlBody" Canvas.Left="34" Canvas.Top="238" Width="190" Height="132" RadiusX="6" RadiusY="6" Fill="{DynamicResource Brush.SurfaceMuted}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="2"/>
                                <Polygon x:Name="LaunchControlRoof" Points="24,238 234,238 218,218 42,218" Fill="{DynamicResource Brush.Surface}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"/>
                                <Rectangle x:Name="LaunchControlWindowOne" Canvas.Left="52" Canvas.Top="263" Width="42" Height="34" Fill="{DynamicResource Brush.Surface}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"/>
                                <Rectangle x:Name="LaunchControlWindowTwo" Canvas.Left="108" Canvas.Top="263" Width="42" Height="34" Fill="{DynamicResource Brush.Surface}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"/>
                                <Rectangle x:Name="LaunchControlWindowThree" Canvas.Left="164" Canvas.Top="263" Width="42" Height="34" Fill="{DynamicResource Brush.Surface}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"/>
                                <Rectangle Canvas.Left="58" Canvas.Top="270" Width="30" Height="3" Fill="{DynamicResource Brush.Accent}"/>
                                <Rectangle Canvas.Left="114" Canvas.Top="270" Width="30" Height="3" Fill="{DynamicResource Brush.Accent}"/>
                                <Rectangle Canvas.Left="170" Canvas.Top="270" Width="30" Height="3" Fill="{DynamicResource Brush.Accent}"/>
                                <Rectangle x:Name="LaunchControlDoor" Canvas.Left="103" Canvas.Top="325" Width="52" Height="45" Fill="{DynamicResource Brush.Surface}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"/>
                                <TextBlock x:Name="LaunchControlLabel" Canvas.Left="57" Canvas.Top="307" FontFamily="Cascadia Mono, Consolas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Text="LAUNCH CONTROL"/>
                                <Rectangle Canvas.Left="205" Canvas.Top="194" Width="3" Height="25" Fill="{DynamicResource Brush.Border}"/>
                                <Ellipse Canvas.Left="199" Canvas.Top="186" Width="15" Height="15" Fill="{DynamicResource Brush.Accent}" Opacity="0.75"/>
                                </Canvas>
                                <!-- legacy static building geometry retained in the group above -->
                                <!-- controller and countdown, deliberately away from the rocket -->
                                <Ellipse Canvas.Left="255" Canvas.Top="292" Width="16" Height="16" Fill="{DynamicResource Brush.TextPrimary}"/>
                                <Rectangle Canvas.Left="260" Canvas.Top="307" Width="7" Height="38" Fill="{DynamicResource Brush.TextPrimary}"/>
                                <Rectangle Canvas.Left="246" Canvas.Top="314" Width="34" Height="5" Fill="{DynamicResource Brush.TextPrimary}"/>
                                <Rectangle Canvas.Left="248" Canvas.Top="343" Width="12" Height="4" Fill="{DynamicResource Brush.TextPrimary}"/>
                                <Rectangle Canvas.Left="267" Canvas.Top="343" Width="12" Height="4" Fill="{DynamicResource Brush.TextPrimary}"/>
                                <Polygon Points="276,302 310,312 276,322" Fill="{DynamicResource Brush.Accent}" Opacity="0.8"/>
                                <Border Canvas.Left="274" Canvas.Top="248" Width="72" Height="42" CornerRadius="8" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
                                    <TextBlock x:Name="CountdownText" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Text="10" TextAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="LiftOffText" Canvas.Left="268" Canvas.Top="218" FontFamily="Cascadia Mono, Consolas" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Text="LIFT OFF" Opacity="0"/>
                                <!-- safety line and spectators -->
                                <Rectangle Canvas.Left="676" Canvas.Top="334" Width="196" Height="3" Fill="{DynamicResource Brush.Warning}" Opacity="0.7"/>
                                <TextBlock Canvas.Left="698" Canvas.Top="340" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{DynamicResource Brush.Warning}" Text="KEEP CLEAR"/>
                                <Canvas x:Name="StaticSpectatorsGroup" Visibility="Collapsed"/>
                                <!-- parked support vehicle -->
                                <Canvas x:Name="StaticVehicleGroup">
                                <Rectangle x:Name="SupportVehicleBody" Canvas.Left="602" Canvas.Top="337" Width="62" Height="28" RadiusX="6" RadiusY="6" Fill="{DynamicResource Brush.SurfaceMuted}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"/>
                                <Polygon x:Name="SupportVehicleCab" Points="614,337 628,322 650,322 660,337" Fill="{DynamicResource Brush.SurfaceMuted}" Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"/>
                                <Ellipse x:Name="SupportVehicleWheelOne" Canvas.Left="612" Canvas.Top="357" Width="14" Height="14" Fill="{DynamicResource Brush.Border}"/>
                                <Ellipse x:Name="SupportVehicleWheelTwo" Canvas.Left="642" Canvas.Top="357" Width="14" Height="14" Fill="{DynamicResource Brush.Border}"/>
