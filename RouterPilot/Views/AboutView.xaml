<UserControl x:Class="RouterPilot.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.WindowBackground}"
             Foreground="{DynamicResource Brush.TextPrimary}">
    <UserControl.Resources>
        <Style x:Key="About.OutputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="About.ToolbarButton" TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid
          ClipToBounds="True"
          Background="{DynamicResource Brush.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,24,24,0">
            <TextBlock Style="{DynamicResource Text.PageTitle}"
                       Text="About"/>
                    <TextBlock Margin="0,5,0,0"
                       Style="{DynamicResource Text.Secondary}"
                       Text="Desktop management for GL.iNet routers"/>
        </StackPanel>

        <TabControl Grid.Row="2"
                     Margin="24,0,0,0"
                     Style="{StaticResource RouterPilotTabControlStyle}"
                     ItemContainerStyle="{StaticResource RouterPilotTabItemStyle}"
                     VerticalContentAlignment="Stretch"
                    Background="{DynamicResource Brush.WindowBackground}"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0">
            <TabItem Header="About">
                <ScrollViewer
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,24,24">
                        <Border Style="{DynamicResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="136" Height="136" Padding="8"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="26">
                                    <Image Width="120"
                                       Height="120"
                                       Stretch="Uniform"
                                       Source="/Assets/RouterPilotLogo.png"/>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{DynamicResource Text.CardValue}"
                                               Text="RouterPilot"/>
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{DynamicResource Text.Secondary}"
                                               Text="Companion for GL.iNet Routers &amp; AdGuard Home"/>
                                    <StackPanel Margin="0,3,0,0"
                                                Orientation="Horizontal">
                                        <TextBlock x:Name="VersionTextBlock"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="Version"/>
                                        <Border Margin="10,0,0,0"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.SurfaceMuted}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <TextBlock FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Text="Stable"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="BuildDateTextBlock"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="Build date"/>
                                    <TextBlock Margin="0,11,0,0"
                                               FontSize="14"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               Text="A modern Windows desktop companion for monitoring and managing supported GL.iNet routers running AdGuard Home."/>
                                    <TextBlock Margin="0,11,0,0"
                                               FontWeight="SemiBold"
                                               Text="Created and maintained by Tristan Caldwell"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="Released under the MIT Licence."/>

                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Margin="0,0,8,8"
                                                Padding="14,6">
                                            <TextBlock>
                                                <Hyperlink NavigateUri="https://github.com/TCDemo777/RouterPilot"
                                                           RequestNavigate="GitHubLink_RequestNavigate">GitHub</Hyperlink>
                                            </TextBlock>
                                        </Button>
                                        <Button Margin="0,0,8,8"
                                                Padding="14,6">
                                            <TextBlock>
                                                <Hyperlink NavigateUri="https://github.com/TCDemo777/RouterPilot#readme"
                                                           RequestNavigate="GitHubLink_RequestNavigate">Documentation</Hyperlink>
                                            </TextBlock>
                                        </Button>
                                        <Button Margin="0,0,8,8"
                                                Padding="14,6">
                                            <TextBlock>
                                                <Hyperlink NavigateUri="https://github.com/TCDemo777/RouterPilot/issues/new"
                                                           RequestNavigate="GitHubLink_RequestNavigate">Report an issue</Hyperlink>
                                            </TextBlock>
                                        </Button>
                                        <Button Margin="0,0,8,8"
                                                Padding="14,6"
                                                Click="SupportDevelopment_Click"
                                                Content="★ Support Development"/>
                                        <Button Margin="0,0,8,8"
                                                Padding="14,6"
                                                Click="OpenLicense_Click"
                                                Content="Licence"/>
                                        <Button Margin="0,0,8,8"
                                                Padding="14,6"
                                                Click="OpenThirdPartyNotices_Click"
                                                Content="Third-Party Notices"/>
                                    </WrapPanel>

                                    <Border Margin="0,12,0,0" Padding="14"
                                            Background="{DynamicResource Brush.SurfaceMuted}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="Updates"/>
                                                <TextBlock x:Name="CurrentUpdateVersionTextBlock" Margin="0,4,0,0"
                                                           Style="{DynamicResource Text.Secondary}"/>
                                                <TextBlock x:Name="LatestVersionTextBlock" Margin="0,3,0,0"
                                                           Style="{DynamicResource Text.Secondary}"/>
                                                <TextBlock x:Name="LastUpdateCheckTextBlock" Margin="0,3,0,0"
                                                           Style="{DynamicResource Text.Muted}"/>
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                <Button x:Name="OpenReleaseNotesButton" MinWidth="142" Margin="0,0,8,0"
                                                        Style="{DynamicResource Button.Secondary}"
                                                        Click="OpenReleaseNotes_Click" Content="Open Release Notes" IsEnabled="False"/>
                                                <Button x:Name="CheckForUpdatesButton" MinWidth="142"
                                                        Style="{DynamicResource Button.Primary}"
                                                        Click="CheckForUpdates_Click" Content="Check for Updates"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Style="{DynamicResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,22,0">
                                    <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                               Text="Support Development"/>
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="14"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               Text="RouterPilot is free and open source and is developed independently in my spare time."/>
                                    <TextBlock Margin="0,7,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               Text="If it has helped you manage your GL.iNet router or saved you time, you can support future development through GitHub Sponsors. Every contribution helps fund development time, testing hardware and future features."/>
                                    <TextBlock Margin="0,9,0,0"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="Thank you for using RouterPilot."/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        MinWidth="178"
                                        Height="40"
                                        Padding="16,7"
                                        VerticalAlignment="Center"
                                        Click="SupportDevelopment_Click"
                                        Content="★ Support Development"/>
                            </Grid>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                           Text="Credits &amp; Acknowledgements"/>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="RouterPilot is an independent project. Product names and trademarks remain the property of their respective owners."/>

                                <TextBlock Margin="0,18,0,0"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Text="GL.iNet"/>
                                <TextBlock Margin="0,5,0,0"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="RouterPilot communicates with supported GL.iNet routers and their management interfaces to surface router health, network information and administration features."/>
                                <TextBlock Margin="0,5,0,0">
                                    <Hyperlink NavigateUri="https://www.gl-inet.com/"
                                               RequestNavigate="GitHubLink_RequestNavigate">Visit GL.iNet</Hyperlink>
                                </TextBlock>

                                <Separator Margin="0,16,0,16"/>

                                <TextBlock FontSize="15"
                                           FontWeight="Bold"
                                           Text="AdGuard Home"/>
                                <TextBlock Margin="0,5,0,0"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="DNS filtering, protection controls, statistics, client activity and query-log data are provided through AdGuard Home."/>
                                <TextBlock Margin="0,5,0,0">
                                    <Hyperlink NavigateUri="https://adguard.com/adguard-home/overview.html"
                                               RequestNavigate="GitHubLink_RequestNavigate">Visit AdGuard Home</Hyperlink>
                                </TextBlock>

                                <Separator Margin="0,16,0,16"/>

                                <TextBlock FontSize="15"
                                           FontWeight="Bold"
                                           Text="Microsoft"/>
                                <TextBlock Margin="0,5,0,0"
                                           LineHeight="19"
                                           TextWrapping="Wrap"
                                           Text="Built with .NET 9 and Windows Presentation Foundation, with Microsoft.Extensions hosting, configuration, dependency-injection and logging components."/>
                                <TextBlock Margin="0,5,0,0">
                                    <Hyperlink NavigateUri="https://dotnet.microsoft.com/"
                                               RequestNavigate="GitHubLink_RequestNavigate">Visit .NET</Hyperlink>
                                </TextBlock>

                                <Separator Margin="0,16,0,16"/>

                                <TextBlock FontSize="15"
                                           FontWeight="Bold"
                                           Text="Open-source components"/>
                                <TextBlock Margin="0,5,0,10"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="Direct package references from RouterPilot.csproj. Full notices are included in THIRD_PARTY_NOTICES.txt."/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="2.2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="Component"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="Bold" Text="Licence"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="Bold" Text="Purpose"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,7,12,0" Text="CommunityToolkit.Mvvm 8.4.2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,7,0,0" Text="MVVM helpers"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,7,12,0" Text="CryptSharpOfficial 2.1.0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,7,12,0" Text="ISC"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,7,0,0" Text="Router password hashing"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,7,12,0" Text="Hardcodet.NotifyIcon.Wpf 2.0.1"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Margin="0,7,0,0" Text="Notification-area icon"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,7,12,0" Text="LiveChartsCore WPF 2.0.5"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,7,0,0" Text="Analytics charts"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,7,12,0" Text="Microsoft.Extensions.Configuration.Json 10.0.10"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Margin="0,7,0,0" Text="JSON configuration"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,7,12,0" Text="Microsoft.Extensions.DependencyInjection 10.0.10"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="6" Grid.Column="2" Margin="0,7,0,0" Text="Dependency injection"/>

                                    <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,7,12,0" Text="Microsoft.Extensions.Hosting 10.0.10"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="7" Grid.Column="2" Margin="0,7,0,0" Text="Application hosting"/>

                                    <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,7,12,0" Text="Microsoft.Extensions.Logging.Debug 10.0.10"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="8" Grid.Column="2" Margin="0,7,0,0" Text="Debug logging"/>

                                    <TextBlock Grid.Row="9" Grid.Column="0" Margin="0,7,12,0" Text="SSH.NET 2025.1.0"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,7,12,0" Text="MIT"/>
                                    <TextBlock Grid.Row="9" Grid.Column="2" Margin="0,7,0,0" Text="SSH connectivity"/>
                                </Grid>

                                <Border Margin="0,18,0,0"
                                        Padding="14"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock FontStyle="Italic"
                                               TextWrapping="Wrap"
                                               Text="Special thanks to the GL.iNet and AdGuard teams and communities for providing the platforms, documentation and APIs that make independent tools such as RouterPilot possible."/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Diagnostics">
                <ScrollViewer
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,24,24">
                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                           Text="Router Tools"/>
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="Run network checks directly from the router against a hostname or IP address."/>

                                <Border Margin="0,18,0,0"
                                        Padding="16"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock FontWeight="SemiBold"
                                                   Text="Target hostname or IP address"/>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="DiagnosticTargetBox"
                                                     MinWidth="240"
                                                     Height="40"
                                                     Padding="11,7"
                                                     VerticalContentAlignment="Center"
                                                     Text="1.1.1.1"
                                                     ToolTip="Hostname or IP address"/>

                                            <WrapPanel Grid.Column="2"
                                                       VerticalAlignment="Center">
                                                <Button MinWidth="96"
                                                        Height="40"
                                                        Margin="0,0,8,0"
                                                        Style="{DynamicResource Button.Secondary}"
                                                        Content="Ping"
                                                        Click="PingTool_Click"/>
                                                <Button MinWidth="110"
                                                        Height="40"
                                                        Margin="0,0,8,0"
                                                        Style="{DynamicResource Button.Secondary}"
                                                        Content="Traceroute"
                                                        Click="TracerouteTool_Click"/>
                                                <Button MinWidth="112"
                                                        Height="40"
                                                        Style="{DynamicResource Button.Primary}"
                                                        Content="DNS lookup"
                                                        Click="DnsLookupTool_Click"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Style="{DynamicResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                                   Text="Support Diagnostics"/>
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Text="Collect authentication, client, statistics, query-log, protection and endpoint information."/>
                                    </StackPanel>

                                    <WrapPanel Grid.Column="1"
                                               Margin="20,0,0,0"
                                               VerticalAlignment="Center">
                                        <Button MinWidth="92"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                Style="{DynamicResource Button.Secondary}"
                                                Click="CopyDiagnostics_Click"
                                                Content="Copy"/>
                                        <Button MinWidth="92"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                Style="{DynamicResource Button.Secondary}"
                                                Click="ExportDiagnostics_Click"
                                                Content="Backup Diagnostics"/>
                                        <Button MinWidth="124"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                Style="{DynamicResource Button.Secondary}"
                                                Click="RefreshClients_Click"
                                                Content="Refresh clients"/>
                                        <Button MinWidth="132"
                                                Height="38"
                                                Style="{DynamicResource Button.Primary}"
                                                Click="RunDiagnostics_Click"
                                                Content="Run Diagnostics"/>
                                    </WrapPanel>
                                </Grid>

                                <Border x:Name="QueryLogWarningBorder"
                                        Grid.Row="2"
                                        Padding="13"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Warning}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                    <DockPanel LastChildFill="True">
                                        <Button x:Name="EnableQueryLogButton"
                                                DockPanel.Dock="Right"
                                                MinWidth="132"
                                                Height="34"
                                                Margin="14,0,0,0"
                                                Click="EnableQueryLog_Click"
                                                Content="Enable query log"/>
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Warning}"
                                                       Text="Query logging is disabled"/>
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{DynamicResource Brush.Warning}"
                                                       TextWrapping="Wrap"
                                                       Text="Queries remain available from statistics. Blocked, block rate and last seen require new query-log entries."/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <TextBox x:Name="DiagnosticsTextBox"
                                         Grid.Row="4"
                                         MinHeight="240"
                                         Style="{StaticResource About.OutputBox}"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="Select Run diagnostics to collect a redacted support report."/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="System">
                <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource Brush.Surface}"
                        CornerRadius="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="18"
                                           FontWeight="Bold"
                                           Text="System information"/>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           Text="Application, Windows, .NET, architecture, memory and router configuration"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="112"
                                    Height="38"
                                    Margin="18,0,0,0"
                                    Style="{DynamicResource Button.Secondary}"
                                    Click="RefreshSystem_Click"
                                    Content="Refresh"/>
                        </Grid>
                        <TextBox x:Name="SystemTextBox" Grid.Row="2"
                                 Style="{StaticResource About.OutputBox}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Logs">
                <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource Brush.Surface}"
                        CornerRadius="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="18"
                                           FontWeight="Bold"
                                           Text="Live support activity"/>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           Text="Timestamped actions, diagnostics and errors from the current support session"/>
                            </StackPanel>
                            <Grid Grid.Column="1"
                                  Margin="18,0,0,0"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="112"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Height="38"
                                        Style="{DynamicResource Button.Secondary}"
                                        Click="CopyLog_Click"
                                        Content="Copy"/>
                                <Button Grid.Column="2"
                                        Height="38"
                                        Style="{DynamicResource Button.Secondary}"
                                        Click="ClearLog_Click"
                                        Content="Clear"/>
                            </Grid>
                        </Grid>
                        <TextBox x:Name="SupportLogTextBox" Grid.Row="2"
                                 Style="{StaticResource About.OutputBox}"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Changelog">
                <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource Brush.Surface}"
                        CornerRadius="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="Bold" Text="Release history"/>
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                                           Text="Loaded directly from CHANGELOG.md"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" MinWidth="92" Height="32"
                                    Click="ReloadChangelog_Click" Content="Reload"/>
                        </DockPanel>
                        <TextBox x:Name="ChangelogTextBox" Grid.Row="2"
                                 Style="{StaticResource About.OutputBox}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
