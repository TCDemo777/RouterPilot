                                <Rectangle Canvas.Left="28" Canvas.Top="282" Width="124" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{DynamicResource Brush.Border}"/>
                                <Rectangle Canvas.Left="39" Canvas.Top="287" Width="102" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.Accent}"/>
