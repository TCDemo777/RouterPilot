                                <Rectangle Canvas.Left="128" Canvas.Top="291" Width="7" Height="24" Fill="{DynamicResource Brush.Border}"/>
                                <Rectangle Canvas.Left="32" Canvas.Top="313" Width="116" Height="4" RadiusX="2" RadiusY="2" Fill="{DynamicResource Brush.Border}"/>
                                <Polygon Points="39,287 26,307 31,307 48,291" Fill="{DynamicResource Brush.Border}"/>
                                <Polygon Points="141,287 154,307 149,307 132,291" Fill="{DynamicResource Brush.Border}"/>
                                <Rectangle Canvas.Left="66" Canvas.Top="276" Width="48" Height="6" RadiusX="3" RadiusY="3" Fill="{DynamicResource Brush.SurfaceMuted}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1"/>
                                </Canvas>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Border>

                <Grid x:Name="FlightDeckHost"
                      Visibility="Collapsed"
                      Opacity="0"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Height="620"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="18"/>
                    </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,12,0,24"
                            Padding="16"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel>
                            <Image Width="42"
                                   Height="42"
                                   HorizontalAlignment="Left"
                                   Stretch="Uniform"
                                   Cursor="Hand"
                                   MouseLeftButtonUp="RouterPilotLogo_Changed"
                                   Source="/Assets/RouterPilotLogo.png"/>
                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       Text="ROUTERPILOT FLIGHT DECK"/>
                            <TextBlock Margin="0,4,0,20"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Text="CLEARANCE GRANTED"/>
                            <Grid Height="22" Margin="0,0,0,20" ClipToBounds="True">
                                <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource Brush.Border}"/>
                                <Ellipse x:Name="PacketIndicator"
                                         Width="7" Height="7"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource Brush.Accent}">
                                    <Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Aircraft"/>
                                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Callsign"/>
                                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Flight Mode"/>
                                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Cabin Wi-Fi"/>
                                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="DNS Turbulence"/>
                                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Packet Altitude"/>
                                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="NAT"/>
                                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Firewall"/>
                                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="AdGuard"/>
                                    <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Tailscale"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="GL.iNet Interceptor"/>
                                    <TextBlock Margin="0,12,0,0" Text="RP-777"/>
                                    <TextBlock Margin="0,12,0,0" Text="ROUTER"/>
                                    <TextBlock Margin="0,12,0,0" Text="Obviously"/>
                                    <TextBlock Margin="0,12,0,0" Text="Nominal"/>
                                    <TextBlock Margin="0,12,0,0" Text="35,000 hops"/>
                                    <TextBlock Margin="0,12,0,0" Text="Cleared for departure"/>
                                    <TextBlock Margin="0,12,0,0" Text="Doors armed"/>
                                    <TextBlock Margin="0,12,0,0" Text="Watching the airspace"/>
                                    <TextBlock Margin="0,12,0,0" Text="Tail attached ✓"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="AutopilotMessage"
                                       Margin="0,18,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Warning}"
                                       TextAlignment="Center"
                                       Visibility="Collapsed">
                                <TextBlock.RenderTransform><TranslateTransform Y="8"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="2" Margin="0,12,0,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Padding="14"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock FontFamily="Cascadia Mono, Consolas"
                                           FontWeight="Bold"
                                           Text="CAPTAIN'S LOG"/>
                                <TextBlock x:Name="CaptainLogText"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="FlightDeckChangelogCard"
                                Grid.Row="2"
                                Padding="16"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="12">
                          <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       Text="LATEST CHANGELOG"/>
                            <TextBlock x:Name="FlightDeckChangelogVersion"
                                       Grid.Row="1"
                                       Foreground="{DynamicResource Brush.TextSecondary}"/>
                            <Grid x:Name="FlightDeckChangelogViewport"
                                  Grid.Row="2"
                                  ClipToBounds="True"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  SizeChanged="FlightDeckChangelogViewport_SizeChanged"
                                  Background="{DynamicResource Brush.SurfaceMuted}">
                                <TextBlock x:Name="FlightDeckChangelogText"
                                           Margin="12"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.TextPrimary}">
                                    <TextBlock.RenderTransform><TranslateTransform x:Name="FlightDeckChangelogTranslation" Y="0"/></TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                          </Grid>
                        </Border>
                    </Grid>
                </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostics">
                <ScrollViewer
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,24,24">
                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                           Text="Router Tools"/>
                                <TextBlock Margin="0,5,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextWrapping="Wrap"
                                           Text="Run network checks directly from the router against a hostname or IP address."/>

                                <Border Margin="0,18,0,0"
                                        Padding="16"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock FontWeight="SemiBold"
                                                   Text="Target hostname or IP address"/>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox x:Name="DiagnosticTargetBox"
                                                     MinWidth="240"
                                                     Height="40"
                                                     Padding="11,7"
                                                     VerticalContentAlignment="Center"
                                                     Text="1.1.1.1"
                                                     ToolTip="Hostname or IP address"/>

                                            <WrapPanel Grid.Column="2"
                                                       VerticalAlignment="Center">
                                                <Button MinWidth="96"
                                                        Height="40"
                                                        Margin="0,0,8,0"
                                                        Style="{DynamicResource Button.Secondary}"
                                                        Content="Ping"
                                                        Click="PingTool_Click"/>
                                                <Button MinWidth="110"
                                                        Height="40"
                                                        Margin="0,0,8,0"
                                                        Style="{DynamicResource Button.Secondary}"
                                                        Content="Traceroute"
                                                        Click="TracerouteTool_Click"/>
                                                <Button MinWidth="112"
                                                        Height="40"
                                                        Style="{DynamicResource Button.Primary}"
                                                        Content="DNS lookup"
                                                        Click="DnsLookupTool_Click"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0"
                                Style="{DynamicResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                                   Text="Support Diagnostics"/>
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Text="Collect authentication, client, statistics, query-log, protection and endpoint information."/>
                                    </StackPanel>

                                    <WrapPanel Grid.Column="1"
                                               Margin="20,0,0,0"
                                               VerticalAlignment="Center">
                                        <Button MinWidth="92"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                Style="{DynamicResource Button.Secondary}"
                                                Click="CopyDiagnostics_Click"
                                                Content="Copy"/>
                                        <Button MinWidth="92"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                Style="{DynamicResource Button.Secondary}"
                                                Click="ExportDiagnostics_Click"
                                                Content="Backup Diagnostics"/>
                                        <Button MinWidth="124"
                                                Height="38"
                                                Margin="0,0,8,0"
                                                Style="{DynamicResource Button.Secondary}"
                                                Click="RefreshClients_Click"
                                                Content="Refresh clients"/>
                                        <Button MinWidth="132"
                                                Height="38"
                                                Style="{DynamicResource Button.Primary}"
                                                Click="RunDiagnostics_Click"
                                                Content="Run Diagnostics"/>
                                    </WrapPanel>
                                </Grid>

                                <Border Grid.Row="2"
                                        Padding="14"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="Network Snapshot"/>
                                            <TextBlock Margin="0,4,0,0"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       TextWrapping="Wrap"
                                                       Text="Create a sanitised summary of the current RouterPilot and network state for troubleshooting or support."/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                MinWidth="176"
                                                Height="38"
                                                Style="{DynamicResource Button.Secondary}"
                                                Click="ExportNetworkSnapshot_Click"
                                                Content="Export Network Snapshot"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="QueryLogWarningBorder"
                                        Grid.Row="4"
                                        Padding="13"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Warning}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                    <DockPanel LastChildFill="True">
                                        <Button x:Name="EnableQueryLogButton"
                                                DockPanel.Dock="Right"
                                                MinWidth="132"
                                                Height="34"
                                                Margin="14,0,0,0"
                                                Click="EnableQueryLog_Click"
                                                Content="Enable query log"/>
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Warning}"
                                                       Text="Query logging is disabled"/>
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{DynamicResource Brush.Warning}"
                                                       TextWrapping="Wrap"
                                                       Text="Queries remain available from statistics. Blocked, block rate and last seen require new query-log entries."/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <TextBox x:Name="DiagnosticsTextBox"
                                         Grid.Row="6"
                                         MinHeight="240"
                                         Style="{StaticResource About.OutputBox}"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         Text="Select Run diagnostics to collect a redacted support report."/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="System">
                <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource Brush.Surface}"
                        CornerRadius="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="18"
                                           FontWeight="Bold"
                                           Text="System information"/>
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           Text="Application, Windows, .NET, architecture, memory and router configuration"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="112"
                                    Height="38"
                                    Margin="18,0,0,0"
                                    Style="{DynamicResource Button.Secondary}"
                                    Click="RefreshSystem_Click"
                                    Content="Refresh"/>
                        </Grid>
                        <TextBox x:Name="SystemTextBox" Grid.Row="2"
                                 Style="{StaticResource About.OutputBox}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Changelog">
                <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource Brush.Surface}"
                        CornerRadius="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="Bold" Text="Release history"/>
                                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                                           Text="Loaded directly from CHANGELOG.md"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" MinWidth="92" Height="32"
                                    Click="ReloadChangelog_Click" Content="Reload"/>
                        </DockPanel>
                        <TextBox x:Name="ChangelogTextBox" Grid.Row="2"
                                 Style="{StaticResource About.OutputBox}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
