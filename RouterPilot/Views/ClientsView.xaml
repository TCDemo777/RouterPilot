<UserControl x:Class="RouterPilot.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RouterPilot.Converters"
             xmlns:models="clr-namespace:RouterPilot.Models">
    <UserControl.Resources>
        <local:WidthBelowConverter x:Key="WidthBelowConverter"/>
        <Style x:Key="ClientDnsValueText"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.NotAvailable}">
            <Setter Property="MinHeight" Value="20"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AdGuardDataAvailability}" Value="{x:Static models:AdGuardAvailabilityState.Available}">
                    <Setter Property="FontSize" Value="17"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClientBlockedDnsValueText"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.NotAvailable}">
            <Setter Property="MinHeight" Value="20"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AdGuardDataAvailability}" Value="{x:Static models:AdGuardAvailabilityState.Available}">
                    <Setter Property="FontSize" Value="17"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="ClientsPageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource Page.Content}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{DynamicResource Text.PageTitle}" Text="Clients"/>
            <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Secondary}"
                       Text="Connected devices, identity and DNS activity"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{DynamicResource Card.Compact}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Height="36"
                             MinWidth="220"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search name, address, manufacturer, device type or health"/>

                    <ComboBox x:Name="SortOptionComboBox"
                              Style="{StaticResource RouterPilot.ComboBox}"
                              Grid.Column="2"
                              Height="36"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption, Mode=OneWay}"
                              SelectionChanged="SortOptionComboBox_SelectionChanged"/>

                    <Button Grid.Column="4"
                            Height="36"
                            Style="{DynamicResource Button.Secondary}"
                            Command="{Binding ToggleSortDirectionCommand}"
                            Content="{Binding SortDirectionText}"/>
                </Grid>

                <WrapPanel Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,8">
                        <CheckBox
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            IsChecked="{Binding ShowFavoritesOnly}"
                            Content="Favourites only"/>
                    </StackPanel>

                    <Button MinWidth="100" Height="36" Margin="0,0,10,8"
                            Style="{DynamicResource Button.Secondary}"
                            Command="{Binding LoadClientsCommand}"
                            Content="Refresh"/>
                    <Button MinWidth="110" Height="36" Margin="0,0,10,8"
                            Style="{DynamicResource Button.Secondary}"
                            Command="{Binding PingSelectedClientCommand}"
                            Content="Ping Client"/>
                    <Button MinWidth="115" Height="36" Margin="0,0,10,8"
                            Style="{DynamicResource Button.Secondary}"
                            Command="{Binding WakeSelectedClientCommand}"
                            Content="Wake Client"/>
                    <Button MinWidth="115" Height="36" Margin="0,0,0,8"
                            Style="{DynamicResource Button.Primary}"
                            Click="ViewDetailsButton_Click"
                            Content="Open / Personalise"/>
                </WrapPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3">
        <Border Margin="0,16,0,0"
                Padding="14"
                Background="{DynamicResource Brush.WarningSubtle}"
                BorderBrush="{DynamicResource Brush.Warning}"
                BorderThickness="1"
                CornerRadius="10"
                Visibility="{Binding HasNewDevices, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="New devices"/>
                    <TextBlock Grid.Column="1" Style="{DynamicResource Text.Secondary}" Text="{Binding NewDevices.Count, StringFormat={}{0} awaiting review}"/>
                </Grid>
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding NewDevices}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="250" Margin="0,0,10,8" Padding="10" Background="{DynamicResource Brush.Surface}" CornerRadius="8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                    <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding IpAddress}"/>
                                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Text="{Binding ConnectionSummary}"/>
                                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding FirstSeenDisplay, StringFormat=First observed: {0}}"/>
                                    <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{DynamicResource Button.Secondary}" Tag="{Binding}" Click="ReviewNewDevice_Click" Content="Review"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Margin="0,16,0,16"
                   Foreground="{DynamicResource Brush.Warning}"
                   TextWrapping="Wrap"
                   Text="{Binding DnsActivityAvailabilityMessage}">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,12,0,0" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="5.5*"/>
            </Grid.ColumnDefinitions>

            <Border Height="208" Padding="12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card.Compact}">
                        <Setter Property="Grid.Row" Value="0"/>
                        <Setter Property="Grid.Column" Value="0"/>
                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource WidthBelowConverter}, ConverterParameter=640}">
                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="5">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="SELECTED CLIENT"/>
                        <TextBlock Margin="0,3,0,0" FontSize="16" FontWeight="Bold"
                                   TextWrapping="Wrap" MaxHeight="52"
                                   ToolTip="{Binding SelectedClient.Name}"
                                   Text="{Binding SelectedClient.Name, TargetNullValue=No client selected}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="IP ADDRESS"/>
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding SelectedClient.IpAddress, TargetNullValue=—}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Visibility="Collapsed">
                        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="MAC ADDRESS"/>
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Text="{Binding SelectedClient.MacAddress, TargetNullValue=—}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="CONNECTION"/>
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding SelectedClient.ConnectionSummary, TargetNullValue=—}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="FIRST SEEN"/>
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding SelectedClient.FirstSeenDisplay, TargetNullValue=—}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="4">
                        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="DNS ACTIVITY"/>
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold"
                                   Text="{Binding SelectedClient.TotalQueriesDisplay, TargetNullValue=—}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Height="208" Padding="12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card.Compact}">
                        <Setter Property="Grid.Row" Value="0"/>
                        <Setter Property="Grid.Column" Value="2"/>
                        <Setter Property="Grid.ColumnSpan" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource WidthBelowConverter}, ConverterParameter=640}">
                                <Setter Property="Grid.Row" Value="2"/>
                                <Setter Property="Grid.Column" Value="0"/>
                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="Bold" Text="RECENT ACTIVITY"/>
                            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                       Text="DNS activity from this session"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoScrollToTopCheckBox" Grid.Column="1" Margin="12,0,0,0"
                                  VerticalAlignment="Center" FontSize="11"
                                  IsChecked="True" Content="Auto-scroll to top"/>
                    </Grid>
                    <TextBlock Grid.Row="2" VerticalAlignment="Top" Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="No activity yet this session">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedClientActivity}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox x:Name="RecentActivityList" Grid.Row="2" ItemsSource="{Binding SelectedClientActivity}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Style>
                            <Style TargetType="ListBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedClientActivity}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding TimeDisplay}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Summary}"/>
                                        <TextBlock Margin="0,1,0,0" FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"
                                                   Text="{Binding Detail}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="6" MinHeight="360" Padding="10" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="10"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid>
            <ListBox x:Name="ClientsGrid"
                     ItemsSource="{Binding Clients}"
                     SelectedItem="{Binding SelectedClient}"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     RequestBringIntoView="ClientsGrid_RequestBringIntoView"
                     PreviewKeyDown="ClientsGrid_PreviewKeyDown"
                     PreviewMouseLeftButtonUp="ClientsGrid_PreviewMouseLeftButtonUp"
                     MouseDoubleClick="ClientsGrid_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="6"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border MinHeight="205"
                                Padding="15"
                                Background="{DynamicResource Brush.Surface}"
                                CornerRadius="10"
                                 BorderBrush="{DynamicResource Brush.Border}"
                                 BorderThickness="1"
                                 PreviewMouseRightButtonDown="ClientCard_PreviewMouseRightButtonDown">
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="View Details" Click="ContextViewDetails_Click" />
                                    <Separator />
                                    <MenuItem Header="Copy IP Address" Click="ContextCopyIp_Click" />
                                    <MenuItem Header="Copy MAC Address" Click="ContextCopyMac_Click" />
                                    <Separator />
                                    <MenuItem Header="Ping" Click="ContextPing_Click" />
                                    <MenuItem Header="Traceroute" Click="ContextTraceroute_Click" />
                                    <MenuItem Header="View DNS Activity" Click="ContextDnsActivity_Click" />
                                    <Separator />
                                    <MenuItem Header="Favourite / Remove Favourite" Click="ContextFavorite_Click" />
                                    <MenuItem Header="Edit Profile" Click="ContextEditProfile_Click" />
                                    <Separator />
                                    <MenuItem Header="DHCP Reservation" Tag="DhcpReservationAction" Click="ContextDhcpReservation_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="9"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="38"
                                            Height="38"
                                            Background="{DynamicResource Brush.PrimarySubtle}"
                                            CornerRadius="19">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe UI Emoji"
                                                   FontSize="18"
                                                   Text="{Binding DeviceIcon}"/>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="16"
                                                   FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}"/>
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="{Binding IpAddress}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Width="34"
                                            Height="32"
                                            Padding="0"
                                            FontSize="19"
                                            Foreground="{DynamicResource Brush.Warning}"
                                            ToolTip="{Binding FavoriteToolTip}"
                                            Tag="{Binding}"
                                            Click="FavoriteButton_Click"
                                            Content="{Binding FavoriteGlyph}"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding DeviceType}"/>
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Manufacturer}"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="9,4"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Brush.SurfaceMuted}"
                                            CornerRadius="10">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{Binding HealthColour}"
                                                   Text="{Binding HealthText}"/>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="4">
                                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding ConnectionSummary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasConnectionSummary}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding SignalSummary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSignalSummary}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               Text="Monitoring">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MonitorAvailability}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ClientDnsValueText}"
                                                   Text="{Binding TotalQueriesDisplay}"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="Queries"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource ClientBlockedDnsValueText}"
                                                   ToolTip="{Binding ActivityAvailabilityToolTip}"
                                                   Text="{Binding BlockedQueriesDisplay}"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="Blocked"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource ClientDnsValueText}"
                                                   ToolTip="{Binding ActivityAvailabilityToolTip}"
                                                   Text="{Binding BlockRateDisplay}"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="Block rate"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel IsHitTestVisible="False">
                <StackPanel.Style>
                    <Style TargetType="StackPanel" BasedOn="{StaticResource EmptyState}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Clients.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource Icon.EmptyState}" Text="&#xE716;"/>
                <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.EmptyStateTitle}"
                           Text="No connected clients"/>
                <TextBlock Style="{StaticResource Text.EmptyStateMessage}"
                           Text="Connected devices will appear here after the next refresh."/>
            </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="7" Margin="2,9,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Style="{DynamicResource Text.Secondary}"
                       Text="{Binding StatusMessage}"/>

            <TextBlock Grid.Column="2"
                       HorizontalAlignment="Right"
                       Style="{DynamicResource Text.Secondary}"
                       Text="{Binding PingResult}"/>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
