<UserControl x:Class="RouterPilot.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RouterPilot.Controls"
             Background="{DynamicResource Brush.WindowBackground}"
             Foreground="{DynamicResource Brush.TextPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource Page.Content}">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Maintenance" />
            <TextBlock Margin="0,8,0,24"
                       Style="{StaticResource Text.Secondary}"
                       Text="Safely manage supported router services and review recent maintenance activity." />

            <Border Style="{StaticResource SectionContainerStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Margin="0,4,12,0" VerticalAlignment="Top" Fill="{Binding HealthSummaryColour}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Foreground="{Binding HealthSummaryColour}" Text="{Binding HealthSummary}" />
                        <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding HealthSummaryDetail}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Current status" />
                    <UniformGrid Columns="4" Margin="0,0,0,0">
                        <controls:StatisticCard Margin="0,0,12,12" Title="ROUTER"
                                        Value="{Binding Dashboard.RouterStatusText}"
                                        ValueForeground="{Binding Dashboard.RouterStatusColour}"
                                        Subtitle="Router connection" />
                        <controls:StatisticCard Margin="0,0,12,12" Title="INTERNET / WAN"
                                        Value="{Binding Dashboard.InternetStatusText}"
                                        ValueForeground="{Binding Dashboard.InternetStatusColour}"
                                        Subtitle="WAN connectivity" />
                        <controls:StatisticCard Margin="0,0,12,12" Title="WI-FI"
                                        Value="{Binding WifiStatusText}"
                                        ValueForeground="{Binding WifiStatusColour}"
                                        Subtitle="Router wireless interfaces" />
                        <controls:StatisticCard Margin="0,0,12,12" Title="ADGUARD HOME"
                                        Value="{Binding Dashboard.AdGuardStatusText}"
                                        ValueForeground="{Binding Dashboard.AdGuardStatusColour}"
                                        Subtitle="DNS filtering service" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Quick actions" />
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Secondary}"
                               Text="Only one maintenance operation runs at a time." />
                </StackPanel>
                <Border Grid.Column="1" Padding="10,4" CornerRadius="12"
                        Background="{DynamicResource Brush.SurfaceMuted}">
                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="{Binding ActiveOperation, TargetNullValue=Ready}" />
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MinHeight="184" Height="184" Margin="0,0,12,12" Padding="16"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" LineHeight="18" MaxHeight="36"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Title}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Margin="0,7,8,0" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="{Binding Availability}" ToolTip="{Binding AvailabilityReason}" />
                                        <Button Width="28" Height="28" Padding="0" Content="⋮" ToolTip="More actions"
                                                Click="ActionMenu_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Run" IsEnabled="{Binding IsAvailable}" ToolTip="{Binding AvailabilityReason}" Click="RunActionMenu_Click" />
                                                    <MenuItem Header="View History" Click="ViewActionHistory_Click" />
                                                    <MenuItem Header="Copy Last Result" IsEnabled="{Binding HasLastResult}"
                                                              ToolTip="Copies the safe result shown on this action card" Click="CopyLastResult_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,6,0,8">
                                    <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="{Binding Description}" />
                                    <TextBlock Margin="0,9,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                                               Text="{Binding LastRun, StringFormat=Last run: {0}}" />
                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{Binding LastResultColour}"
                                               Text="{Binding LastResult, StringFormat=Last result: {0}}" />
                                </StackPanel>
                                <Button Grid.Row="2" MinWidth="116" Height="36" HorizontalAlignment="Left"
                                        Style="{DynamicResource Button.Secondary}" Content="Run action"
                                        IsEnabled="{Binding IsAvailable}" ToolTip="{Binding AvailabilityReason}"
                                        Click="RunAction_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Router firmware" />
            <Border Padding="0" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.CardCaption}" Text="CURRENT" />
                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding FirmwareCurrentVersion}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Text.CardCaption}" Text="LATEST" />
                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding FirmwareLatestVersion}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Text.CardCaption}" Text="STATUS" />
                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Foreground="{Binding FirmwareStatusColour}" Text="{Binding FirmwareStatusText}" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Muted}" Text="{Binding FirmwareLastChecked, StringFormat=Last checked: {0}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="24,0,0,0" VerticalAlignment="Top">
                        <Button x:Name="CheckFirmwareButton" Width="144" Height="36" Margin="0,0,0,10" Style="{DynamicResource Button.Primary}"
                                Content="Check for Updates" IsEnabled="{Binding CanCheckFirmware}" Click="CheckFirmware_Click" />
                        <Button Width="144" Height="36"
                                 Content="View Release Notes" Click="OpenFirmwarePage_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFirmwareReleaseNotes}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Width="144" Height="36" Margin="0,10,0,0"
                                Content="Open Firmware Page" Click="OpenFirmwarePage_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FirmwareLink}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FirmwareLink}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Backup &amp; Restore" />
            <Border Padding="0" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="RouterPilot data" />
                         <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                    Text="Back up settings, notification history, client profiles and service schedules in one portable .rpb package." />
                         <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                    Text="Backup files are not encrypted. Passwords remain protected by Windows; store backups securely." />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Secondary}"
                                   Text="{Binding LastBackupDate, StringFormat=Last backup: {0}}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}"
                                   Text="{Binding LastBackupResult, StringFormat=Last result: {0}}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                   Text="{Binding LastBackupDestination, StringFormat=Last destination: {0}}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}"
                                   Text="{Binding LastBackupSize, StringFormat=Last size: {0}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
                        <Button Width="156" Height="36" Margin="0,0,0,10" IsEnabled="{Binding CanManageBackups}"
                                Style="{DynamicResource Button.Primary}" Content="Create Backup" Click="CreateBackup_Click" />
                        <Button Width="156" Height="36" Margin="0,0,0,10" IsEnabled="{Binding CanManageBackups}"
                                Style="{DynamicResource Button.Secondary}" Content="Restore Backup" Click="RestoreBackup_Click" />
                        <Button Width="156" Height="36" Style="{DynamicResource Button.Secondary}"
                                Content="Open Backup Folder" Click="OpenBackupFolder_Click" />
                    </StackPanel>
                </Grid>
            </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
            <TextBlock x:Name="MaintenanceHistoryHeading" Style="{StaticResource SectionHeaderStyle}" Text="Maintenance history" />
            <Border Padding="0" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="18,14,18,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.CardCaption}" Text="TIMESTAMP" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.CardCaption}" Text="ACTION" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Text.CardCaption}" Text="OUTCOME" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Text.CardCaption}" Text="MESSAGE" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="18,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding TimestampDisplay}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" Text="{Binding ActionDisplay}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Secondary}" Foreground="{Binding OutcomeColour}" Text="{Binding OutcomeDisplay}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="{Binding Message}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="No maintenance actions have been recorded yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
