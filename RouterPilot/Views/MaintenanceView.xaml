<UserControl x:Class="RouterPilot.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RouterPilot.Controls"
             Background="{DynamicResource Brush.WindowBackground}"
             Foreground="{DynamicResource Brush.TextPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="MaintenanceContent" Style="{StaticResource Page.Content}">
            <TextBlock Style="{StaticResource Text.PageTitle}" Text="Maintenance" />
            <TextBlock Margin="0,8,0,24"
                       Style="{StaticResource Text.Secondary}"
                       Text="Safely manage supported router services and review recent maintenance activity." />

            <TabControl x:Name="MaintenanceTabs" Margin="0,0,0,16"
                        Style="{StaticResource RouterPilotTabControlStyle}"
                        ItemContainerStyle="{StaticResource RouterPilotTabItemStyle}"
                        SelectionChanged="MaintenanceTabs_SelectionChanged"
                        AutomationProperties.Name="Maintenance sections">
                <TabItem Header="Overview" Tag="Overview" />
                <TabItem Header="Diagnostics" Tag="Diagnostics" />
                <TabItem Header="Health" Tag="Health" />
                <TabItem Header="Snapshots" Tag="Snapshots" />
                <TabItem Header="Firmware" Tag="Firmware" />
                <TabItem Header="Logs &amp; Events" Tag="LogsEvents" />
                <TabItem Header="Reports" Tag="Reports" />
                <TabItem Header="Support" Tag="Support" />
            </TabControl>

            <Border x:Name="OverviewStatusSection" Style="{StaticResource SectionContainerStyle}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Margin="0,4,12,0" VerticalAlignment="Top" Fill="{Binding HealthSummaryColour}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Foreground="{Binding HealthSummaryColour}" Text="{Binding HealthSummary}" />
                        <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding HealthSummaryDetail}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="OverviewCurrentSection" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Current status" />
                    <UniformGrid Columns="4" Margin="0,0,0,0">
                        <controls:StatisticCard Margin="0,0,12,12" Title="ROUTER"
                                        Value="{Binding Dashboard.RouterStatusText}"
                                        ValueForeground="{Binding Dashboard.RouterStatusColour}"
                                        Subtitle="Router connection" />
                        <controls:StatisticCard Margin="0,0,12,12" Title="INTERNET / WAN"
                                        Value="{Binding Dashboard.InternetStatusText}"
                                        ValueForeground="{Binding Dashboard.InternetStatusColour}"
                                        Subtitle="WAN connectivity" />
                        <controls:StatisticCard Margin="0,0,12,12" Title="WI-FI"
                                        Value="{Binding WifiStatusText}"
                                        ValueForeground="{Binding WifiStatusColour}"
                                        Subtitle="Router wireless interfaces" />
                        <controls:StatisticCard Margin="0,0,12,12" Title="ADGUARD HOME"
                                        Value="{Binding Dashboard.AdGuardStatusText}"
                                        ValueForeground="{Binding Dashboard.AdGuardStatusColour}"
                                        Subtitle="DNS filtering service" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border x:Name="QuickActionsSection" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Quick actions" />
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Secondary}"
                               Text="Only one maintenance operation runs at a time." />
                </StackPanel>
                <Border Grid.Column="1" Padding="10,4" CornerRadius="12"
                        Background="{DynamicResource Brush.SurfaceMuted}">
                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="{Binding ActiveOperation, TargetNullValue=Ready}" />
                </Border>
            </Grid>

            <ItemsControl ItemsSource="{Binding Actions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MinHeight="184" Height="184" Margin="0,0,12,12" Padding="16"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" LineHeight="18" MaxHeight="36"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Title}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Margin="0,7,8,0" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="{Binding Availability}" ToolTip="{Binding AvailabilityReason}" />
                                        <Button Width="28" Height="28" Padding="0" Content="⋮" ToolTip="More actions"
                                                Click="ActionMenu_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Run" IsEnabled="{Binding IsAvailable}" ToolTip="{Binding AvailabilityReason}" Click="RunActionMenu_Click" />
                                                    <MenuItem Header="View History" Click="ViewActionHistory_Click" />
                                                    <MenuItem Header="Copy Last Result" IsEnabled="{Binding HasLastResult}"
                                                              ToolTip="Copies the safe result shown on this action card" Click="CopyLastResult_Click" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,6,0,8">
                                    <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="{Binding Description}" />
                                    <TextBlock Margin="0,9,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"
                                               Text="{Binding LastRun, StringFormat=Last run: {0}}" />
                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{Binding LastResultColour}"
                                               Text="{Binding LastResult, StringFormat=Last result: {0}}" />
                                </StackPanel>
                                <Button Grid.Row="2" MinWidth="116" Height="36" HorizontalAlignment="Left"
                                        Style="{DynamicResource Button.Secondary}" Content="Run action"
                                        IsEnabled="{Binding IsAvailable}" ToolTip="{Binding AvailabilityReason}"
                                        Click="RunAction_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                </StackPanel>
            </Border>

            <Border x:Name="RouterLifecycleSummarySection" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="System Information" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,14,0"><TextBlock Style="{StaticResource Text.CardCaption}" Text="MODEL"/><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding RouterIdentityText}"/></StackPanel>
                        <StackPanel Margin="0,0,14,0"><TextBlock Style="{StaticResource Text.CardCaption}" Text="OPENWRT RELEASE"/><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Dashboard.FirmwareVersion}"/></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource Text.CardCaption}" Text="KERNEL"/><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Dashboard.RouterKernelVersion}"/></StackPanel>
                    </UniformGrid>
                    <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Muted}" Text="GL.iNet firmware is the router firmware updated through the GL.iNet interface. OpenWrt and kernel values describe the underlying system layer." TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="GuidedDiagnosticsSection" Margin="0,0,0,16" Style="{StaticResource SectionContainerStyle}" AutomationProperties.Name="Guided Diagnostics">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Guided Diagnostics" />
                    <TextBlock Margin="0,5,0,10" Style="{StaticResource Text.Secondary}" Text="Choose what you are troubleshooting. RouterPilot correlates currently loaded evidence and does not change router settings." TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Margin="0,0,6,6" Content="Internet" Click="DiagnosticCategory_Click" Tag="Internet" Style="{DynamicResource Button.Secondary}" />
                        <Button Margin="0,0,6,6" Content="Wi-Fi" Click="DiagnosticCategory_Click" Tag="WiFi" Style="{DynamicResource Button.Secondary}" />
                        <Button Margin="0,0,6,6" Content="DNS" Click="DiagnosticCategory_Click" Tag="DNS" Style="{DynamicResource Button.Secondary}" />
                        <Button Margin="0,0,6,6" Content="VPN" Click="DiagnosticCategory_Click" Tag="VPN" Style="{DynamicResource Button.Secondary}" />
                        <Button Margin="0,0,6,6" Content="Client / Device" Click="DiagnosticCategory_Click" Tag="Client" Style="{DynamicResource Button.Secondary}" />
                        <Button Margin="0,0,6,6" Content="Router Performance" Click="DiagnosticCategory_Click" Tag="RouterPerformance" Style="{DynamicResource Button.Secondary}" />
                        <Button Margin="0,0,6,6" Content="Wired Ethernet" Click="DiagnosticCategory_Click" Tag="Ethernet" Style="{DynamicResource Button.Secondary}" />
                        <Button Margin="0,0,6,6" Content="Storage / Sharing" Click="DiagnosticCategory_Click" Tag="Storage" Style="{DynamicResource Button.Secondary}" />
                        <Button Margin="0,0,6,6" Content="Not Sure" Click="DiagnosticCategory_Click" Tag="NotSure" Style="{DynamicResource Button.Secondary}" />
                    </WrapPanel>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}" Text="{Binding DiagnosticStatus}" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DiagnosticSession.Findings}">
                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock FontWeight="SemiBold" Text="{Binding Title}"/><TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding RecommendedAction}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Width="150" Margin="0,10,0,0" Content="Copy Diagnostic Report" Click="CopyDiagnosticReport_Click" Style="{DynamicResource Button.Secondary}" />
                </StackPanel>
            </Border>

            <Border x:Name="SnapshotsSection" Margin="0,0,0,16" Style="{StaticResource SectionContainerStyle}" AutomationProperties.Name="Configuration Snapshot">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Configuration Snapshot" />
                    <TextBlock Margin="0,5,0,12" Style="{StaticResource Text.Secondary}" Text="Capture the router state currently observable by RouterPilot and compare it later. This is not a backup or restore point." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Style="{DynamicResource Button.Primary}" Content="Capture Snapshot" Click="CaptureSnapshot_Click" IsEnabled="{Binding Dashboard.RouterConnected}" AutomationProperties.Name="Capture router state snapshot" />
                        <Button Margin="0,0,10,0" Style="{DynamicResource Button.Secondary}" Content="Compare with Current Router" Click="CompareSnapshot_Click" IsEnabled="{Binding Dashboard.RouterConnected}" AutomationProperties.Name="Compare snapshot with current router" />
                        <Button Style="{DynamicResource Button.Secondary}" Content="Delete Snapshot" Click="DeleteSnapshot_Click" AutomationProperties.Name="Delete local router state snapshot" />
                        <Button Margin="10,0,0,0" Style="{DynamicResource Button.Secondary}" Content="Copy Comparison" Click="CopyComparison_Click" AutomationProperties.Name="Copy privacy-safe configuration comparison" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Muted}" Text="{Binding SnapshotStatus}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,3" Style="{StaticResource Text.CardCaption}" Text="SAVED SNAPSHOTS" />
                    <ItemsControl ItemsSource="{Binding StateSnapshots}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <TextBlock Margin="0,2" Style="{StaticResource Text.Muted}"><Run Text="{Binding FriendlyName}"/><Run Text=" — Firmware "/><Run Text="{Binding FirmwareVersion}"/></TextBlock>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding SnapshotChangeSummary}" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding StateChanges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Category}" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                        <Run FontWeight="SemiBold" Text="{Binding Field}"/><Run Text=": "/><Run Text="{Binding OldValue}"/><Run Text=" → "/><Run Text="{Binding NewValue}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,14,0,4" Style="{StaticResource Text.CardCaption}" Text="COMPARISON HISTORY" />
                    <ItemsControl ItemsSource="{Binding ComparisonJournal}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <TextBlock Margin="0,2" Style="{StaticResource Text.Muted}"><Run Text="{Binding ComparedAt, StringFormat={}{0:g}}"/><Run Text=" — "/><Run Text="{Binding SnapshotName}"/><Run Text=" — "/><Run Text="{Binding ChangeCount}"/><Run Text=" changes"/></TextBlock>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border x:Name="ReportsSection" Margin="0,0,0,16" Style="{StaticResource SectionContainerStyle}" AutomationProperties.Name="Home Network Report">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Home Network Report" />
                    <TextBlock Margin="0,5,0,12" Style="{StaticResource Text.Secondary}" Text="Create a concise privacy-safe summary from the RouterPilot state already loaded in this session." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Padding="12,6" Style="{DynamicResource Button.Primary}" Content="Copy Report" Click="CopyHomeReport_Click" AutomationProperties.Name="Copy privacy-safe home network report" />
                        <Button Padding="12,6" Style="{DynamicResource Button.Secondary}" Content="Save Report" Click="SaveHomeReport_Click" AutomationProperties.Name="Save privacy-safe home network report" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="ServicesSection" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Router services" />
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Text.CardCaption}" Text="DHCP"/><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding DhcpServiceText}"/><TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Muted}" Text="Service state"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Text.CardCaption}" Text="ACTIVE LEASES"/><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding DhcpLeaseCountText}"/><TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Muted}" Text="Authoritative inventory"/></StackPanel>
                        <StackPanel Margin="0,0,12,0"><TextBlock Style="{StaticResource Text.CardCaption}" Text="RESERVATIONS"/><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding DhcpReservationCountText}"/><TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Muted}" Text="Configured entries"/></StackPanel>
                        <StackPanel><TextBlock Style="{StaticResource Text.CardCaption}" Text="ADGUARD"/><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Dashboard.AdGuardStatusText}"/><TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Muted}" Text="Protection page is canonical"/></StackPanel>
                    </UniformGrid>
                    <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Muted}" Text="Running describes observed service state; it is not a guarantee of service health. RouterPilot does not probe each process separately." TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="FirmwareLifecycleSection" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Firmware &amp; Lifecycle" />
                    <TextBlock Margin="0,5,0,4" Style="{StaticResource Text.Secondary}" Text="Save a read-only baseline before you upgrade, then compare the router's observed state after it reconnects. RouterPilot does not install firmware or change the router." TextWrapping="Wrap" />
                    <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.Muted}" Text="Use the GL.iNet administration interface to install firmware. Return here afterwards to run the post-upgrade check." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Style="{DynamicResource Button.Primary}" Content="Save Pre-Upgrade Baseline" Click="PrepareFirmwareUpgrade_Click" IsEnabled="{Binding Dashboard.RouterConnected}" />
                        <Button Style="{DynamicResource Button.Secondary}" Content="Run Post-Upgrade Check" Click="RunPostUpgradeCheck_Click" IsEnabled="{Binding Dashboard.RouterConnected}" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Muted}" Text="{Binding LifecycleStatus}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding RouterFirmwareText, StringFormat=Current GL.iNet firmware: {0}}" />
                </StackPanel>
            </Border>

            <Border x:Name="FirmwareReadinessSection" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Firmware update readiness" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding UpdateReadinessText}" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Muted}" Text="Firmware updates can interrupt router and Internet availability. RouterPilot never downloads or installs firmware automatically." TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="FirmwareSection" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="System identity" />
            <TextBlock Margin="0,0,0,10" Style="{StaticResource Text.Muted}" Text="GL.iNet firmware and the underlying OpenWrt/system identity are shown separately where RouterPilot can observe them." TextWrapping="Wrap" />
            <Border Padding="0" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.CardCaption}" Text="GL.INET FIRMWARE" />
                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding FirmwareCurrentVersion}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource Text.CardCaption}" Text="LATEST GL.INET FIRMWARE" />
                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding FirmwareLatestVersion}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Text.CardCaption}" Text="STATUS" />
                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Foreground="{Binding FirmwareStatusColour}" Text="{Binding FirmwareStatusText}" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Muted}" Text="{Binding FirmwareLastChecked, StringFormat=Last checked: {0}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="24,0,0,0" VerticalAlignment="Top">
                        <Button x:Name="CheckFirmwareButton" Width="144" Height="36" Margin="0,0,0,10" Style="{DynamicResource Button.Primary}"
                                Content="Check for Updates" IsEnabled="{Binding CanCheckFirmware}" Click="CheckFirmware_Click" />
                        <Button Width="144" Height="36"
                                 Content="View Release Notes" Click="OpenFirmwarePage_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFirmwareReleaseNotes}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Width="144" Height="36" Margin="0,10,0,0"
                                Content="Open Firmware Page" Click="OpenFirmwarePage_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FirmwareLink}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FirmwareLink}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
                </StackPanel>
            </Border>

            <Border x:Name="SupportSection" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Support" />
                    <TextBlock Margin="0,0,0,12" Style="{StaticResource Text.Secondary}" Text="Copy or export a privacy-safe summary of information already loaded in RouterPilot. No router requests are made." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Width="156" Height="36" Margin="0,0,10,0" Style="{DynamicResource Button.Secondary}" Content="Copy support snapshot" Click="CopySupportSnapshot_Click" />
                        <Button Width="156" Height="36" Style="{DynamicResource Button.Secondary}" Content="Export support snapshot" Click="ExportSupportSnapshot_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="DiagnosticsSection" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Diagnostics"/><TextBlock Style="{StaticResource Text.Secondary}" Text="Current observations plus one bounded, read-only troubleshooting run." TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Width="150" Height="36" Content="Run Diagnostics" Click="RunDiagnostics_Click"/><Button Width="90" Height="36" Margin="8,0,0,0" Style="{DynamicResource Button.Secondary}" Content="Cancel" Click="CancelDiagnostics_Click"/></StackPanel>
                    </Grid>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Muted}" Text="{Binding DiagnosticsStatus}" TextWrapping="Wrap"/>
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding DiagnosticChecks}">
                        <ItemsControl.ItemTemplate><DataTemplate><Border Padding="10,8" Margin="0,0,0,6" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="{Binding Title}"/><TextBlock Grid.Column="1" Text="{Binding State}"/><TextBlock Grid.Column="2" Style="{StaticResource Text.Secondary}" Text="{Binding Summary}" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Width="170" Height="36" Style="{DynamicResource Button.Secondary}" Content="Copy Diagnostic Report" Click="CopyDiagnosticReport_Click"/></StackPanel>
                    <Border Margin="0,14,0,0" Padding="12" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Developer capability discovery"/>
                            <TextBlock Margin="0,4,0,8" Style="{StaticResource Text.Secondary}" Text="Read-only discovery of available GL.iNet/OpenWrt sources. The generated report is automatically sanitized." TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CollectCapabilityReportButton" Width="220" Height="36" Content="Collect Sanitized Capability Report" Click="CollectCapabilityReport_Click" AutomationProperties.Name="Collect sanitized router capability report"/>
                                <Button x:Name="CopyCapabilityReportButton" Width="150" Height="36" Margin="8,0,0,0" Style="{DynamicResource Button.Secondary}" IsEnabled="False" Content="Copy Capability Report" Click="CopyCapabilityReport_Click" AutomationProperties.Name="Copy sanitized capability report"/>
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Muted}" Text="{Binding CapabilityReportStatus}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="BackupSection" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Backup &amp; Restore" />
            <Border Padding="0" BorderThickness="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="RouterPilot data" />
                         <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                    Text="Back up settings, notification history, client profiles and service schedules in one portable .rpb package." />
                         <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                    Text="Backup files are not encrypted. Passwords remain protected by Windows; store backups securely." />
                        <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Secondary}"
                                   Text="{Binding LastBackupDate, StringFormat=Last backup: {0}}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}"
                                   Text="{Binding LastBackupResult, StringFormat=Last result: {0}}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                   Text="{Binding LastBackupDestination, StringFormat=Last destination: {0}}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Muted}"
                                   Text="{Binding LastBackupSize, StringFormat=Last size: {0}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
                        <Button Width="156" Height="36" Margin="0,0,0,10" IsEnabled="{Binding CanManageBackups}"
                                Style="{DynamicResource Button.Primary}" Content="Create Backup" Click="CreateBackup_Click" />
                        <Button Width="156" Height="36" Margin="0,0,0,10" IsEnabled="{Binding CanManageBackups}"
                                Style="{DynamicResource Button.Secondary}" Content="Restore Backup" Click="RestoreBackup_Click" />
                        <Button Width="156" Height="36" Style="{DynamicResource Button.Secondary}"
                                Content="Open Backup Folder" Click="OpenBackupFolder_Click" />
                    </StackPanel>
                </Grid>
            </Border>
                </StackPanel>
            </Border>

            <Border x:Name="HistorySection" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
            <TextBlock x:Name="MaintenanceHistoryHeading" Style="{StaticResource SectionHeaderStyle}" Text="Maintenance history" />
            <Border Padding="0" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="18,14,18,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.CardCaption}" Text="TIMESTAMP" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.CardCaption}" Text="ACTION" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Text.CardCaption}" Text="OUTCOME" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Text.CardCaption}" Text="MESSAGE" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="18,10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding TimestampDisplay}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" Text="{Binding ActionDisplay}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Secondary}" Foreground="{Binding OutcomeColour}" Text="{Binding OutcomeDisplay}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="{Binding Message}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="No maintenance actions have been recorded yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
