<UserControl x:Class="RouterPilot.Views.NetworkHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RouterPilot.Converters"
             Background="{DynamicResource Brush.WindowBackground}">
    <UserControl.Resources>
        <DataTemplate x:Key="HealthCheckCardTemplate">
            <Border MinWidth="250" Margin="0,0,12,12" Padding="16"
                    Background="{DynamicResource Brush.SurfaceMuted}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Title}" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,5,0,0" FontWeight="SemiBold"
                               Foreground="{Binding Severity, Converter={x:Static local:StatusColourConverter.Instance}}"
                               Text="{Binding Status}"/>
                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding Detail}" TextWrapping="Wrap"/>
                    <Button Margin="0,10,0,0" HorizontalAlignment="Left" Padding="10,4"
                            Style="{DynamicResource Button.Secondary}" Content="View" Tag="{Binding NavigationTarget}"
                            Click="Navigate_Click"
                            Visibility="{Binding HasNavigationTarget, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CoreServiceTemplate">
            <Border MinWidth="178" Margin="0,0,10,10" Padding="14,12"
                    Background="{DynamicResource Brush.SurfaceMuted}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.CardCaption}" Text="{Binding Title}" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold"
                               Foreground="{Binding Severity, Converter={x:Static local:StatusColourConverter.Instance}}"
                               Text="{Binding Status}" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding Detail}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,16">
            <Border Margin="0,0,0,16" Padding="20" Style="{DynamicResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.PageTitle}" Text="Network Health"/>
                        <TextBlock Margin="0,7,0,0" FontSize="25" FontWeight="SemiBold"
                                   Foreground="{Binding OverallColour}" Text="{Binding OverallStatus}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding OverallDetail}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding FreshnessSummary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Margin="16,0,0,0" Padding="14,8" VerticalAlignment="Top"
                            Style="{DynamicResource Button.Secondary}" Content="Refresh" Click="Refresh_Click"/>
                </Grid>
            </Border>

            <Border Margin="0,0,0,16" Padding="18" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Needs attention"/>
                    <TextBlock Margin="0,5,0,12" Style="{DynamicResource Text.Secondary}" Text="{Binding AttentionSummary}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding NeedsAttention}" ItemTemplate="{StaticResource HealthCheckCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Margin="0,0,0,16" Padding="18" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Core services"/>
                    <TextBlock Margin="0,5,0,12" Style="{DynamicResource Text.Secondary}" Text="The main connections and protection state for your network." TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding CoreServices}" ItemTemplate="{StaticResource CoreServiceTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="18" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Network features"/>
                    <TextBlock Margin="0,5,0,12" Style="{DynamicResource Text.Secondary}" Text="Additional services and router capabilities already observed by RouterPilot." TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding NetworkFeatures}" ItemTemplate="{StaticResource HealthCheckCardTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
