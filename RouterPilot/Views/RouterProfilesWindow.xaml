<Window x:Class="RouterPilot.Views.RouterProfilesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Saved Routers" Width="620" Height="420" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.WindowBackground}">
  <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Style="{DynamicResource Text.PageTitle}" Text="Routers"/><TextBlock Style="{DynamicResource Text.Secondary}" Text="Manage saved routers and choose which router RouterPilot connects to." TextWrapping="Wrap"/></StackPanel>
    <ListBox x:Name="Profiles" Grid.Row="1" Margin="0,18"><ListBox.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/><TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding RouterHost}"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Edit" Tag="{Binding}" Click="Edit_Click" Style="{DynamicResource Button.Secondary}"/><Button Margin="8,0,0,0" Content="Switch" Tag="{Binding}" Click="Switch_Click" Style="{DynamicResource Button.Secondary}" IsEnabled="{Binding CanSwitch}"/><Button Margin="8,0,0,0" Content="Remove" Tag="{Binding}" Click="Remove_Click" Style="{DynamicResource Button.Secondary}" IsEnabled="{Binding CanRemove}"/><TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding StatusLabel}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="Add Router" Click="Add_Click" Style="{DynamicResource Button.Secondary}"/><Button Margin="8,0,0,0" Content="Close" Click="Close_Click" Style="{DynamicResource Button.Primary}"/></StackPanel>
  </Grid>
</Window>
