<UserControl x:Class="RouterPilot.Views.KnownDevicesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:RouterPilot.Converters">
 <UserControl.Resources><local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Style="{StaticResource Page.Content}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Style="{DynamicResource Text.PageTitle}" Text="Known Devices"/><TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Secondary}" Text="Devices RouterPilot has learned about over time"/></StackPanel>
    <Button Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource Button.Secondary}" Content="Current Clients" Click="CurrentClients_Click"/>
   </Grid>
   <Border Grid.Row="2" Style="{DynamicResource Card.Compact}"><WrapPanel>
    <StackPanel Margin="0,0,28,0"><TextBlock Style="{DynamicResource Text.Muted}" Text="KNOWN DEVICES"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding TotalCount}"/></StackPanel>
    <StackPanel Margin="0,0,28,0"><TextBlock Style="{DynamicResource Text.Muted}" Text="ONLINE"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding OnlineCount}"/></StackPanel>
    <StackPanel Margin="0,0,28,0"><TextBlock Style="{DynamicResource Text.Muted}" Text="NOT CURRENTLY OBSERVED"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding OfflineCount}"/></StackPanel>
    <StackPanel Margin="0,0,28,0"><TextBlock Style="{DynamicResource Text.Muted}" Text="NEEDS REVIEW"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding NeedsReviewCount}"/></StackPanel>
    <StackPanel><TextBlock Style="{DynamicResource Text.Muted}" Text="MONITORED"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding MonitoredCount}"/></StackPanel>
   </WrapPanel></Border>
   <Border Grid.Row="4" Style="{DynamicResource Card.Compact}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
    <TextBox x:Name="KnownDevicesSearchBox" Height="36" Padding="36,7,10,7" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search name, hostname, IP, MAC or category"/>
    <TextBlock Style="{StaticResource Search.Icon}" />
    <TextBlock Margin="36,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextSecondary}" Text="Search">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=KnownDevicesSearchBox}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=KnownDevicesSearchBox}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <ComboBox Grid.Column="2" Height="36" Style="{StaticResource RouterPilot.ComboBox}" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"/>
    <ComboBox Grid.Column="4" Height="36" Style="{StaticResource RouterPilot.ComboBox}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"/>
   </Grid></Border>
   <Grid Grid.Row="6" Margin="0,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="5.5*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Padding="12" Style="{DynamicResource Card.Compact}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="SELECTED CLIENT"/><TextBlock Grid.Row="2" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding SelectedClient.Name, TargetNullValue=No client selected}"/><Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="IP ADDRESS"/><TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding SelectedClient.IpAddress, TargetNullValue=—}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="CONNECTION"/><TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding SelectedClient.ConnectionSummary, TargetNullValue=—}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="DNS ACTIVITY"/><TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding SelectedClient.TotalQueriesDisplay, TargetNullValue=—}"/></StackPanel></Grid></Grid></Border>
    <Border Grid.Column="2" Padding="12" Style="{DynamicResource Card.Compact}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="13" FontWeight="Bold" Text="RECENT ACTIVITY"/><TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="DNS activity from this session"/></StackPanel><CheckBox Grid.Column="1" Margin="12,0,0,0" FontSize="11" IsChecked="True" Content="Auto-scroll to top"/></Grid><TextBlock Grid.Row="2" Foreground="{DynamicResource Brush.TextSecondary}" Text="No activity yet this session" Visibility="{Binding HasSelectedClientActivity, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/><ListBox Grid.Row="2" ItemsSource="{Binding SelectedClientActivity}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding TimeDisplay}"/><StackPanel Grid.Column="1"><TextBlock FontWeight="SemiBold" Text="{Binding Summary}"/><TextBlock Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
   </Grid>
   <StackPanel Grid.Row="7" Margin="0,16,0,0">
    <TextBlock HorizontalAlignment="Center" Margin="0,36" Text="No known devices yet&#x0a;RouterPilot will build this list as devices are observed." TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDevices}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <Border MinHeight="360" Padding="10" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="10" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"><ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" MouseDoubleClick="Devices_MouseDoubleClick"><ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasDevices}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
     <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource ClientDeviceCardItem}"/></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource ClientDeviceCard}">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="9"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="38" Height="38" Background="{DynamicResource Brush.PrimarySubtle}" CornerRadius="19"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Emoji" FontSize="18" Text="{Binding DeviceIcon}"/></Border>
        <StackPanel Grid.Column="1"><TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Text="{Binding Name}"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Secondary}" Text="{Binding Secondary}"/></StackPanel>
        <Button Grid.Column="2" Width="34" Height="32" Padding="0" FontSize="19" Foreground="{DynamicResource Brush.Warning}" IsHitTestVisible="False" Focusable="False" Content="{Binding FavoriteGlyph}"/>
       </Grid>
       <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding DeviceType}"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Text="{Binding Manufacturer}"/><TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.TextSecondary}"><Run Text="Last observed: "/><Run Text="{Binding LastObserved, Mode=OneWay}"/></TextBlock></StackPanel>
        <Border Grid.Column="1" Margin="8,0,0,0" Padding="9,4" VerticalAlignment="Top" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="10"><TextBlock FontWeight="SemiBold" Foreground="{Binding HealthColour}" Text="{Binding HealthText}"/></Border>
       </Grid>
       <StackPanel Grid.Row="4"><TextBlock Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Text="{Binding ConnectionSummary}" Visibility="{Binding HasConnectionSummary, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Text="{Binding SignalSummary}" Visibility="{Binding HasSignalSummary, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Margin="0,4,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" Text="Monitoring" Visibility="{Binding IsMonitored, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
       <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource ClientDnsValueText}" Text="{Binding TotalQueriesDisplay}"/><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="Queries"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Style="{StaticResource ClientBlockedDnsValueText}" ToolTip="{Binding ActivityAvailabilityToolTip}" Text="{Binding BlockedQueriesDisplay}"/><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="Blocked"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Style="{StaticResource ClientDnsValueText}" ToolTip="{Binding ActivityAvailabilityToolTip}" Text="{Binding BlockRateDisplay}"/><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="Block rate"/></StackPanel></Grid>
       <WrapPanel Grid.Row="8"><TextBlock Margin="0,0,10,0" Foreground="{DynamicResource Brush.Warning}" Text="Needs Review" Visibility="{Binding NeedsReview, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Foreground="{DynamicResource Brush.Warning}" Text="Favourite" Visibility="{Binding IsFavourite, Converter={StaticResource BooleanToVisibilityConverter}}"/></WrapPanel>
      </Grid>
     </Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox></Border>
   </StackPanel>
  </Grid>
 </ScrollViewer>
</UserControl>
