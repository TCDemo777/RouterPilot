<UserControl x:Class="RouterPilot.Views.KnownDevicesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Style="{StaticResource Page.Content}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Style="{DynamicResource Text.PageTitle}" Text="Known Devices"/><TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Secondary}" Text="Devices RouterPilot has learned about over time"/></StackPanel>
    <Button Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource Button.Secondary}" Content="Current Clients" Click="CurrentClients_Click"/>
   </Grid>
   <Border Grid.Row="2" Style="{DynamicResource Card.Compact}"><WrapPanel>
    <StackPanel Margin="0,0,28,0"><TextBlock Style="{DynamicResource Text.Muted}" Text="KNOWN DEVICES"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding TotalCount}"/></StackPanel>
    <StackPanel Margin="0,0,28,0"><TextBlock Style="{DynamicResource Text.Muted}" Text="ONLINE"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding OnlineCount}"/></StackPanel>
    <StackPanel Margin="0,0,28,0"><TextBlock Style="{DynamicResource Text.Muted}" Text="NOT CURRENTLY OBSERVED"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding OfflineCount}"/></StackPanel>
    <StackPanel Margin="0,0,28,0"><TextBlock Style="{DynamicResource Text.Muted}" Text="NEEDS REVIEW"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding NeedsReviewCount}"/></StackPanel>
    <StackPanel><TextBlock Style="{DynamicResource Text.Muted}" Text="MONITORED"/><TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding MonitoredCount}"/></StackPanel>
   </WrapPanel></Border>
   <Border Grid.Row="4" Style="{DynamicResource Card.Compact}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
    <TextBox Height="36" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search name, hostname, IP, MAC or category"/>
    <ComboBox Grid.Column="2" Height="36" Style="{StaticResource RouterPilot.ComboBox}" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}"/>
    <ComboBox Grid.Column="4" Height="36" Style="{StaticResource RouterPilot.ComboBox}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"/>
   </Grid></Border>
   <StackPanel Grid.Row="5" Margin="0,16,0,0">
    <TextBlock HorizontalAlignment="Center" Margin="0,36" Text="No known devices yet&#x0a;RouterPilot will build this list as devices are observed." TextAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDevices}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" BorderThickness="0" Background="Transparent" MouseDoubleClick="Devices_MouseDoubleClick"><ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasDevices}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
     <ListBox.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="14" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Margin="8,0,0,0" Foreground="{DynamicResource Brush.Warning}" Text="Needs Review" Visibility="{Binding NeedsReview, Converter={StaticResource BooleanToVisibilityConverter}}"/><TextBlock Margin="8,0,0,0" Text="★" Visibility="{Binding IsFavourite, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel><TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding Secondary}"/></StackPanel>
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Status}"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Category}"/><StackPanel Grid.Column="3"><TextBlock Text="{Binding LastObserved}"/><TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Secondary}" Text="Monitored" Visibility="{Binding IsMonitored, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
     </Grid></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </StackPanel>
  </Grid>
 </ScrollViewer>
</UserControl>
