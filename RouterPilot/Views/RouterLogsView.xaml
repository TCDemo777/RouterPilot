<UserControl x:Class="RouterPilot.Views.RouterLogsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Brush.WindowBackground}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24"><TextBlock Style="{DynamicResource Text.PageTitle}" Text="Router Logs"/><TextBlock Margin="0,5,0,16" Style="{DynamicResource Text.Secondary}" Text="Bounded recent messages reported by the router. Categories organise events and are not root-cause diagnoses." TextWrapping="Wrap"/><Border Style="{DynamicResource Card}" Padding="14"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Height="36" Padding="10,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search router log messages" AutomationProperties.Name="Search router logs"/><Button Grid.Column="1" Margin="10,0,0,0" Padding="14,6" Content="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh router logs"/></Grid><WrapPanel Margin="0,12,0,0"><TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Severity:"/><ComboBox Width="145" ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SelectedSeverity}" AutomationProperties.Name="Router log severity filter"/><TextBlock Margin="16,0,8,0" VerticalAlignment="Center" Text="Category:"/><ComboBox Width="170" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" AutomationProperties.Name="Router log category filter"/></WrapPanel><TextBlock Margin="0,12,0,8" Style="{DynamicResource Text.Muted}" Text="{Binding StatusMessage}"/><DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" MinHeight="320" AutomationProperties.Name="Router log entries"><DataGrid.Columns><DataGridTextColumn Header="TIME" Width="150" Binding="{Binding Timestamp}"/><DataGridTextColumn Header="SEVERITY" Width="110" Binding="{Binding Severity}"/><DataGridTextColumn Header="CATEGORY" Width="150" Binding="{Binding Category}"/><DataGridTextColumn Header="SOURCE" Width="120" Binding="{Binding Source}"/><DataGridTextColumn Header="MESSAGE" Width="*" Binding="{Binding Message}"/></DataGrid.Columns></DataGrid><TextBlock Margin="0,10,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding EmptyMessage}"/><Border Margin="0,10,0,0" Padding="12" Style="{DynamicResource Card.Compact}" AutomationProperties.Name="Selected router log details"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="SELECTED EVENT"/><TextBlock Margin="0,5,0,0" Text="{Binding SelectedEntry.Message, TargetNullValue=Select an event to view its details.}" TextWrapping="Wrap"/><TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding SelectedEntry.Category}"/></StackPanel></Border></StackPanel></Border></StackPanel></ScrollViewer></UserControl>
