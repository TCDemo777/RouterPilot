<UserControl x:Class="RouterPilot.Views.GlobalSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.WindowBackground}"
    Foreground="{DynamicResource Brush.TextPrimary}">
    <!-- The results ListBox retains its own scrolling because search stays fixed while
         potentially large, virtualized result sets remain independently usable. -->
    <Grid Style="{StaticResource Page.Content}"
          Background="{DynamicResource Brush.WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource Text.PageTitle}"
                       Text="Global Search"/>
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource Text.Secondary}"
                       Text="Search current RouterPilot clients, network configuration, and pages."/>
        </StackPanel>

        <Border Grid.Row="2"
                Padding="14"
                Background="{DynamicResource Brush.Surface}"
                CornerRadius="10"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Height="38"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText,
                                        UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchBox_KeyDown"
                         ToolTip="Search clients, IP, MAC address, ports, reservations, Wi-Fi, or pages"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{DynamicResource Text.Muted}" Text="Local results"/>
            </Grid>
        </Border>

        <Border Grid.Row="4"
                Padding="10"
                Background="{DynamicResource Brush.SurfaceMuted}"
                CornerRadius="10"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1">
            <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}"
                     BorderThickness="0"
                     Background="Transparent"
                     MouseLeftButtonUp="ResultsList_MouseLeftButtonUp"
                     KeyDown="ResultsList_KeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14"
                                Background="{DynamicResource Brush.Surface}"
                                CornerRadius="9"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock FontSize="16"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               Text="{Binding Title}"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextWrapping="Wrap"
                                               Text="{Binding Subtitle}"/>
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               TextWrapping="Wrap"
                                               Text="{Binding Detail}"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="10,5"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        CornerRadius="11">
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{Binding BadgeColour}"
                                               Text="{Binding BadgeText}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="5"
                   Margin="2,9,0,0"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   Text="{Binding StatusMessage}"/>
    </Grid>
</UserControl>
