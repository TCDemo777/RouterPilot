<Window x:Class="RouterPilot.Views.ClientDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Client Details"
        Width="1180"
        Height="820"
        MinWidth="1000"
        MinHeight="700"
        Background="{DynamicResource Brush.SurfaceMuted}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="CardStyle"
               TargetType="Border"
               BasedOn="{StaticResource Card.Compact}"/>

        <Style x:Key="CopyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="RankingList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="RankingItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="100" Height="36" Margin="0,0,10,0"
                        Command="{Binding RefreshCommand}" Content="Refresh"/>
                <Button MinWidth="100" Height="36"
                        Command="{Binding TogglePauseCommand}" Content="{Binding PauseButtonText}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="27" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"
                           Text="{Binding ClientName}"/>
                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                           Text="Live DNS activity and client statistics"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right"
                                Padding="8,3"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                CornerRadius="9">
                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding HealthColour}"
                                       Text="{Binding HealthText}"/>
                        </Border>
                        <Border DockPanel.Dock="Left" Width="42" Height="42" Margin="0,0,12,0"
                                Background="{DynamicResource Brush.PrimarySubtle}" CornerRadius="21">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" Foreground="{DynamicResource Brush.Primary}" Text="&#xE716;"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"
                                       Text="CLIENT IDENTITY"/>
                            <TextBlock Margin="0,3,0,0" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Text="{Binding ClientName}"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="IP ADDRESS"/>
                            <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyIpCommand}" Content="Copy"/>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding IpAddress}"
                                           Text="{Binding IpAddress}"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="MAC ADDRESS"/>
                            <DockPanel Margin="0,4,0,0" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Style="{StaticResource CopyButtonStyle}"
                                        Command="{Binding CopyMacCommand}" Content="Copy"/>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding MacAddress}"
                                           Text="{Binding MacAddress}"/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="CONNECTION"/>
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ConnectionSummary}" Text="{Binding ConnectionSummary}"/>
                        <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding SignalSummary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSignal}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Margin="0,12,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDhcpDetails}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="DHCP"/>
                            <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="{Binding DhcpSummary}"/>
                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                                       Text="{Binding DhcpLeaseRemaining, StringFormat=Lease remaining: {0}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDhcpLeaseRemaining}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="OBSERVED"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" Text="First observed"/>
                                    <TextBlock Text="{Binding FirstObserved}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" Text="Last observed"/>
                                    <TextBlock Text="{Binding LastObserved}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="TOTAL QUERIES"/>
                    <TextBlock Margin="0,8,0,3" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}"
                               Text="{Binding TotalQueriesDisplay}"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Text="Requests from this client"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="BLOCKED"/>
                    <TextBlock Margin="0,8,0,3" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource Brush.Danger}"
                               Text="{Binding BlockedQueriesDisplay}"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Text="Protection actions"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="BLOCK RATE"/>
                    <TextBlock Margin="0,8,0,3" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource Brush.Warning}"
                               Text="{Binding BlockRateDisplay}"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding LastSeen}" Text="{Binding LastSeen, StringFormat=Last seen: {0}}"/>
                </StackPanel>
            </Border>
        </Grid>


        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"
                               Text="Personalise this client"/>
                    <TextBlock Margin="0,4,0,14" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="Set a friendly display name, category and private notes. These details are stored on this PC and matched by MAC address."/>

                    <TextBlock Margin="0,0,0,5" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextSecondary}" Text="DISPLAY NAME"/>
                    <TextBox Height="36" VerticalContentAlignment="Center"
                             Text="{Binding ProfileNickname, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Margin="0,12,0,5" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextSecondary}" Text="DEVICE CATEGORY"/>
                    <ComboBox Height="36" IsEditable="True"
                              Text="{Binding ProfileCategory, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Computer"/>
                        <ComboBoxItem Content="Mobile device"/>
                        <ComboBoxItem Content="Games console"/>
                        <ComboBoxItem Content="Media or smart TV"/>
                        <ComboBoxItem Content="Server or NAS"/>
                        <ComboBoxItem Content="Printer"/>
                        <ComboBoxItem Content="Smart home / IoT"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Margin="0,0,0,5" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextSecondary}" Text="PRIVATE NOTES"/>
                    <TextBox MinHeight="126" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding ProfileNotes, UpdateSourceTrigger=PropertyChanged}"/>
                    <WrapPanel Margin="0,12,0,0" HorizontalAlignment="Right">
                        <Button MinWidth="110" Height="36" Margin="0,0,10,0"
                                Command="{Binding ClearProfileCommand}" Content="Clear Profile"/>
                        <Button MinWidth="120" Height="36"
                                Command="{Binding SaveProfileCommand}" Content="Save Profile"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" MinHeight="285">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Padding="8,3" Background="{DynamicResource Brush.PrimarySubtle}" CornerRadius="9">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" Text="TOP 5"/>
                            </Border>
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="Top requested domains"/>
                        </DockPanel>
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="Most frequently requested destinations for this client"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <TextBlock VerticalAlignment="Center" Text="No requested domains recorded.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.EmptyStateMessage}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTopDomains}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox Style="{StaticResource RankingList}"
                                 ItemContainerStyle="{StaticResource RankingItem}"
                                 ItemsSource="{Binding TopDomains}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,13" ToolTip="{Binding Domain}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="12"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" Background="{DynamicResource Brush.PrimarySubtle}" CornerRadius="12" VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}"
                                                           Text="{Binding Rank}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Domain}"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Primary}" Text="{Binding Count, StringFormat={}{0:N0}}"/>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Border Background="{DynamicResource Brush.Border}" CornerRadius="6"/>
                                            <ProgressBar Height="12" Maximum="100" Value="{Binding Percentage}"
                                                         Foreground="#3B82F6" Background="Transparent" BorderThickness="0"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" MinHeight="285">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Right" Padding="8,3" Background="{DynamicResource Brush.DangerSubtle}" CornerRadius="9">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" Text="TOP 5"/>
                            </Border>
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="Top blocked domains"/>
                        </DockPanel>
                        <TextBlock Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="Domains stopped most often for this client"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <TextBlock VerticalAlignment="Center" Text="No blocked domains recorded.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.EmptyStateMessage}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTopBlockedDomains}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox Style="{StaticResource RankingList}"
                                 ItemContainerStyle="{StaticResource RankingItem}"
                                 ItemsSource="{Binding TopBlockedDomains}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,13" ToolTip="{Binding Domain}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="12"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24" Height="24" Background="{DynamicResource Brush.DangerSubtle}" CornerRadius="12" VerticalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Danger}"
                                                           Text="{Binding Rank}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Domain}"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Danger}" Text="{Binding Count, StringFormat={}{0:N0}}"/>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Border Background="{DynamicResource Brush.DangerSubtle}" CornerRadius="6"/>
                                            <ProgressBar Height="12" Maximum="100" Value="{Binding Percentage}"
                                                         Foreground="{DynamicResource Brush.Danger}" Background="Transparent" BorderThickness="0"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"
                                   Text="Recent DNS Requests"/>
                        <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="Latest 50 requests"/>
                    </DockPanel>
                    <Grid Grid.Row="2">
                        <TextBlock VerticalAlignment="Center" Text="No recent DNS requests recorded.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.EmptyStateMessage}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentQueries}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="None" RowHeight="40" AlternatingRowBackground="{DynamicResource Brush.SurfaceMuted}"
                                  ItemsSource="{Binding RecentQueries}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="155" Header="Time" Binding="{Binding Time}"/>
                                <DataGridTemplateColumn Width="*" Header="Domain">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Domain}" Text="{Binding Domain}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="110" Header="Result">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,4" HorizontalAlignment="Left" CornerRadius="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                <Setter Property="Background" Value="#FDECEC"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Status}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#16803C"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="7" Margin="2,11,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                   Text="{Binding StatusMessage}"/>
        </Grid>
    </ScrollViewer>
</Window>
