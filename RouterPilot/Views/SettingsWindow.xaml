<Window x:Class="RouterPilot.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RouterPilot Settings"
        Height="440"
        Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->

        <TextBlock
            Text="GL.iNet Connection Settings"
            FontSize="24"
            FontWeight="Bold"
            Margin="0,0,0,25"/>

        <!-- Router IP -->

        <TextBlock
            Grid.Row="1"
            Text="Router IP"
            FontWeight="Bold"/>

        <TextBox
            x:Name="RouterIpBox"
            Grid.Row="2"
            Height="30"
            Margin="0,5,0,15"/>

        <!-- Username -->

        <TextBlock
            Grid.Row="3"
            Text="Username"
            FontWeight="Bold"/>

        <TextBox
            x:Name="UsernameBox"
            Grid.Row="4"
            Height="30"
            Margin="0,5,0,15"/>

        <!-- Password -->

        <TextBlock
            Grid.Row="5"
            Text="Password"
            FontWeight="Bold"/>

        <PasswordBox
            x:Name="PasswordBox"
            Grid.Row="6"
            Height="30"
            Margin="0,5,0,15"/>

        <!-- Options -->

        <StackPanel
            Grid.Row="7">

            <CheckBox
                x:Name="RememberPasswordCheck"
                Content="Remember password"
                Margin="0,0,0,10"/>

            <CheckBox
                x:Name="StartWithWindowsCheck"
                Content="Start with Windows"
                Margin="0,0,0,20"/>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right">

                <Button
                    x:Name="SaveButton"
                    Width="90"
                    Height="32"
                    Margin="0,0,10,0"
                    Content="Save"
                    Click="SaveButton_Click"/>

                <Button
                    Width="90"
                    Height="32"
                    Content="Cancel"
                    Click="Cancel_Click"/>

            </StackPanel>

        </StackPanel>

    </Grid>

</Window>
