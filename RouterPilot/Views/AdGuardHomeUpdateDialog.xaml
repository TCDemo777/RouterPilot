<Window x:Class="RouterPilot.Views.AdGuardHomeUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update AdGuard Home" Width="650" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}" Foreground="{DynamicResource Brush.TextPrimary}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
        <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Update AdGuard Home"/>
        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="INSTALLED"/><TextBlock Grid.Column="1" Text="{Binding InstalledVersion}"/>
            <TextBlock Grid.Row="1" Style="{DynamicResource Text.CardCaption}" Text="LATEST STABLE"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestVersion}"/>
        </Grid>
        <Expander Margin="0,18,0,0" Header="Advanced options">
            <StackPanel Margin="0,10,0,0">
                <CheckBox x:Name="SelectRelease" Content="Select a specific release" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                <TextBlock Margin="24,3,0,10" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap" Text="Choose a specific AdGuard Home release interactively in the community updater."/>
                <CheckBox x:Name="IgnoreFreeSpace" Content="Ignore free-space check — HIGH RISK" Foreground="{DynamicResource Brush.Warning}" Checked="OptionsChanged" Unchecked="OptionsChanged"/>
                <TextBlock Margin="24,3,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap" Text="This bypasses the updater’s storage check and normal original-file backup. Insufficient storage could leave AdGuard Home damaged or unusable, and recovery may be more difficult."/>
            </StackPanel>
        </Expander>
        <Border Margin="0,16,0,0" Padding="12" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="6">
            <StackPanel><TextBlock FontWeight="SemiBold" Text="Community updater"/><TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Text="RouterPilot will open an interactive terminal and copy this third-party community-updater command. The updater is not maintained by RouterPilot, AdGuard, or GL.iNet. Authenticate normally, paste the command, and review terminal output before answering its questions."/>
                <TextBox Margin="0,10,0,0" IsReadOnly="True" Text="{Binding CommandPreview, Mode=OneWay}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap" Text="The updater may ask whether to enable persistent query logging. Persistent query logging increases storage writes and may contribute to flash wear. RouterPilot will not change that setting."/>
            </StackPanel>
        </Border>
        <Border x:Name="RiskWarning" Margin="0,12,0,0" Padding="12" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="6" Visibility="Collapsed">
            <StackPanel><TextBlock Foreground="{DynamicResource Brush.Warning}" FontWeight="SemiBold" Text="Ignore free-space protection"/><TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Text="The community updater’s free-space check and normal original-file backup will be bypassed. If storage is insufficient, AdGuard Home or other router functionality could be left unusable."/><CheckBox x:Name="RiskAcknowledgement" Margin="0,10,0,0" Content="I understand that this disables the updater’s storage check and normal backup protection." Checked="OptionsChanged" Unchecked="OptionsChanged"/></StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button MinWidth="90" Content="Cancel" IsCancel="True"/><Button x:Name="OpenButton" MinWidth="176" Margin="8,0,0,0" Style="{DynamicResource Button.Danger}" Content="Open updater terminal" Click="Open_Click"/></StackPanel>
    </StackPanel></ScrollViewer>
</Window>
