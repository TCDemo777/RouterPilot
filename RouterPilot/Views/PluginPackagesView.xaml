<UserControl x:Class="RouterPilot.Views.PluginPackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.WindowBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="360"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel>

                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.PageTitle}"
                               Text="Plug-ins"/>

                    <TextBlock Margin="0,4,0,16"
                               Style="{DynamicResource Text.Secondary}"
                               Text="Read-only package inventory reported by the router."/>
                </StackPanel>

                <Button DockPanel.Dock="Right"
                        Padding="14,7"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"/>

            </DockPanel>

            <!-- Summary -->
            <UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0,0,0,14">

                <Border Style="{DynamicResource Card}"
                        Margin="0,0,8,0"
                        Padding="12">

                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.CardCaption}"
                                   Text="INSTALLED"/>

                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="{Binding InstalledCount}"/>
                    </StackPanel>

                </Border>

                <Border Style="{DynamicResource Card}"
                        Margin="4,0,4,0"
                        Padding="12">

                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.CardCaption}"
                                   Text="AVAILABLE"/>

                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="{Binding AvailableCount}"/>
                    </StackPanel>

                </Border>

                <Border Style="{DynamicResource Card}"
                        Margin="4,0,4,0"
                        Padding="12">

                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.CardCaption}"
                                   Text="UPDATES"/>

                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="{Binding UpdatesCount}"/>
                    </StackPanel>

                </Border>

                <Border Style="{DynamicResource Card}"
                        Margin="8,0,0,0"
                        Padding="12">

                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.CardCaption}"
                                   Text="PACKAGE INDEX"/>

                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{Binding IndexStatus}"/>

                        <TextBlock Style="{DynamicResource Text.Muted}"
                                   Text="{Binding IndexFreshness}"/>
                    </StackPanel>

                </Border>

            </UniformGrid>

            <!-- Search / filter -->
            <Border Grid.Row="2"
                    Style="{DynamicResource Card}"
                    Padding="14"
                    Margin="0,0,0,14">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid>

                        <TextBox x:Name="SearchBox"
                                 Height="36"
                                 Padding="36,6,10,6"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource Search.Icon}"/>

                        <TextBlock Margin="36,0,10,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="Search">

                            <TextBlock.Style>
                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                    <Style.Triggers>

                                        <MultiDataTrigger>

                                            <MultiDataTrigger.Conditions>

                                                <Condition Binding="{Binding Text, ElementName=SearchBox}"
                                                           Value=""/>

                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}"
                                                           Value="False"/>

                                            </MultiDataTrigger.Conditions>

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </MultiDataTrigger>

                                    </Style.Triggers>

                                </Style>
                            </TextBlock.Style>

                        </TextBlock>

                    </Grid>

                    <ComboBox Grid.Column="1"
                              Margin="12,0,0,0"
                              ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter}"/>

                    <TextBlock Grid.Column="2"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Style="{DynamicResource Text.Muted}"
                               Text="{Binding StatusMessage}"/>

                </Grid>

            </Border>

            <!-- Package list -->
            <Border Grid.Row="3"
                    Style="{DynamicResource Card}"
                    Padding="10"
                    Margin="0,0,0,14">

                <DataGrid ItemsSource="{Binding PackagesView}"
                          SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="None"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Name"
                                            Width="*"
                                            Binding="{Binding Name}"/>

                        <DataGridTextColumn Header="Installed"
                                            Width="150"
                                            Binding="{Binding DisplayInstalledVersion}"/>

                        <DataGridTextColumn Header="Available"
                                            Width="150"
                                            Binding="{Binding DisplayAvailableVersion}"/>

                        <DataGridTextColumn Header="Architecture"
                                            Width="130"
                                            Binding="{Binding DisplayArchitecture}"/>

                        <DataGridTextColumn Header="Status"
                                            Width="150"
                                            Binding="{Binding DisplayStatus}"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

            <!-- Package details -->
            <Border Grid.Row="4"
                    Style="{DynamicResource Card}"
                    Padding="16"
                    Margin="0,0,0,14">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Style="{DynamicResource Text.CardCaption}"
                               Text="PACKAGE DETAILS"/>

                    <TextBlock Grid.Row="1"
                               Margin="0,8,0,14"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedPackage.Name, TargetNullValue=Select a package}"
                               TextWrapping="Wrap"/>

                    <!-- Versions / architecture / status -->
                    <Grid Grid.Row="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Muted}"
                                       Text="Installed version"/>

                            <TextBlock Text="{Binding SelectedPackage.DisplayInstalledVersion}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{DynamicResource Text.Muted}"
                                       Text="Available version"/>

                            <TextBlock Text="{Binding SelectedPackage.DisplayAvailableVersion}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{DynamicResource Text.Muted}"
                                       Text="Architecture"/>

                            <TextBlock Text="{Binding SelectedPackage.DisplayArchitecture}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{DynamicResource Text.Muted}"
                                       Text="Status"/>

                            <TextBlock Text="{Binding SelectedPackage.DisplayStatus}"/>
                        </StackPanel>

                    </Grid>

                    <!-- Description / metadata -->
                    <Grid Grid.Row="3"
                          Margin="0,14,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,16,0">

                            <TextBlock Style="{DynamicResource Text.Muted}"
                                       Text="Description"/>

                            <TextBlock Text="{Binding SelectedPackage.DisplayDescription}"
                                       TextWrapping="Wrap"/>

                            <TextBlock Margin="0,10,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Text="Dependencies"/>

                            <TextBlock Text="{Binding SelectedPackage.DisplayDependencies}"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <TextBlock Style="{DynamicResource Text.Muted}"
                                       Text="Installed time"/>

                            <TextBlock Text="{Binding SelectedPackage.DisplayInstalledTime}"/>

                            <TextBlock Margin="0,10,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Text="Source"/>

                            <TextBlock Text="{Binding SelectedPackage.DisplaySource}"/>

                        </StackPanel>

                    </Grid>

                    <!-- Actions -->
                    <Grid Grid.Row="4"
                          Margin="0,16,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Style="{DynamicResource Text.Muted}"
                                   Text="{Binding ActionBlockReason}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding HasActionBlockReason,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                            <Button x:Name="InstallButton"
                                    Content="Install"
                                    Padding="14,6"
                                    Margin="0,0,8,0"
                                    Command="{Binding InstallCommand}"
                                    IsEnabled="{Binding CanInstall}"
                                    Visibility="{Binding CanInstall,
                                                         Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Button x:Name="UpdateButton"
                                    Content="Update"
                                    Padding="14,6"
                                    Margin="0,0,8,0"
                                    Style="{DynamicResource Button.Secondary}"
                                    Command="{Binding UpdateCommand}"
                                    IsEnabled="{Binding CanUpdate}"
                                    ToolTip="{Binding UpdateBlockReason}"
                                    Visibility="{Binding ShouldShowUpdate,
                                                         Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Button x:Name="ForceUpdateButton"
                                    Content="Force update"
                                    Padding="14,6"
                                    Margin="0,0,8,0"
                                    Style="{DynamicResource Button.Danger}"
                                    Command="{Binding ForceUpdateCommand}"
                                    IsEnabled="{Binding CanForceUpdate}"
                                    ToolTip="{Binding ForceUpdateBlockReason}"
                                    Visibility="{Binding ShouldShowUpdate,
                                                         Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Button x:Name="UninstallButton"
                                    Content="Uninstall"
                                    Padding="14,6"
                                    Margin="0,0,8,0"
                                    Style="{DynamicResource Button.Danger}"
                                    Command="{Binding RemoveCommand}"
                                    IsEnabled="{Binding CanRemove}"
                                    ToolTip="{Binding UninstallBlockReason}"
                                    Visibility="{Binding ShouldShowUninstall,
                                                         Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <Button x:Name="RefreshIndexesButton"
                                    Content="Refresh package indexes"
                                    Padding="14,6"
                                    Command="{Binding RefreshIndexesCommand}"
                                    IsEnabled="{Binding CanRefreshIndexes}"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>