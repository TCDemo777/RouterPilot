<UserControl x:Class="RouterPilot.Views.PluginPackagesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Brush.WindowBackground}"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Style="{DynamicResource Text.PageTitle}" Text="Plug-ins"/><TextBlock Margin="0,4,0,16" Style="{DynamicResource Text.Secondary}" Text="Read-only package inventory reported by the router."/></StackPanel><Button DockPanel.Dock="Right" Padding="14,7" Content="Refresh" Command="{Binding RefreshCommand}"/></DockPanel><UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14"><Border Style="{DynamicResource Card}" Margin="0,0,8,0" Padding="12"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="INSTALLED"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding InstalledCount}"/></StackPanel></Border><Border Style="{DynamicResource Card}" Margin="4,0,4,0" Padding="12"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="AVAILABLE"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding AvailableCount}"/></StackPanel></Border><Border Style="{DynamicResource Card}" Margin="4,0,4,0" Padding="12"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="UPDATES"/><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding UpdatesCount}"/></StackPanel></Border><Border Style="{DynamicResource Card}" Margin="8,0,0,0" Padding="12"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="PACKAGE INDEX"/><TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding IndexStatus}"/></StackPanel></Border></UniformGrid><Border Grid.Row="2" Style="{DynamicResource Card}" Padding="14" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="SearchBox" Height="36" Padding="36,6,10,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Style="{StaticResource Search.Icon}"/><TextBlock Margin="36,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextSecondary}" Text="Search"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=SearchBox}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox Grid.Column="1" Margin="12,0,0,0" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"/><TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Text.Muted}" Text="{Binding StatusMessage}"/></Grid></Border><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{DynamicResource Card}" Padding="10" Margin="0,0,12,0"><DataGrid ItemsSource="{Binding PackagesView}" SelectedItem="{Binding SelectedPackage, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="None" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}"/><DataGridTextColumn Header="Installed" Width="110" Binding="{Binding DisplayInstalledVersion}"/><DataGridTextColumn Header="Available" Width="110" Binding="{Binding DisplayAvailableVersion}"/><DataGridTextColumn Header="Architecture" Width="100" Binding="{Binding DisplayArchitecture}"/><DataGridTextColumn Header="Status" Width="120" Binding="{Binding DisplayStatus}"/></DataGrid.Columns></DataGrid></Border><Border Grid.Column="1" Style="{DynamicResource Card}" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="PACKAGE DETAILS"/><TextBlock Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedPackage.Name, TargetNullValue=Select a package}" TextWrapping="Wrap"/><TextBlock Margin="0,12,0,0" Style="{DynamicResource Text.Muted}" Text="Installed version"/><TextBlock Text="{Binding SelectedPackage.DisplayInstalledVersion}"/><TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Muted}" Text="Available version"/><TextBlock Text="{Binding SelectedPackage.DisplayAvailableVersion}"/><TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Muted}" Text="Description"/><TextBlock Text="{Binding SelectedPackage.DisplayDescription}" TextWrapping="Wrap"/><TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Muted}" Text="Dependencies"/><TextBlock Text="{Binding SelectedPackage.DisplayDependencies}" TextWrapping="Wrap"/><TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Muted}" Text="Installed time"/><TextBlock Text="{Binding SelectedPackage.DisplayInstalledTime}"/></StackPanel></ScrollViewer></Border></Grid></Grid></UserControl>
