<Window x:Class="RouterPilot.Views.TailscaleRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:RouterPilot.Services"
        Title="Restore firmware Tailscale binaries" Width="620" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}" Foreground="{DynamicResource Brush.TextPrimary}">
    <StackPanel Margin="22">
        <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Restore firmware Tailscale binaries"/>
        <Border Margin="0,16,0,0" Padding="12" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="6">
            <StackPanel><TextBlock Foreground="{DynamicResource Brush.Warning}" FontWeight="SemiBold" Text="Recovery operation"/><TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="This invokes the independently maintained community updater’s recovery operation to restore the original GL.iNet firmware Tailscale binaries. Tailscale configuration files are NOT restored. Existing configuration may be incompatible, Tailscale may fail to start, and remote connectivity may be lost. Do not continue if Tailscale is your only path to this router; firmware recovery or reinstallation may ultimately be required."/><TextBox Margin="0,10,0,0" IsReadOnly="True" Text="{x:Static services:TailscaleUpdaterCommand.RestoreCommand}" TextWrapping="Wrap"/><CheckBox x:Name="Acknowledgement" Margin="0,12,0,0" Content="I understand that restoring the firmware Tailscale binaries does not restore the Tailscale configuration and may break Tailscale connectivity." Checked="AcknowledgementChanged" Unchecked="AcknowledgementChanged"/></StackPanel>
        </Border>
        <TextBlock Margin="0,12,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap" Text="The interactive updater will ask for its own confirmation. Opening the terminal does not prove that restoration succeeded; refresh Tailscale status afterward."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button MinWidth="90" Content="Cancel" IsCancel="True"/><Button x:Name="OpenButton" MinWidth="176" Margin="8,0,0,0" Style="{DynamicResource Button.Danger}" Content="Open restore terminal" IsEnabled="False" Click="Open_Click"/></StackPanel>
    </StackPanel>
</Window>
