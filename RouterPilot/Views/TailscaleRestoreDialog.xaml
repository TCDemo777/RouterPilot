<Window x:Class="RouterPilot.Views.TailscaleRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:RouterPilot.Services"
        Title="Restore firmware Tailscale binaries" Width="620" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}" Foreground="{DynamicResource Brush.TextPrimary}">
    <StackPanel Margin="22">
        <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Restore firmware Tailscale binaries"/>
        <Border Margin="0,16,0,0" Padding="12" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="6">
            <StackPanel><TextBlock Foreground="{DynamicResource Brush.Warning}" FontWeight="SemiBold" Text="Recovery operation"/><TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="This opens the community updater’s restore operation to restore the Tailscale binaries supplied by the router firmware. Tailscale configuration files are NOT restored. The resulting binaries and existing configuration may not be compatible, and Tailscale may require repair or reconfiguration afterward."/><TextBox Margin="0,10,0,0" IsReadOnly="True" Text="{x:Static services:TailscaleUpdaterCommand.RestoreCommand}" TextWrapping="Wrap"/></StackPanel>
        </Border>
        <TextBlock Margin="0,12,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap" Text="The interactive updater will ask for its own confirmation. Opening the terminal does not prove that restoration succeeded; refresh Tailscale status afterward."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button MinWidth="90" Content="Cancel" IsCancel="True"/><Button MinWidth="176" Margin="8,0,0,0" Style="{DynamicResource Button.Danger}" Content="Open restore terminal" Click="Open_Click"/></StackPanel>
    </StackPanel>
</Window>
