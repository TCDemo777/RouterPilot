<Window x:Class="RouterPilot.Views.RouterProfileEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:RouterPilot.Models" Title="Router" Width="540" Height="650" WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.WindowBackground}"><ScrollViewer><StackPanel Margin="24"><TextBlock Style="{DynamicResource Text.PageTitle}" Text="Router configuration"/><TextBlock Style="{DynamicResource Text.Secondary}" Margin="0,4,0,18" Text="Connection and SSH settings are saved for this router only."/><TextBlock Text="Display name"/><TextBox x:Name="NameBox" Margin="0,4,0,12"/><TextBlock Text="Router host or IP"/><TextBox x:Name="HostBox" Margin="0,4,0,12"/><TextBlock Text="Router username"/><TextBox x:Name="UserBox" Margin="0,4,0,12"/><TextBlock Text="SSH port"/><TextBox x:Name="PortBox" Margin="0,4,0,12"/><TextBlock Text="SSH authentication"/><ComboBox x:Name="AuthBox" Margin="0,4,0,12" SelectedValuePath="Tag"><ComboBoxItem Content="Password" Tag="{x:Static models:SshAuthenticationMethod.Password}"/><ComboBoxItem Content="Private Key" Tag="{x:Static models:SshAuthenticationMethod.PrivateKey}"/></ComboBox><StackPanel x:Name="PasswordPanel"><TextBlock Text="Password"/><PasswordBox x:Name="PasswordBox" Margin="0,4,0,12"/></StackPanel><StackPanel x:Name="KeyPanel"><TextBlock Text="Private key path"/><Grid Margin="0,4,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="KeyBox"/><Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Click="Browse_Click"/></Grid><TextBlock Text="Key passphrase (optional)"/><PasswordBox x:Name="PassphraseBox" Margin="0,4,0,12"/></StackPanel><CheckBox x:Name="AdGuardHttps" Content="Use HTTPS for AdGuard Home" Margin="0,2,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Save" Click="Save_Click" Style="{DynamicResource Button.Primary}"/><Button Content="Cancel" Margin="8,0,0,0" Click="Cancel_Click" Style="{DynamicResource Button.Secondary}"/></StackPanel></StackPanel></ScrollViewer></Window>
