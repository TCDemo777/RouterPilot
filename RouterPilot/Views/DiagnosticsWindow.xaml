<Window x:Class="RouterPilot.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Router Tools"
        Height="720"
        Width="980"
        MinHeight="620"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Router Tools"
                       FontSize="28"
                       FontWeight="Bold"/>
            <TextBlock Margin="0,6,0,0"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="Run network checks from the Flint 2 router and inspect AdGuard Home."/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,16"
                Padding="16"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TargetBox"
                         Height="38"
                         Margin="0,0,12,0"
                         Padding="10,7"
                         VerticalContentAlignment="Center"
                         Text="1.1.1.1"
                         ToolTip="Hostname or IP address"/>

                <Button Grid.Column="1"
                        Width="105"
                        Height="38"
                        Margin="0,0,8,0"
                        Style="{DynamicResource Button.Secondary}"
                        Content="Ping"
                        Click="PingButton_Click"/>

                <Button Grid.Column="2"
                        Width="105"
                        Height="38"
                        Margin="0,0,8,0"
                        Style="{DynamicResource Button.Secondary}"
                        Content="Traceroute"
                        Click="TracerouteButton_Click"/>

                <Button Grid.Column="3"
                        Width="105"
                        Height="38"
                        Style="{DynamicResource Button.Primary}"
                        Content="DNS lookup"
                        Click="DnsLookupButton_Click"/>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,0,0,16">
            <Button x:Name="RouterInfoButton"
                    Width="140" Height="36" Margin="0,0,10,10"
                    Content="Router Info" Click="RouterInfoButton_Click"/>
            <Button x:Name="AdGuardStatusButton"
                    Width="140" Height="36" Margin="0,0,10,10"
                    Content="AdGuard Status" Click="AdGuardStatusButton_Click"/>
            <Button x:Name="LogsButton"
                    Width="140" Height="36" Margin="0,0,10,10"
                    Content="AdGuard Logs" Click="LogsButton_Click"/>
            <Button x:Name="RestartButton"
                    Width="140" Height="36" Margin="0,0,10,10"
                    Content="Restart AdGuard" Click="RestartButton_Click"/>
            <Button x:Name="RefreshButton"
                    Width="140" Height="36" Margin="0,0,10,10"
                    Content="Test Login" Click="RefreshButton_Click"/>
            <Button x:Name="FreshnessButton"
                    Width="140" Height="36" Margin="0,0,10,10"
                    Content="Data Freshness" Click="FreshnessButton_Click"/>
        </WrapPanel>

        <Border Grid.Row="3"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <TextBox x:Name="OutputBox"
                     Padding="16"
                     FontFamily="Consolas"
                     FontSize="13"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</Window>
