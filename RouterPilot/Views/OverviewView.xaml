<UserControl
    x:Class="RouterPilot.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RouterPilot.Controls"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <UserControl.Resources>
        <Style x:Key="Overview.DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Overview.DetailValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="Overview.DetailRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="Overview.ProgressBar" TargetType="ProgressBar" BasedOn="{StaticResource Leaderboard.Track}">
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>

        <Style x:Key="Overview.StatusBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style x:Key="Overview.CardHeading" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionTitle}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource Page.Content}">

            <!-- Page heading -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        Style="{StaticResource Text.PageTitle}"
                        Text="Overview" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="Router, AdGuard Home and internet health at a glance" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="24,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource Text.CardCaption}"
                        Text="LAST REFRESH" />
                    <TextBlock
                        Margin="0,3,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding LastRefresh}" />
                </StackPanel>
            </Grid>

            <!-- Health summary -->
            <Border Margin="0,0,0,20" Style="{StaticResource Card}">
            <StackPanel>
            <TextBlock Margin="0,0,0,16" Style="{StaticResource Text.SectionTitle}" Text="System health" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:StatisticCard
                    Grid.Column="0"
                    Height="146"
                    UseCompactStatusValue="True"
                    AccentBrush="{Binding RouterStatusColour}"
                    ValueForeground="{Binding RouterStatusColour}"
                    FooterText="{Binding RouterModel}"
                    IconBackground="{DynamicResource Brush.PrimarySubtle}"
                    IconGlyph="&#xE968;"
                    Subtitle="Router connection"
                    Title="ROUTER"
                    Value="{Binding RouterStatusText}" />

                <controls:StatisticCard
                    Grid.Column="2"
                    Height="146"
                    UseCompactStatusValue="True"
                    AccentBrush="{Binding AdGuardStatusColour}"
                    ValueForeground="{Binding AdGuardStatusColour}"
                    IconBackground="{DynamicResource Brush.SuccessSubtle}"
                    IconGlyph="&#xE72E;"
                    Subtitle="{Binding AdGuardStatusSubtitle}"
                    Title="ADGUARD"
                    Value="{Binding AdGuardStatusText}" />

                <controls:StatisticCard
                    Grid.Column="4"
                    Height="146"
                    UseCompactStatusValue="True"
                    AccentBrush="{Binding InternetStatusColour}"
                    ValueForeground="{Binding InternetStatusColour}"
                    FooterText="{Binding Latency}"
                    IconBackground="{DynamicResource Brush.PrimarySubtle}"
                    IconGlyph="&#xE774;"
                    Subtitle="WAN connectivity"
                    Title="INTERNET"
                    Value="{Binding InternetStatusText}" />

                <controls:StatisticCard
                    Grid.Column="6"
                    Height="146"
                    AccentBrush="{Binding CpuHealthColour}"
                    FooterText="{Binding CpuHealthText}"
                    IconBackground="{DynamicResource Brush.WarningSubtle}"
                    IconGlyph="&#xE950;"
                    Subtitle="Processor utilisation"
                    Title="CPU"
                    ValueForeground="{Binding CpuHealthColour}"
                    Value="{Binding CpuUsageDisplay}" />

                <controls:StatisticCard
                    Grid.Column="8"
                    Height="146"
                    AccentBrush="{Binding MemoryHealthColour}"
                    FooterText="{Binding MemoryUsage}"
                    IconBackground="{DynamicResource Brush.PrimarySubtle}"
                    IconGlyph="&#xE7F8;"
                    Subtitle="Memory usage"
                    Title="MEMORY"
                    ValueForeground="{Binding MemoryHealthColour}"
                    Value="{Binding MemoryUsage}" />
            </Grid>
            </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Router Health"/><TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding RouterHealthSummary}"/></StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock HorizontalAlignment="Right" FontSize="22" FontWeight="SemiBold" Foreground="{Binding RouterHealthColour}" Text="{Binding RouterHealthState}"/><TextBlock HorizontalAlignment="Right" Style="{DynamicResource Text.Muted}" Text="{Binding RouterHealthScore, StringFormat={}{0}%}"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="NEEDS ATTENTION"/>
                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding RouterHealthAttentionText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="HEALTHY"/>
                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding RouterHealthHealthyText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Main details -->
            <Border x:Name="SystemDetailsSection" Margin="0,0,0,20" Style="{StaticResource Card}">
            <StackPanel>
            <TextBlock x:Name="SystemDetailsHeading" Margin="0,0,0,16" Style="{StaticResource Text.SectionTitle}" Text="System details" />
            <Grid x:Name="DashboardDetailsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="RouterDashboardCard"
                    Grid.Row="0"
                    Grid.Column="0"
                    MinHeight="350"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="38"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource Brush.PrimarySubtle}"
                                    CornerRadius="10">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="18"
                                        Foreground="{StaticResource Brush.Primary}"
                                        Text="&#xE968;" />
                                </Border>
                                <TextBlock
                                    Style="{StaticResource Overview.CardHeading}"
                                    Text="Router" />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource Overview.StatusBadge}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding RouterStatusColour}"
                                    Text="{Binding RouterStatusText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Model" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding RouterModel}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="OpenWrt snapshot" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding FirmwareVersion}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Router firmware" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding RouterFirmwareVersion}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Hostname" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding Hostname}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Uptime" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding Uptime}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Last reboot" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding RouterLastRebootEstimate}" ToolTip="Estimated from the current router uptime." />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Temperature" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding Temperature}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Load average" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding LoadAverage}" />
                            </Grid>

                            <Separator />

                            <StackPanel Margin="0,2,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="CPU usage" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding CpuUsageDisplay}" />
                                </Grid>
                                <ProgressBar
                                    Style="{StaticResource Overview.ProgressBar}"
                                    Value="{Binding CpuPercentage}" />
                                <TextBlock Margin="0,7,0,0"
                                           Style="{StaticResource Overview.DetailLabel}"
                                           Text="CPU history" />
                                <lvc:CartesianChart Height="42"
                                                    Margin="0,3,0,0"
                                                    Background="Transparent"
                                                    AnimationsSpeed="0:0:0.2"
                                                    Series="{Binding CpuSparklineSeries}"
                                                    XAxes="{Binding SparklineXAxes}"
                                                    YAxes="{Binding SparklineYAxes}" />
                            </StackPanel>

                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Memory usage" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding MemoryUsage}" />
                                </Grid>
                                <ProgressBar
                                    Style="{StaticResource Overview.ProgressBar}"
                                    Value="{Binding MemoryPercentage}" />
                                <TextBlock Margin="0,7,0,0"
                                           Style="{StaticResource Overview.DetailLabel}"
                                           Text="Memory history" />
                                <lvc:CartesianChart Height="42"
                                                    Margin="0,3,0,0"
                                                    Background="Transparent"
                                                    AnimationsSpeed="0:0:0.2"
                                                    Series="{Binding MemorySparklineSeries}"
                                                    XAxes="{Binding SparklineXAxes}"
                                                    YAxes="{Binding SparklineYAxes}" />

                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Muted}" Text="Used" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,18,0"
                                        Style="{StaticResource Overview.DetailValue}"
                                        Text="{Binding MemoryUsed}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource Text.Muted}"
                                        Text="{Binding MemoryCache, StringFormat=Cache: {0}}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="AdGuardDashboardCard"
                    Grid.Row="0"
                    Grid.Column="2"
                    MinHeight="350"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="38"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource Brush.SuccessSubtle}"
                                    CornerRadius="10">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="18"
                                        Foreground="{StaticResource Brush.Success}"
                                        Text="&#xE72E;" />
                                </Border>
                                <TextBlock
                                    Style="{StaticResource Overview.CardHeading}"
                                    Text="AdGuard Home" />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource Overview.StatusBadge}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding AdGuardStatusColour}"
                                    Text="{Binding AdGuardStatusText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Protection" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Overview.DetailValue}"
                                    Foreground="{Binding AdGuardProtectionStatusColour}"
                                    Text="{Binding AdGuardProtectionStatusText}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Version" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Overview.DetailValue}"
                                    Text="{Binding AdGuardVersionDisplay}"
                                    ToolTip="{Binding AdGuardVersionDisplay}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Service" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding AdGuardServiceDisplay}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Process" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Overview.DetailValue}"
                                    Text="{Binding AdGuardProcess}"
                                    ToolTip="{Binding AdGuardProcess}" />
                            </Grid>

                            <Separator />

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Queries" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding AdGuardQueriesDisplay}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Blocked" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Overview.DetailValue}"
                                    Foreground="{StaticResource Brush.Danger}"
                                    Text="{Binding AdGuardBlockedDisplay}" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Blocking rate" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding AdGuardBlockRateDisplay}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="InternetDashboardCard"
                    Grid.Row="2"
                    Grid.Column="0"
                    MinHeight="350"
                    Margin="0"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="38"
                                    Height="38"
                                    Margin="0,0,12,0"
                                    Background="{DynamicResource Brush.PrimarySubtle}"
                                    CornerRadius="10">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="18"
                                        Foreground="{StaticResource Brush.Primary}"
                                        Text="&#xE774;" />
                                </Border>
                                <TextBlock
                                    Style="{StaticResource Overview.CardHeading}"
                                    Text="Internet" />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Style="{StaticResource Overview.StatusBadge}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding InternetStatusColour}"
                                    Text="{Binding InternetStatusText}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Physical WAN address" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding WanIp}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}"
                                  Visibility="{Binding IsVpnConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="VPN" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding VpnContextLine}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Gateway" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding Gateway}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="External DNS" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource Overview.DetailValue}"
                                    Text="{Binding ExternalDns}"
                                    ToolTip="{Binding ExternalDns}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Advertised DNS" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding AdvertisedDns}" />
                            </Grid>

                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource Text.Muted}"
                                       Text="{Binding VpnDnsContext}"
                                       Visibility="{Binding IsVpnConnected, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Latency" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding Latency}" />
                            </Grid>

                            <Grid Style="{StaticResource Overview.DetailRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="VPN overlay" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding VpnNetworkSummary}" />
                            </Grid>

                            <Separator />

                            <StackPanel Margin="0,2,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Storage" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding StorageUsage}" />
                                </Grid>
                                <ProgressBar
                                    Style="{StaticResource Overview.ProgressBar}"
                                    Value="{Binding StoragePercentage}" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Available storage" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding StorageAvailable}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="VpnDashboardCard"
                    Grid.Row="2"
                    Grid.Column="2"
                    MinHeight="350"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="38" Height="38" Margin="0,0,12,0" Background="{DynamicResource Brush.PrimarySubtle}" CornerRadius="10">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Brush.Primary}" Text="&#xE774;" />
                                </Border>
                                <TextBlock Style="{StaticResource Overview.CardHeading}" Text="VPN" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Overview.StatusBadge}">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding VpnStatusColour}" Text="{Binding VpnStatusText}" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="2">
                            <Grid Style="{StaticResource Overview.DetailRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Tunnel"/><TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding VpnSummary.TunnelName}"/></Grid>
                            <Grid Style="{StaticResource Overview.DetailRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Protocol"/><TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding VpnProtocolDisplay}"/></Grid>
                            <Grid Style="{StaticResource Overview.DetailRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Profile"/><TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding VpnSummary.ProfileName}"/></Grid>
                            <Grid Style="{StaticResource Overview.DetailRow}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Location"/><TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding VpnSummary.Location}"/></Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource Overview.DetailLabel}" Text="Virtual IP"/><TextBlock Grid.Column="1" Style="{StaticResource Overview.DetailValue}" Text="{Binding VpnSummary.VirtualIp}"/></Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            </StackPanel>
            </Border>

            <Border Margin="0,0,0,20" Style="{StaticResource Card}">
                <StackPanel>
                <TextBlock Margin="0,0,0,16" Style="{StaticResource Text.SectionTitle}" Text="Quick actions" />
                <WrapPanel>
                    <Button x:Name="RefreshQuickAction" Margin="0,0,10,10" Width="152" Height="36" Style="{DynamicResource Button.Primary}"
                            Tag="RefreshAll" Content="Refresh" ToolTip="Refresh all current RouterPilot data" AutomationProperties.Name="Refresh all data" Click="QuickAction_Click" />
                    <Button x:Name="RestartAdGuardQuickAction" Margin="0,0,10,10" Width="152" Height="36" Style="{DynamicResource Button.Secondary}"
                            Tag="RestartAdGuard" Content="Restart AdGuard" ToolTip="Restart AdGuard Home" AutomationProperties.Name="Restart AdGuard Home" Click="QuickAction_Click" />
                    <Button x:Name="RestartWifiQuickAction" Margin="0,0,10,10" Width="152" Height="36" Style="{DynamicResource Button.Secondary}"
                            Tag="RestartWifi" Content="Restart Wi-Fi" ToolTip="Restart router wireless interfaces" AutomationProperties.Name="Restart Wi-Fi" Click="QuickAction_Click" />
                    <Button x:Name="BackupQuickAction" Margin="0,0,10,10" Width="152" Height="36" Style="{DynamicResource Button.Secondary}"
                            Tag="CreateBackup" Content="Create Backup" ToolTip="Create a RouterPilot backup package" AutomationProperties.Name="Create Backup" Click="QuickAction_Click" />
                    <Button x:Name="RouterUiQuickAction" Margin="0,0,10,10" Width="152" Height="36" Style="{DynamicResource Button.Secondary}"
                            Tag="OpenRouter" Content="Open Router UI" ToolTip="Open the configured router interface" AutomationProperties.Name="Open Router UI" Click="QuickAction_Click" />
                </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
