<UserControl x:Class="RouterPilot.Views.NotificationCentreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.WindowBackground}"
             Foreground="{DynamicResource Brush.TextPrimary}">
    <UserControl.Resources>
        <Style x:Key="Notification.Card" TargetType="Border" BasedOn="{StaticResource Card.Compact}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRead}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Brush.PrimarySubtle}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{DynamicResource Text.PageTitle}"
                           Text="Notification Centre"/>
                <TextBlock Margin="0,5,0,0"
                           Style="{DynamicResource Text.Secondary}"
                           Text="Important RouterPilot router and network events."/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox Width="130"
                          Style="{StaticResource RouterPilot.ComboBox}"
                          Margin="0,0,10,0"
                          ItemsSource="{Binding Filters}"
                          SelectedItem="{Binding SelectedFilter}"/>
                <Button Margin="0,0,8,0"
                        Style="{DynamicResource Button.Secondary}"
                        Command="{Binding MarkAllReadCommand}"
                        Content="Mark all read"/>
                <Button Style="{DynamicResource Button.Secondary}"
                        Command="{Binding ClearAllCommand}"
                        Content="Clear all"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SectionContainerStyle}" Margin="0">
        <Grid>
            <ListBox ItemsSource="{Binding NotificationsView}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Notification.Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}"/>
                                        <Border Margin="8,0,0,0">
                                            <TextBlock FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Primary}"
                                                       Text="UNREAD"/>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Information}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Margin="0,6,0,0"
                                               Style="{DynamicResource Text.Body}"
                                               Text="{Binding Message}"/>

                                    <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                        <TextBlock Style="{DynamicResource Text.Muted}"
                                                   Text="{Binding TimestampDisplay}"/>
                                        <TextBlock Margin="9,0" Style="{DynamicResource Text.Muted}" Text="•"/>
                                        <TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding Severity}"/>
                                        <TextBlock Margin="9,0" Style="{DynamicResource Text.Muted}" Text="•"/>
                                        <TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding Category}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="16,0,0,0">
                                    <Button MinWidth="92"
                                            Margin="0,0,0,7"
                                            Content="View device"
                                            Click="ViewDevice_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanViewDevice}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button MinWidth="92"
                                            Margin="0,0,0,7"
                                            Command="{Binding DataContext.MarkReadCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="Mark read">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button MinWidth="92"
                                            Style="{DynamicResource Button.Secondary}"
                                            Command="{Binding DataContext.RemoveCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="Remove"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Padding" Value="32"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NotificationsView.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Style="{StaticResource EmptyState}">
                    <TextBlock Style="{StaticResource Icon.EmptyState}"
                               Text="&#xE7ED;"/>
                    <TextBlock Margin="0,14,0,0"
                               Style="{StaticResource Text.EmptyStateTitle}"
                               Text="No notifications"/>
                    <TextBlock Style="{StaticResource Text.EmptyStateMessage}"
                               Text="RouterPilot events will appear here."/>
                </StackPanel>
            </Border>
        </Grid>
        </Border>
    </Grid>
</UserControl>
