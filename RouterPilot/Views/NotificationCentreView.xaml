<UserControl x:Class="RouterPilot.Views.NotificationCentreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.WindowBackground}"
             Foreground="{DynamicResource Brush.TextPrimary}">
    <UserControl.Resources>
        <Style x:Key="Notification.Card" TargetType="Border" BasedOn="{StaticResource Card.Compact}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRead}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Brush.PrimarySubtle}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{DynamicResource Text.PageTitle}"
                           Text="Notification Centre"/>
                <TextBlock Margin="0,5,0,0"
                           Style="{DynamicResource Text.Secondary}"
                           Text="Meaningful router, device and maintenance events. Network Health and Activity remain the detailed sources."/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox Width="130" Height="38"
                          Style="{StaticResource RouterPilot.ComboBox}"
                          Margin="0,0,10,0"
                          ItemsSource="{Binding Filters}"
                          SelectedItem="{Binding SelectedFilter}"/>
                <Button Height="38" Margin="0,0,8,0"
                        Style="{DynamicResource Button.Secondary}"
                        Command="{Binding MarkAllReadCommand}"
                        Content="Mark all read"/>
                <Button Height="38" Style="{DynamicResource Button.Secondary}"
                        Command="{Binding ClearAllCommand}"
                        Content="Clear all"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{DynamicResource Card.Compact}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.CardCaption}" Text="RECENT ACTIVITY"/>
                    <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding RecentActivitySummary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Secondary}" Text="Notifications are shown only for accepted RouterPilot events; this is not a separate health score." TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="2" Padding="12,8" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.SurfaceMuted}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.CardCaption}" Text="ATTENTION"/>
                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding AttentionSummary}" TextWrapping="Wrap" MaxWidth="190"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SectionContainerStyle}" Margin="0">
        <Grid>
            <ListBox ItemsSource="{Binding NotificationsView}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Notification.Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Primary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Success}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}"/>
                                        <Border Margin="8,0,0,0">
                                            <TextBlock FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Primary}"
                                                       Text="UNREAD"/>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Information}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Margin="0,6,0,0"
                                               Style="{DynamicResource Text.Body}"
                                               Text="{Binding Message}"/>

                                    <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                                        <TextBlock Style="{DynamicResource Text.Muted}"
                                                   Text="{Binding TimestampDisplay}"/>
                                        <TextBlock Margin="9,0" Style="{DynamicResource Text.Muted}" Text="•"/>
                                        <TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding Severity}"/>
                                        <TextBlock Margin="9,0" Style="{DynamicResource Text.Muted}" Text="•"/>
                                        <TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding Category}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="16,0,0,0">
                                    <Button MinWidth="92"
                                            Margin="0,0,0,7"
                                            Content="View device"
                                            Click="ViewDevice_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanViewDevice}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button MinWidth="92"
                                            Margin="0,0,0,7"
                                            Command="{Binding DataContext.MarkReadCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="Mark read">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button MinWidth="92"
                                            Style="{DynamicResource Button.Secondary}"
                                            Command="{Binding DataContext.RemoveCommand,
                                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="Remove"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Padding" Value="32"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NotificationsView.IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Style="{StaticResource EmptyState}">
                    <TextBlock Style="{StaticResource Icon.EmptyState}"
                               Text="&#xE7ED;"/>
                    <TextBlock Margin="0,14,0,0"
                               Style="{StaticResource Text.EmptyStateTitle}"
                               Text="Nothing to show"/>
                    <TextBlock Style="{StaticResource Text.EmptyStateMessage}"
                               Text="{Binding FilterEmptyMessage}"/>
                </StackPanel>
            </Border>
        </Grid>
        </Border>
    </Grid>
</UserControl>
