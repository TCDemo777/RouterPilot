<Window x:Class="RouterPilot.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RouterPilot.Views"
        Title="RouterPilot"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.WindowBackground}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        </Style>

        <Style x:Key="SidebarNavigationButton"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="10,1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#D7DCE2"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1">
            <Image Width="44" Height="44" Margin="14,6" HorizontalAlignment="Left" Stretch="Uniform" Source="/Assets/RouterPilotLogo.png"/>
        </Border>

        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Text="RouterPilot"/>
                <TextBlock x:Name="HeaderVersion" Grid.Column="1" Margin="10,2,0,0" VerticalAlignment="Center" FontSize="11" Style="{DynamicResource Text.Muted}"/>
                <TextBlock Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding RouterModel}" Text="{Binding RouterModel}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Background="#20262E"
                BorderBrush="#15191E"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="14,14,14,8"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Text="NAVIGATION"/>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Margin="18,8,0,4" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="MONITORING"/>
                    <Button x:Name="OverviewButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Background="#35404D"
                            Foreground="White"
                            Content="Overview"
                            Click="Overview_Click"/>

                    <Button x:Name="ProtectionButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Background="Transparent"
                            Content="Protection"
                            Click="Protection_Click"/>

                    <Button x:Name="AnalyticsButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Background="Transparent"
                            Content="Analytics"
                            Click="Analytics_Click"/>

                    <Button x:Name="NetworkButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Background="Transparent"
                            Content="Network"
                            Click="Network_Click"/>

                    <Button x:Name="RouterButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Background="Transparent"
                            Content="Router"
                            Click="Router_Click"/>

                    <TextBlock Margin="18,12,0,4" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="OPERATIONS"/>

                    <Button x:Name="MaintenanceButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Background="Transparent"
                            Content="Maintenance"
                            Click="Maintenance_Click"/>

                    <Button x:Name="ClientsButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Background="Transparent"
                            Content="Clients"
                            Click="Clients_Click"/>

                    <Button x:Name="LogsButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Background="Transparent"
                            Content="DNS Activity"
                            Click="Logs_Click"/>

                    <Button x:Name="NotificationButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            Click="Notification_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Notifications"/>
                            <Border Grid.Column="1"
                                    MinWidth="28"
                                    Padding="6,2"
                                    Background="{DynamicResource Brush.Danger}"
                                    CornerRadius="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnreadCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Text="{Binding UnreadCount}"/>
                            </Border>
                        </Grid>
                    </Button>


                    <Button x:Name="SearchButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Background="Transparent"
                            Content="Search"
                            Click="Search_Click"/>

                    <Button x:Name="NavigationSettingsButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Background="Transparent"
                            Content="Settings"
                            Click="NavigationSettings_Click"/>

                    <Button x:Name="TimelineButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            Click="Timeline_Click">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Logs"/>
                            <Border Grid.Column="1" MinWidth="22" Padding="5,1" Background="{DynamicResource Brush.Primary}" CornerRadius="9">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding UnreadCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock HorizontalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="White" Text="{Binding UnreadCount}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <Button x:Name="AboutButton"
                            Style="{StaticResource SidebarNavigationButton}"
                            Background="Transparent"
                            Content="About"
                            Click="About_Click"/>

                </StackPanel>
                </ScrollViewer>

            </Grid>
        </Border>

        <ContentControl x:Name="PageContent"
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch"
                         ClipToBounds="True" />

        <Border Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StatusPill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{Binding RouterStatusColour}"/>
                                <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" Text="Router "/>
                                <TextBlock FontWeight="SemiBold" Foreground="{Binding RouterStatusColour}" Text="{Binding RouterStatusText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusPill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{Binding InternetStatusColour}"/>
                                <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" Text="Internet "/>
                                <TextBlock FontWeight="SemiBold" Foreground="{Binding InternetStatusColour}" Text="{Binding InternetStatusText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusPill}" MaxWidth="220">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{Binding VpnStatusColour}"/>
                                <TextBlock MaxWidth="190" FontWeight="SemiBold" Foreground="{Binding VpnStatusColour}" Text="{Binding VpnCompactFooterStatusText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding VpnCompactFooterStatusText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusPill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" Fill="{Binding AdGuardStatusColour}"/>
                                <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" Text="AdGuard "/>
                                <TextBlock FontWeight="SemiBold" Foreground="{Binding AdGuardStatusColour}" Text="{Binding AdGuardStatusText}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatusPill}">
                            <TextBlock Foreground="{DynamicResource Brush.TextSecondary}">
                                <Run Text="CPU "/>
                                <Run FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding CpuUsage}"/>
                            </TextBlock>
                        </Border>

                        <Border Style="{StaticResource StatusPill}">
                            <TextBlock Foreground="{DynamicResource Brush.TextSecondary}">
                                <Run Text="RAM "/>
                                <Run FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding MemoryUsage}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{Binding DataFreshnessColour}"
                               FontSize="11"
                               Text="{Binding DataFreshnessFooter}"/>
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="11"
                               Text="{Binding LastRefresh}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
