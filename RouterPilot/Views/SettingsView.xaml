<UserControl x:Class="RouterPilot.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RouterPilot.Models"
             Background="{DynamicResource Brush.WindowBackground}"
             Foreground="{DynamicResource Brush.TextPrimary}">
    <UserControl.Resources>
        <Style x:Key="Settings.FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
        </Style>
        <Style x:Key="Settings.Input" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Settings.SectionNote" TargetType="Border">
            <Setter Property="Margin" Value="0,18,0,0"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="24,24,24,0">
            <TextBlock Style="{DynamicResource Text.PageTitle}" Text="Settings"/>
            <TextBlock Margin="0,5,0,0"
                       Style="{DynamicResource Text.Secondary}"
                       Text="Application behaviour, router credentials and AdGuard Home defaults."/>
            <Button Margin="0,14,0,4" HorizontalAlignment="Left" Style="{DynamicResource Button.Secondary}"
                    Content="Manage saved routers" Click="ManageRouters_Click"/>
        </StackPanel>

        <TabControl Grid.Row="1" Margin="24,0,24,0" Style="{StaticResource RouterPilotTabControlStyle}" ItemContainerStyle="{StaticResource RouterPilotTabItemStyle}" SelectionChanged="SettingsTabs_SelectionChanged">
            <TabItem Header="General" Tag="General" />
            <TabItem Header="Router &amp; Connections" Tag="Router" />
            <TabItem Header="Notifications &amp; Refresh" Tag="Notifications" />
            <TabItem Header="Advanced" Tag="Advanced" />
        </TabControl>

        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,24" HorizontalAlignment="Left" MaxWidth="1100">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="RouterSettingsSection" Grid.Column="0">
                        <TextBlock Margin="0,0,0,12" Style="{DynamicResource Text.SectionTitle}" Text="Router" />
                        <Border Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Router connection"/>
                                <TextBlock Margin="0,5,0,18" Style="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="Router login details and SSH transport settings. The router login password remains protected for GL.iNet router management."/>

                                <TextBlock Style="{StaticResource Settings.FieldLabel}"
                                           Text="ROUTER IP ADDRESS OR HOSTNAME"/>
                                <TextBox Style="{StaticResource Settings.Input}"
                                         Text="{Binding RouterIp, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Margin="0,16,0,7" Style="{StaticResource Settings.FieldLabel}"
                                           Text="SSH USERNAME"/>
                                <TextBox Style="{StaticResource Settings.Input}"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Margin="0,16,0,7" Style="{StaticResource Settings.FieldLabel}"
                                            Text="ROUTER LOGIN PASSWORD"/>
                                <Grid>
                                    <PasswordBox x:Name="PasswordInput"
                                                 Height="38"
                                                 Padding="10,6"
                                                 VerticalContentAlignment="Center"
                                                 Background="{DynamicResource Brush.Surface}"
                                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                                 BorderBrush="{DynamicResource Brush.BorderStrong}"
                                                 BorderThickness="1"
                                                 PasswordChanged="PasswordInput_PasswordChanged"/>
                                    <TextBox x:Name="PasswordTextInput"
                                             Style="{StaticResource Settings.Input}"
                                             Visibility="Collapsed"
                                             Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>

                                 <StackPanel Margin="0,13,0,0">
                                    <CheckBox x:Name="ShowPasswordCheckBox"
                                              Content="Show password"
                                              Checked="ShowPasswordCheckBox_Changed"
                                              Unchecked="ShowPasswordCheckBox_Changed"/>
                                    <CheckBox Margin="0,10,0,0"
                                              Content="Remember password securely for this Windows user"
                                              IsChecked="{Binding RememberPassword}"/>
                                 </StackPanel>

                                <TextBlock Margin="0,18,0,7" Style="{StaticResource Settings.FieldLabel}"
                                           Text="SSH PORT"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource Settings.Input}"
                                             Text="{Binding SshPort, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Style="{DynamicResource Text.Secondary}"
                                               Text="1–65,535 (default 22)"/>
                                </Grid>

                                <TextBlock Margin="0,18,0,7" Style="{StaticResource Settings.FieldLabel}"
                                           Text="SSH AUTHENTICATION"/>
                                <ComboBox Height="38"
                                          Style="{StaticResource RouterPilot.ComboBox}"
                                          SelectedValue="{Binding SshAuthenticationMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Password" Tag="{x:Static models:SshAuthenticationMethod.Password}"/>
                                    <ComboBoxItem Content="Private Key" Tag="{x:Static models:SshAuthenticationMethod.PrivateKey}"/>
                                </ComboBox>

                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="SSH uses the protected router login password above."/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrivateKeyAuthentication}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Margin="0,14,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrivateKeyAuthentication}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Style="{StaticResource Settings.FieldLabel}" Text="PRIVATE KEY"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource Settings.Input}"
                                                 Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="2"
                                                Style="{DynamicResource Button.Secondary}"
                                                Content="Browse…"
                                                Click="BrowsePrivateKey_Click"/>
                                    </Grid>
                                    <TextBlock Margin="0,14,0,7" Style="{StaticResource Settings.FieldLabel}" Text="KEY PASSPHRASE (OPTIONAL)"/>
                                    <PasswordBox x:Name="PrivateKeyPassphraseInput"
                                                 Height="38"
                                                 Padding="10,6"
                                                 VerticalContentAlignment="Center"
                                                 Background="{DynamicResource Brush.Surface}"
                                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                                 BorderBrush="{DynamicResource Brush.BorderStrong}"
                                                 BorderThickness="1"
                                                 PasswordChanged="PrivateKeyPassphraseInput_PasswordChanged"/>
                                    <TextBlock Margin="0,7,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                               Text="Select a user-managed SSH private-key file. The optional passphrase is protected with Windows Data Protection."/>
                                </StackPanel>

                                <Border Style="{StaticResource Settings.SectionNote}">
                                    <TextBlock Style="{DynamicResource Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Text="Saved passwords are protected with Windows Data Protection and can only be decrypted by the current Windows user."/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="GeneralSettingsHeader" Margin="0,0,0,12" Style="{DynamicResource Text.SectionTitle}" Text="General" />
                        <Border x:Name="GeneralSettingsSection" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Application"/>
                                <TextBlock Margin="0,5,0,18" Style="{DynamicResource Text.Secondary}"
                                           Text="Startup, appearance and dashboard refresh behaviour."/>

                                <CheckBox Content="Start RouterPilot with Windows"
                                          IsChecked="{Binding StartWithWindows}"/>

                                <TextBlock Margin="0,18,0,7" Style="{StaticResource Settings.FieldLabel}"
                                           Text="APPEARANCE"/>
                                <ComboBox Height="38"
                                          Style="{StaticResource RouterPilot.ComboBox}"
                                          SelectedValue="{Binding Theme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Follow Windows" Tag="System"/>
                                    <ComboBoxItem Content="Light" Tag="Light"/>
                                    <ComboBoxItem Content="Dark" Tag="Dark"/>
                                </ComboBox>

                                <TextBlock Margin="0,18,0,7" Style="{StaticResource Settings.FieldLabel}"
                                           Text="DASHBOARD REFRESH INTERVAL"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource Settings.Input}"
                                             Text="{Binding RefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Style="{DynamicResource Text.Secondary}"
                                               Text="seconds (5–3,600)"/>
                                </Grid>

                                <Border Style="{StaticResource Settings.SectionNote}">
                                    <TextBlock Style="{DynamicResource Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Text="Theme changes are applied immediately. Save to keep the selected appearance and startup preferences."/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AdGuardSettingsSection" Margin="0,16,0,0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="AdGuard Home"/>
                                <TextBlock Margin="0,8,0,0"
                                           Style="{DynamicResource Text.NotAvailable}"
                                           Text="{Binding AdGuardAvailability.DisplayText}"/>
                                <TextBlock Margin="0,5,0,18" Style="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="Defaults used by protection controls and background refresh."/>

                                <TextBlock Style="{StaticResource Settings.FieldLabel}"
                                           Text="CONTROL TRANSPORT"/>
                                <TextBlock Margin="0,5,0,0"
                                           Style="{DynamicResource Text.Secondary}"
                                           Text="{Binding AdGuardTransportStatus}"/>
                                <TextBlock Margin="0,3,0,0"
                                           Style="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           Text="{Binding AdGuardTransportDetail}"/>

                                <Border Margin="0,12,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border"
                                               BasedOn="{StaticResource Settings.SectionNote}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAdGuardHttpConfigured}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{DynamicResource Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Text="AdGuard Home control traffic is unencrypted on the local network."/>
                                </Border>

                                 <TextBlock Margin="0,18,0,0"
                                            Style="{StaticResource Settings.FieldLabel}"
                                            Text="DEFAULT PROTECTION PAUSE"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource Settings.Input}"
                                             Text="{Binding DefaultPauseMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                               Style="{DynamicResource Text.Secondary}"
                                               Text="minutes (1–1,440)"/>
                                 </Grid>

                                <TextBlock Margin="0,18,0,7"
                                           Style="{StaticResource Settings.FieldLabel}"
                                           Text="ROUTER HEALTH"/>
                                <CheckBox Content="Include AdGuard Home in Router Health"
                                          IsChecked="{Binding IncludeAdGuardHomeInRouterHealth, Mode=TwoWay}"/>
                                <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                                           Text="When enabled, AdGuard Home availability contributes to the overall Router Health status. Turn this off if you don't use AdGuard Home."/>

                                 <Border Style="{StaticResource Settings.SectionNote}">
                                    <TextBlock Style="{DynamicResource Text.Secondary}"
                                               TextWrapping="Wrap"
                                               Text="RouterPilot reaches AdGuard Home through the configured router connection. No separate API credentials are required."/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="NotificationsSettingsHeader" Margin="0,24,0,12" Style="{DynamicResource Text.SectionTitle}" Text="Notifications" />
                        <Border x:Name="NotificationsSettingsSection" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Notification Preferences"/>
                                <TextBlock Margin="0,5,0,14" Style="{DynamicResource Text.Secondary}"
                                           Text="Control Notification Centre entries. Quiet hours affect Windows toasts only."/>
                                <Border Margin="0,0,0,14" Padding="12" CornerRadius="8"
                                        Background="{DynamicResource Brush.SurfaceMuted}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="STORED ENTRIES"/>
                                            <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding StoredNotificationCount}"/>
                                            <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.CardCaption}" Text="MOST RECENT"/>
                                            <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding MostRecentNotificationTime}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="DELIVERY"/>
                                            <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Text="{Binding ActiveDeliveryChannels}"/>
                                            <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.CardCaption}" Text="QUIET HOURS"/>
                                            <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding QuietHoursStatus}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <CheckBox Content="Enable notifications" IsChecked="{Binding NotificationsEnabled}"/>
                                <CheckBox Margin="0,8,0,0" Content="Notification Centre entries" IsChecked="{Binding NotificationCentreEnabled}"/>
                                <CheckBox Margin="0,8,0,0" Content="Windows toast notifications" IsChecked="{Binding WindowsToastsEnabled}"/>
                                <CheckBox Margin="0,8,0,0" Content="Monitored device availability" IsChecked="{Binding MonitoredDeviceAvailabilityEnabled}" ToolTip="Notify when monitored devices remain offline beyond the existing grace period and when they return."/>
                                <TextBlock Margin="0,18,0,4" Style="{DynamicResource Text.CardCaption}" Text="EVENT CATEGORIES"/>
                                <TextBlock Margin="0,0,0,10" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                                           Text="Choose which RouterPilot events appear in Notifications."/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <CheckBox Content="Router &amp; WAN" IsChecked="{Binding RouterWanNotificationsEnabled}"/>
                                        <CheckBox Margin="0,8,0,0" Content="VPN" IsChecked="{Binding VpnNotificationsEnabled}"/>
                                        <CheckBox Margin="0,8,0,0" Content="Network Health" IsChecked="{Binding NetworkHealthNotificationsEnabled}"/>
                                        <CheckBox Margin="0,8,0,0" Content="Firmware" IsChecked="{Binding FirmwareNotificationsEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <CheckBox Content="AdGuard Home &amp; DNS" IsChecked="{Binding AdGuardNotificationsEnabled}"/>
                                        <CheckBox Margin="0,8,0,0" Content="Clients &amp; Devices" IsChecked="{Binding ClientNotificationsEnabled}"/>
                                        <CheckBox Margin="0,8,0,0" Content="Application Updates" IsChecked="{Binding ApplicationUpdateNotificationsEnabled}"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox Margin="0,8,0,0" Content="Enable quiet hours" IsChecked="{Binding QuietHoursEnabled}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="12"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource Settings.Input}" Text="{Binding QuietHoursStart, UpdateSourceTrigger=PropertyChanged}" ToolTip="Quiet hours start (HH:mm)"/>
                                    <TextBox Grid.Column="2" Style="{StaticResource Settings.Input}" Text="{Binding QuietHoursEnd, UpdateSourceTrigger=PropertyChanged}" ToolTip="Quiet hours end (HH:mm)"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border x:Name="DashboardSettingsSection" Margin="0,16,0,0" Style="{DynamicResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Dashboard"/>
                                <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}"
                                           Text="Choose which Overview cards are visible and set their display order."/>
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Top" Style="{DynamicResource Button.Secondary}"
                                    Content="Reset Dashboard" Click="ResetDashboard_Click"/>
                        </Grid>
                        <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding DashboardCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                            Background="{DynamicResource Brush.SurfaceMuted}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsVisible, Mode=TwoWay}"/>
                                            <TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                                                       Style="{DynamicResource Text.Body}" FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                            <Button Grid.Column="2" Width="34" Height="30" Padding="0"
                                                    Style="{DynamicResource Button.Secondary}" Content="↑"
                                                    ToolTip="Move card up"
                                                    Command="{Binding DataContext.MoveDashboardCardUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Grid.Column="4" Width="34" Height="30" Padding="0"
                                                    Style="{DynamicResource Button.Secondary}" Content="↓"
                                                    ToolTip="Move card down"
                                                    Command="{Binding DataContext.MoveDashboardCardDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="5"
                Padding="12"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Style="{DynamicResource Text.Secondary}"
                           Text="{Binding StatusMessage}"/>
                <Button Grid.Column="1"
                        MinWidth="104"
                        Height="38"
                        Style="{DynamicResource Button.Secondary}"
                        Command="{Binding ReloadCommand}"
                        Content="Reload"/>
                <Button Grid.Column="3"
                        MinWidth="112"
                        Height="38"
                        Style="{DynamicResource Button.Primary}"
                        Command="{Binding SaveCommand}"
                        Content="Save settings"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
