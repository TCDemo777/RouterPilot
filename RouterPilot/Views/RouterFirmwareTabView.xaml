<UserControl x:Class="RouterPilot.Views.RouterFirmwareTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.WindowBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,18,12,0">
            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Router Firmware" />
            <TextBlock Margin="0,5,0,14" Style="{DynamicResource Text.Secondary}"
                       Text="Firmware information for the connected GL.iNet router. RouterPilot checks availability but never downloads or installs router firmware."
                       TextWrapping="Wrap" />

            <Border Padding="14" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.CardCaption}" Text="CONNECTED ROUTER" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Current firmware" />
                            <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding FirmwareCurrentVersion}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Router model" />
                            <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding RouterIdentityText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RouterIdentityText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{DynamicResource Text.Muted}" Text="Update status" />
                            <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{Binding FirmwareStatusColour}" Text="{Binding FirmwareStatusText}" />
                            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding FirmwareLatestVersion, StringFormat=Latest: {0}}" />
                            <TextBlock Margin="0,2,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding FirmwareLastChecked, StringFormat=Last checked: {0}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="20,0,0,0" VerticalAlignment="Top">
                            <Button Width="144" Height="36" Style="{DynamicResource Button.Primary}" Content="Check for Updates"
                                    IsEnabled="{Binding CanCheckFirmware}" Click="CheckFirmware_Click" />
                            <Button Width="144" Height="36" Margin="0,8,0,0" Style="{DynamicResource Button.Secondary}" Content="Release Notes" Click="ReleaseNotes_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,12,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding UpdateReadinessText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,14,0,0" Padding="14" Style="{DynamicResource Card}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.CardCaption}" Text="FIRMWARE LIFECYCLE" />
                    <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Secondary}"
                               Text="Capture a read-only baseline before upgrading in the GL.iNet administration interface, then compare the observed router state after it reconnects."
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Margin="0,0,10,0" Style="{DynamicResource Button.Primary}" Content="Save Pre-Upgrade Baseline"
                                IsEnabled="{Binding Dashboard.RouterConnected}" Click="PrepareFirmwareUpgrade_Click" />
                        <Button Style="{DynamicResource Button.Secondary}" Content="Run Post-Upgrade Check"
                                IsEnabled="{Binding Dashboard.RouterConnected}" Click="RunPostUpgradeCheck_Click" />
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding LifecycleStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
