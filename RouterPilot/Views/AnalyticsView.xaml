<UserControl
    x:Class="RouterPilot.Views.AnalyticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RouterPilot.Controls"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    Background="{DynamicResource Brush.WindowBackground}"
    Foreground="{DynamicResource Brush.TextPrimary}">

    <UserControl.Resources>
        <Style x:Key="Analytics.RankingList" TargetType="ListBox">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="Analytics.RankingItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="Analytics.Badge" TargetType="Border" BasedOn="{StaticResource Badge}" />

        <Style x:Key="Analytics.EmptyState"
               TargetType="StackPanel"
               BasedOn="{StaticResource EmptyState}" />

        <Style x:Key="Analytics.HealthBadge" TargetType="Border" BasedOn="{StaticResource Badge}" />

        <Style x:Key="Analytics.HealthProgress" TargetType="ProgressBar" BasedOn="{StaticResource Leaderboard.Track}">
            <Setter Property="Height" Value="8" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
        </Style>

        <Style x:Key="Analytics.HealthMetric" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Brush.WindowBackground}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource Page.Content}">

            <!-- Heading -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        Style="{StaticResource Text.PageTitle}"
                        Text="Analytics" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="AdGuard Home query trends, clients and domain activity" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="24,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource Text.CardCaption}"
                        Text="LAST REFRESH" />
                    <TextBlock
                        Margin="0,3,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding LastRefresh}" />
                </StackPanel>
            </Grid>

            <!-- Live network activity -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.SectionTitle}" Text="History range" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,6,0" Style="{DynamicResource Button.Secondary}" Tag="1H" Content="1H" Click="HistoryRange_Click" />
                    <Button Margin="0,0,6,0" Style="{DynamicResource Button.Secondary}" Tag="24H" Content="24H" Click="HistoryRange_Click" />
                    <Button Margin="0,0,6,0" Style="{DynamicResource Button.Secondary}" Tag="7D" Content="7D" Click="HistoryRange_Click" />
                    <Button Style="{DynamicResource Button.Secondary}" Tag="30D" Content="30D" Click="HistoryRange_Click" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Style="{StaticResource Text.SectionTitle}"
                    Text="Live Network Activity" />
                <Border
                    Grid.Column="1"
                    Background="{DynamicResource Brush.SurfaceMuted}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Style="{StaticResource Analytics.Badge}">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        Text="{Binding WanInterface, StringFormat=WAN INTERFACE: {0}}" />
                </Border>
            </Grid>

            <WrapPanel Margin="0,0,-12,12">
                <controls:StatisticCard
                    Width="250"
                    Margin="0,0,12,12"
                    AccentBrush="{DynamicResource Brush.Success}"
                    IconBackground="{DynamicResource Brush.SuccessSubtle}"
                    IconGlyph="&#xE896;"
                    Subtitle="Current inbound WAN rate"
                    Title="DOWNLOAD"
                    Value="{Binding CurrentDownload}" />

                <controls:StatisticCard
                    Width="250"
                    Margin="0,0,12,12"
                    AccentBrush="{DynamicResource Brush.Primary}"
                    IconBackground="{DynamicResource Brush.PrimarySubtle}"
                    IconGlyph="&#xE898;"
                    Subtitle="Current outbound WAN rate"
                    Title="UPLOAD"
                    Value="{Binding CurrentUpload}" />

                <controls:StatisticCard
                    Width="250"
                    Margin="0,0,12,12"
                    AccentBrush="{DynamicResource Brush.Warning}"
                    IconBackground="{DynamicResource Brush.WarningSubtle}"
                    IconGlyph="&#xE9D9;"
                    Subtitle="Highest download this session"
                    Title="PEAK DOWNLOAD"
                    Value="{Binding PeakDownload}" />
            </WrapPanel>

            <Border
                MinHeight="300"
                Margin="0,0,0,20"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource Text.SectionTitle}"
                            Text="WAN throughput" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Text.Muted}"
                            Text="Smoothed rolling throughput from the router interface" />
                    </StackPanel>

                    <Border
                        Grid.Row="2"
                        Padding="8"
                        Background="{DynamicResource Brush.SurfaceMuted}"
                        CornerRadius="10">
                        <lvc:CartesianChart
                            MinHeight="210"
                            AnimationsSpeed="0:0:0.25"
                            Background="Transparent"
                            LegendPosition="Top"
                            Series="{Binding NetworkTrafficSeries}"
                            TooltipPosition="Top"
                            XAxes="{Binding NetworkTrafficXAxes}"
                            YAxes="{Binding NetworkTrafficYAxes}" />
                    </Border>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="AVERAGE DOWNLOAD" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding AverageDownload}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="AVERAGE UPLOAD" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding AverageUpload}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="PEAK DOWNLOAD" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding PeakDownload}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="PEAK UPLOAD" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding PeakUpload}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Margin="0,0,0,20" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Internet Reliability" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="Observed while RouterPilot is running. Unmonitored time is excluded." />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Muted}" Text="{Binding InternetReliabilityObserved}" />
                        </StackPanel>
                        <Button Grid.Column="1" MinWidth="104" Height="32" Style="{DynamicResource Button.Secondary}" Content="Clear History" Click="ClearMetricHistory_Click" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource Text.CardCaption}" Text="AVAILABILITY"/><TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding InternetReliabilityAvailability}"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Text.CardCaption}" Text="CURRENT STATUS"/><TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{Binding InternetStatusColour}" Text="{Binding InternetReliabilityStatus}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Text.CardCaption}" Text="CURRENT UPTIME"/><TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding InternetReliabilityUptime}"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Text.CardCaption}" Text="OUTAGES"/><TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding InternetReliabilityOutages}"/></StackPanel>
                        <StackPanel Grid.Row="2"><TextBlock Style="{StaticResource Text.CardCaption}" Text="TOTAL DOWNTIME"/><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding InternetReliabilityDowntime}"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Style="{StaticResource Text.CardCaption}" Text="LONGEST OUTAGE"/><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding InternetReliabilityLongestOutage}"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"><TextBlock Style="{StaticResource Text.CardCaption}" Text="LAST OUTAGE"/><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="{Binding InternetReliabilityLastOutage}"/></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionContainerStyle}">
                <StackPanel x:Name="SpeedTestPanel">
                    <Grid Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Internet Speed Test" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="User-initiated throughput measurement. RouterPilot uses the router only when a verified installed backend is available." />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,0,0,14" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding RouterAvailabilityText}" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="PING" />
                            <TextBlock x:Name="SpeedTestPingText" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding PingDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="DOWNLOAD" />
                            <TextBlock x:Name="SpeedTestDownloadText" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding DownloadDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="UPLOAD" />
                            <TextBlock x:Name="SpeedTestUploadText" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding UploadDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="SOURCE" />
                            <TextBlock x:Name="SpeedTestSourceText" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding SourceDisplay}" ToolTip="{Binding SourceToolTip}">
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Muted}" Text="Provider" />
                        <TextBlock x:Name="SpeedTestProviderText" Grid.Column="1" Margin="10,0,24,0" Style="{StaticResource Text.Body}" Text="{Binding ProviderDisplay}" ToolTip="Running the test connects to an external Measurement Lab measurement server." />
                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Muted}" Text="Last tested" />
                        <TextBlock x:Name="SpeedTestLastTestedText" Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource Text.Body}" Text="{Binding LastTestedDisplay}" />
                    </Grid>

                    <TextBlock x:Name="SpeedTestStatusText" Margin="0,0,0,14" Style="{StaticResource Text.Muted}" Text="{Binding StatusDisplay, StringFormat=Status: {0}}" />
                    <TextBlock x:Name="SpeedTestErrorText" Margin="0,-8,0,14" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Visibility="Collapsed" />

                    <WrapPanel Margin="0,0,0,10">
                        <Button x:Name="RunSpeedTestButton" Width="144" Height="36" Margin="0,0,10,0" Style="{DynamicResource Button.Primary}" Content="Run Speed Test" Click="RunSpeedTestButton_Click" />
                        <Button Width="90" Height="36" Margin="0,0,10,0" Style="{DynamicResource Button.Secondary}" Content="Cancel" IsEnabled="{Binding IsRunning}" Click="CancelSpeedTest_Click" />
                        <Button MinWidth="190" Height="36" Style="{DynamicResource Button.Secondary}" Content="Clear Speed Test History" Click="ClearSpeedTestHistory_Click" />
                    </WrapPanel>
                    <Separator Margin="0,0,0,12" />
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.SectionTitle}" Text="Recent tests" />
                    <TextBlock x:Name="NoSpeedTestsText" Text="No speed tests yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasHistory}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl x:Name="RecentSpeedTestsList" ItemsSource="{Binding RecentHistory}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding Timestamp, StringFormat={}{0:g}}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Secondary}" Text="{Binding SourceDisplay}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Secondary}" Text="{Binding DownloadDisplay}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource Text.Secondary}" Text="{Binding UploadDisplay}" />
                                    <TextBlock Grid.Column="4" HorizontalAlignment="Right" Style="{StaticResource Text.Secondary}" Text="{Binding PingDisplay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Resource health -->
            <Border Margin="0,0,0,20" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Resource health" />
                    <TextBlock Margin="0,5,0,18"
                               Style="{StaticResource Text.Secondary}"
                               Text="Current CPU, memory and storage utilisation reported by the router." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.SectionTitle}" Text="CPU" />
                                <Border Grid.Column="1" Style="{StaticResource Analytics.HealthBadge}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding CpuHealthColour}" Text="{Binding CpuHealthText}" />
                                </Border>
                            </Grid>
                            <ProgressBar Margin="0,13,0,7" Style="{StaticResource Analytics.HealthProgress}" Value="{Binding CpuPercentage}" />
                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding CpuUsageDisplay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.SectionTitle}" Text="Memory" />
                                <Border Grid.Column="1" Style="{StaticResource Analytics.HealthBadge}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding MemoryHealthColour}" Text="{Binding MemoryHealthText}" />
                                </Border>
                            </Grid>
                            <ProgressBar Margin="0,13,0,7" Style="{StaticResource Analytics.HealthProgress}" Value="{Binding MemoryPercentage}" />
                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding MemoryUsage}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Analytics.HealthMetric}" Text="{Binding MemoryUsed, StringFormat=Used: {0}}" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource Analytics.HealthMetric}" Text="{Binding MemoryCache, StringFormat=Cache: {0}}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.SectionTitle}" Text="Storage" />
                                <Border Grid.Column="1" Style="{StaticResource Analytics.HealthBadge}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding StorageHealthColour}" Text="{Binding StorageHealthText}" />
                                </Border>
                            </Grid>
                            <ProgressBar Margin="0,13,0,7" Style="{StaticResource Analytics.HealthProgress}" Value="{Binding StoragePercentage}" />
                            <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding StorageUsage}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Analytics.HealthMetric}" Text="{Binding StorageUsed, StringFormat=Used: {0}}" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource Analytics.HealthMetric}" Text="{Binding StorageAvailable, StringFormat=Free: {0}}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource Analytics.HealthMetric}" Text="{Binding StorageTotal, StringFormat=Total: {0}}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Summary -->
            <TextBlock
                Margin="0,0,0,12"
                Style="{StaticResource Text.Secondary}"
                Foreground="{DynamicResource Brush.Warning}"
                Text="{Binding AdGuardAvailabilityMessage}" />

            <Border Style="{StaticResource SectionContainerStyle}">
            <StackPanel>
            <TextBlock Margin="0,0,0,12" Style="{StaticResource Text.SectionTitle}" Text="DNS Summary" />
            <WrapPanel Margin="0,0,-12,0">
                <controls:StatisticCard
                    Width="250"
                    Margin="0,0,12,12"
                    AccentBrush="{DynamicResource Brush.Primary}"
                    IconBackground="{DynamicResource Brush.PrimarySubtle}"
                    IconGlyph="&#xE774;"
                    Subtitle="All requests processed"
                    Title="TOTAL DNS QUERIES"
                    Value="{Binding AdGuardQueriesDisplay}" />

                <controls:StatisticCard
                    Width="250"
                    Margin="0,0,12,12"
                    AccentBrush="{DynamicResource Brush.Danger}"
                    IconBackground="{DynamicResource Brush.DangerSubtle}"
                    IconGlyph="&#xE72E;"
                    Subtitle="Requests stopped by protection"
                    Title="BLOCKED DNS QUERIES"
                    Value="{Binding AdGuardBlockedDisplay}" />

                <controls:StatisticCard
                    Width="250"
                    Margin="0,0,12,12"
                    AccentBrush="{DynamicResource Brush.Success}"
                    IconBackground="{DynamicResource Brush.SuccessSubtle}"
                    IconGlyph="&#xE9D9;"
                    Subtitle="Share of traffic blocked"
                    Title="BLOCKING RATE"
                    Value="{Binding AdGuardBlockRateDisplay}" />
            </WrapPanel>
            </StackPanel>
            </Border>

            <!-- Chart -->
            <Border
                MinHeight="330"
                Margin="0,0,0,20"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource Text.SectionTitle}"
                                Text="Traffic history" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource Text.Muted}"
                                Text="Recent request volume reported by AdGuard Home" />
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Background="{DynamicResource Brush.SurfaceMuted}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            Style="{StaticResource Analytics.Badge}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Margin="0,0,7,0"
                                    Fill="{Binding AdGuardStatusColour}" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="{Binding AdGuardLiveStatusText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Padding="8"
                        Background="{DynamicResource Brush.SurfaceMuted}"
                        CornerRadius="10">
                        <lvc:CartesianChart
                            MinHeight="240"
                            Background="Transparent"
                            LegendPosition="Top"
                            Series="{Binding QueryHistorySeries}"
                            TooltipPosition="Top"
                            XAxes="{Binding QueryHistoryXAxes}"
                            YAxes="{Binding QueryHistoryYAxes}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Rankings -->
            <Border Style="{StaticResource SectionContainerStyle}">
            <StackPanel>
            <TextBlock
                Style="{StaticResource SectionHeaderStyle}"
                Text="Top activity" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Top clients -->
                <Border
                    Grid.Column="0"
                    MinHeight="430"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock
                                    Style="{StaticResource Text.SectionTitle}"
                                    Text="Top clients" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource Text.Muted}"
                                    Text="Devices generating the most DNS requests" />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Background="{DynamicResource Brush.PrimarySubtle}"
                                Style="{StaticResource Analytics.Badge}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.Primary}"
                                    Text="TOP 5" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel" BasedOn="{StaticResource Analytics.EmptyState}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopClients.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="28"
                                    Foreground="{DynamicResource Brush.TextMuted}"
                                    Text="&#xE716;" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    Style="{StaticResource Text.Secondary}"
                                    Text="{Binding TopClientsEmptyText}" />
                            </StackPanel>

                            <ListBox
                                ItemContainerStyle="{StaticResource Analytics.RankingItem}"
                                ItemsSource="{Binding TopClients}"
                                Style="{StaticResource Analytics.RankingList}"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            Margin="0,0,0,16"
                                            ToolTip="{Binding Name}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                 <Grid.ColumnDefinitions>
                                                     <ColumnDefinition Width="36" />
                                                     <ColumnDefinition Width="*" />
                                                     <ColumnDefinition Width="Auto" />
                                                     <ColumnDefinition Width="Auto" />
                                                 </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="28"
                                                    Height="28"
                                                    Background="{DynamicResource Brush.PrimarySubtle}"
                                                    BorderBrush="{DynamicResource Brush.PrimarySubtleBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource Brush.Primary}"
                                                        Text="{Binding Rank}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                                        Text="{Binding DisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource Brush.TextMuted}"
                                                        Text="{Binding Address}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Brush.Primary}"
                                                    Text="{Binding Count, StringFormat={}{0:N0}}" />
                                            </Grid>

                                            <ProgressBar
                                                Grid.Row="2"
                                                Foreground="{DynamicResource Brush.Primary}"
                                                Style="{StaticResource Leaderboard.Track}"
                                                Value="{Binding RelativePercent}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Top blocked -->
                <Border
                    Grid.Column="2"
                    MinHeight="430"
                    Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock
                                    Style="{StaticResource Text.SectionTitle}"
                                    Text="Top blocked domains" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource Text.Muted}"
                                    Text="Domains stopped most often by protection rules" />
                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Background="{DynamicResource Brush.DangerSubtle}"
                                Style="{StaticResource Analytics.Badge}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Brush.Danger}"
                                    Text="TOP 5" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2">
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel" BasedOn="{StaticResource Analytics.EmptyState}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TopBlockedDomains.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    FontSize="28"
                                    Foreground="{DynamicResource Brush.TextMuted}"
                                    Text="&#xE72E;" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    Style="{StaticResource Text.Secondary}"
                                    Text="{Binding TopBlockedDomainsEmptyText}" />
                            </StackPanel>

                            <ListBox
                                ItemContainerStyle="{StaticResource Analytics.RankingItem}"
                                ItemsSource="{Binding TopBlockedDomains}"
                                Style="{StaticResource Analytics.RankingList}"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            Margin="0,0,0,16"
                                            ToolTip="{Binding Name}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="28"
                                                    Height="28"
                                                    Background="{DynamicResource Brush.DangerSubtle}"
                                                    BorderBrush="{DynamicResource Brush.DangerSubtleBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="14">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource Brush.Danger}"
                                                        Text="{Binding Rank}" />
                                                </Border>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />

                                                 <TextBlock
                                                     Grid.Column="2"
                                                     VerticalAlignment="Center"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource Brush.Danger}"
                                                     Text="{Binding Count, StringFormat={}{0:N0}}" />

                                                 <Button
                                                     Grid.Column="3"
                                                     Margin="12,0,0,0"
                                                     Padding="10,4"
                                                     VerticalAlignment="Center"
                                                     Style="{DynamicResource Button.Secondary}"
                                                     Tag="{Binding Name}"
                                                     Content="View activity"
                                                     ToolTip="View matching DNS activity"
                                                     Click="ViewDomainActivity_Click" />
                                             </Grid>

                                            <ProgressBar
                                                Grid.Row="2"
                                                Foreground="{DynamicResource Brush.Danger}"
                                                Style="{StaticResource Leaderboard.Track}"
                                                Value="{Binding RelativePercent}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Requested domains full width -->
            <Border
                MinHeight="330"
                Margin="0"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource Text.SectionTitle}"
                                Text="Top requested domains" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource Text.Muted}"
                                Text="Most frequently requested destinations" />
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Background="{DynamicResource Brush.SuccessSubtle}"
                            Style="{StaticResource Analytics.Badge}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Brush.Success}"
                                Text="TOP 5" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel" BasedOn="{StaticResource Analytics.EmptyState}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TopQueriedDomains.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="28"
                                Foreground="{DynamicResource Brush.TextMuted}"
                                Text="&#xE774;" />
                            <TextBlock
                                Margin="0,10,0,0"
                                Style="{StaticResource Text.Secondary}"
                                Text="{Binding TopQueriedDomainsEmptyText}" />
                        </StackPanel>

                        <ListBox
                            ItemContainerStyle="{StaticResource Analytics.RankingItem}"
                            ItemsSource="{Binding TopQueriedDomains}"
                            Style="{StaticResource Analytics.RankingList}"
                                Background="Transparent"
                                BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Margin="0,0,0,15"
                                        ToolTip="{Binding Name}">
                                         <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="38" />
                                             <ColumnDefinition Width="280" />
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="80" />
                                             <ColumnDefinition Width="Auto" />
                                         </Grid.ColumnDefinitions>

                                        <Border
                                            Width="28"
                                            Height="28"
                                            Background="{DynamicResource Brush.SuccessSubtle}"
                                            BorderBrush="{DynamicResource Brush.SuccessSubtleBorder}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource Brush.Success}"
                                                Text="{Binding Rank}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />

                                        <ProgressBar
                                            Grid.Column="2"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Brush.Success}"
                                            Style="{StaticResource Leaderboard.Track}"
                                            Value="{Binding RelativePercent}" />

                                         <TextBlock
                                             Grid.Column="3"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource Brush.Success}"
                                             Text="{Binding Count, StringFormat={}{0:N0}}" />

                                         <Button
                                             Grid.Column="4"
                                             Margin="12,0,0,0"
                                             Padding="10,4"
                                             VerticalAlignment="Center"
                                             Style="{DynamicResource Button.Secondary}"
                                             Tag="{Binding Name}"
                                             Content="View activity"
                                             ToolTip="View matching DNS activity"
                                             Click="ViewDomainActivity_Click" />
                                     </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
