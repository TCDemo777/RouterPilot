                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource Brush.Success}"
                                                Text="{Binding Rank}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />

                                        <ProgressBar
                                            Grid.Column="2"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource Brush.Success}"
                                            Style="{StaticResource Leaderboard.Track}"
                                            Value="{Binding RelativePercent}" />

                                         <TextBlock
                                             Grid.Column="3"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Center"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource Brush.Success}"
                                             Text="{Binding Count, StringFormat={}{0:N0}}" />

                                         <Button
                                             Grid.Column="4"
                                             Margin="12,0,0,0"
                                             Padding="10,4"
                                             VerticalAlignment="Center"
                                             Style="{DynamicResource Button.Secondary}"
                                             Tag="{Binding Name}"
                                             Content="View activity"
                                             ToolTip="View matching DNS activity"
                                             Click="ViewDomainActivity_Click" />
                                     </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            </StackPanel>
            </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
