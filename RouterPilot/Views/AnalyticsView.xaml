                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                Style="{StaticResource Text.SectionTitle}"
                                Text="Traffic history" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource Text.Muted}"
                                Text="Recent request volume reported by AdGuard Home" />
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Background="{DynamicResource Brush.SurfaceMuted}"
                            BorderBrush="{DynamicResource Brush.Border}"
