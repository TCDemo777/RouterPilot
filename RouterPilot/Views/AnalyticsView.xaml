<UserControl
    x:Class="RouterPilot.Views.AnalyticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:RouterPilot.Controls"
    xmlns:local="clr-namespace:RouterPilot.Converters"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    Background="{DynamicResource Brush.WindowBackground}"
    Foreground="{DynamicResource Brush.TextPrimary}">

    <UserControl.Resources>
        <Style x:Key="Analytics.RankingList" TargetType="ListBox">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="Analytics.RankingItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="Analytics.Badge" TargetType="Border" BasedOn="{StaticResource Badge}" />

        <Style x:Key="Analytics.EmptyState"
               TargetType="StackPanel"
               BasedOn="{StaticResource EmptyState}" />

        <Style x:Key="Analytics.HealthBadge" TargetType="Border" BasedOn="{StaticResource Badge}" />

        <Style x:Key="Analytics.HealthProgress" TargetType="ProgressBar" BasedOn="{StaticResource Leaderboard.Track}">
            <Setter Property="Height" Value="8" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
        </Style>

        <Style x:Key="Analytics.HealthMetric" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Brush.WindowBackground}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Style="{StaticResource Page.Content}">

            <!-- Heading -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        Style="{StaticResource Text.PageTitle}"
                        Text="Analytics" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{StaticResource Text.Secondary}"
                        Text="Router traffic, reliability, application traffic and DNS activity" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="24,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource Text.CardCaption}"
                        Text="LAST REFRESH" />
                    <TextBlock
                        Margin="0,3,0,0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource Text.Secondary}"
                        Text="{Binding LastRefresh}" />
                </StackPanel>
            </Grid>

            <TabControl x:Name="AnalyticsTabs"
                        Margin="0,0,0,18"
                        Style="{StaticResource RouterPilotTabControlStyle}"
                        ItemContainerStyle="{StaticResource RouterPilotTabItemStyle}"
                        SelectionChanged="AnalyticsTabs_SelectionChanged">
                <TabItem Header="Overview" />
                <TabItem Header="Data Statistics" />
                <TabItem Header="DNS / Protection" />
            </TabControl>

            <StackPanel x:Name="DataStatisticsContent" Visibility="Collapsed">
            <Border Margin="0,0,0,20" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding StatusTitle}" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Text="{Binding StatusDetail}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Style="{DynamicResource Button.Secondary}"
                                Content="Refresh"
                                Command="{Binding RefreshCommand}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="CURRENT PERIOD" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}" Text="{Binding CurrentPeriod}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="DPI LIBRARY" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding DpiLibrary}" />
                        </StackPanel>
                    </Grid>

                    <Border Padding="8"
                            Margin="0,0,0,14"
                            Background="{DynamicResource Brush.SurfaceMuted}"
                            CornerRadius="10"
                            Visibility="{Binding HasTopApps, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <lvc:CartesianChart MinHeight="220"
                                            Background="Transparent"
                                            LegendPosition="Top"
                                            Series="{Binding TrafficSeries}"
                                            XAxes="{Binding TrafficXAxes}"
                                            YAxes="{Binding TrafficYAxes}" />
                    </Border>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Text.SectionTitle}"
                                   Text="Top applications" />
                        <TextBlock Margin="0,4,0,0"
                                   Style="{StaticResource Text.Muted}"
                                   TextWrapping="Wrap"
                                   Text="Select an application to view traffic details and devices using it." />
                    </StackPanel>
                    <Grid Margin="0,0,0,6"
                          Visibility="{Binding HasTopApps, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.CardCaption}" Text="APPLICATION" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.CardCaption}" Text="DOWNLOAD" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Text.CardCaption}" Text="UPLOAD" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Text.CardCaption}" Text="TOTAL" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding TopApps}"
                                  Visibility="{Binding HasTopApps, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                                        Tag="{Binding}" Cursor="Hand" MouseLeftButtonUp="TopApplication_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DownloadBytes, Converter={x:Static local:DataStatisticsValueConverter.Instance}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding UploadBytes, Converter={x:Static local:DataStatisticsValueConverter.Instance}}" />
                                        <TextBlock Grid.Column="3" Text="{Binding TotalBytes, Converter={x:Static local:DataStatisticsValueConverter.Instance}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Text.Muted}"
                               Text="{Binding TopAppsEmptyText}"
                               Visibility="{Binding HasNoTopApps, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Grid Margin="0,22,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="All Applications" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Text.Muted}"
                                       TextWrapping="Wrap"
                                       Text="Select an application to view traffic details and devices using it." />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource Text.Muted}"
                                       Text="{Binding FullTablePeriod, StringFormat=Current period: {0}}" />
                        </StackPanel>
                        <Grid Grid.Column="1"
                              Width="128"
                              Margin="16,0,0,0"
                              Visibility="{Binding HasApplicationSearch, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox x:Name="AllApplicationsSearchBox"
                                     Height="34"
                                     Padding="36,5,10,5"
                                     VerticalContentAlignment="Center"
                                     Background="{DynamicResource Brush.SurfaceMuted}"
                                     BorderBrush="{DynamicResource Brush.Border}"
                                     Foreground="{DynamicResource Brush.TextPrimary}"
                                     ToolTip="Search applications"
                                     Text="{Binding AllApplicationsSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Search.Icon}" />
                            <TextBlock Panel.ZIndex="1"
                                       Margin="36,0,10,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Text="Search">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Text, ElementName=AllApplicationsSearchBox}" Value=""/>
                                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=AllApplicationsSearchBox}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <TextBlock Margin="0,0,0,10"
                               Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap"
                               Text="{Binding FullTablePeriodWarning}"
                               Visibility="{Binding HasFullTablePeriodWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Margin="0,0,0,10"
                               Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap"
                               Text="{Binding FullTableError}" />

                    <Grid Margin="0,0,0,14"
                          Visibility="{Binding HasAggregate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="TOTAL TRAFFIC" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}" Text="{Binding AggregateTotalTraffic}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="DOWNLOADED" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}" Text="{Binding AggregateDownload}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="UPLOADED" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}" Text="{Binding AggregateUpload}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid MaxHeight="360"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              IsReadOnly="True"
                              ItemsSource="{Binding AllApplicationsView}"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource Brush.SurfaceMuted}"
                              BorderBrush="{DynamicResource Brush.Border}"
                              Foreground="{DynamicResource Brush.TextPrimary}"
                              MouseDoubleClick="AllApplications_MouseDoubleClick"
                              Visibility="{Binding HasAllApplications, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Header="Application" Binding="{Binding DisplayName}" SortMemberPath="DisplayName" />
                            <DataGridTextColumn Width="110" Header="Download" Binding="{Binding DownloadBytes, Converter={x:Static local:DataStatisticsValueConverter.Instance}}" SortMemberPath="DownloadBytes" />
                            <DataGridTextColumn Width="110" Header="Upload" Binding="{Binding UploadBytes, Converter={x:Static local:DataStatisticsValueConverter.Instance}}" SortMemberPath="UploadBytes" />
                            <DataGridTextColumn Width="110" Header="Total" Binding="{Binding TotalBytes, Converter={x:Static local:DataStatisticsValueConverter.Instance}}" SortMemberPath="TotalBytes" />
                            <DataGridTextColumn Width="100" Header="Packets" Binding="{Binding PacketCount, StringFormat=N0, TargetNullValue=—}" SortMemberPath="PacketCount" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{StaticResource Text.Muted}"
                               Text="{Binding AllApplicationsEmptyText}"
                               Visibility="{Binding HasNoAllApplications, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Border Margin="0,22,0,0" Padding="12" Background="{DynamicResource Brush.SurfaceMuted}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding HasDetailArea, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding SelectedDetail.Label}" />
                                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Muted}" Text="{Binding SelectedDetail.ApplicationName}" /></StackPanel>
                                <Button Grid.Column="1" Style="{DynamicResource Button.Secondary}" Content="Refresh details" Click="RefreshApplicationDetail_Click" />
                            </Grid>
                            <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="{Binding SelectedDetail.Description}" />
                            <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding SelectedDetail.Url}" />
                            <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding DetailPeriodWarning}"
                                       Visibility="{Binding HasDetailPeriodWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{StaticResource Text.CardCaption}" Text="PERIOD"/><TextBlock Margin="0,3,0,0" Text="{Binding DetailPeriod}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Text.CardCaption}" Text="DOWNLOADED"/><TextBlock Margin="0,3,0,0" Text="{Binding DetailDownload}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Text.CardCaption}" Text="UPLOADED"/><TextBlock Margin="0,3,0,0" Text="{Binding DetailUpload}"/></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Text.CardCaption}" Text="TOTAL TRAFFIC"/><TextBlock Margin="0,3,0,0" Text="{Binding DetailTotal}"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource Text.CardCaption}" Text="BLOCK STATE"/><TextBlock Margin="0,3,0,0" Text="{Binding DetailBlockState}"/></StackPanel>
                            </Grid>
                            <lvc:CartesianChart MinHeight="180" Margin="0,0,0,12" Background="Transparent" LegendPosition="Top"
                                                Series="{Binding DetailTrafficSeries}" XAxes="{Binding TrafficXAxes}" YAxes="{Binding TrafficYAxes}" />
                            <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.SectionTitle}" Text="Devices using this application" />
                            <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding DetailError}" />
                            <DataGrid MaxHeight="300" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserResizeRows="False" IsReadOnly="True" ItemsSource="{Binding DetailDevicesView}"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.WindowBackground}"
                                      BorderBrush="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.TextPrimary}"
                                      Visibility="{Binding HasDetailDevices, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*" Header="Device" Binding="{Binding DisplayName}" />
                                    <DataGridTextColumn Width="100" Header="Download" Binding="{Binding DownloadBytes, Converter={x:Static local:DataStatisticsValueConverter.Instance}}" />
                                    <DataGridTextColumn Width="100" Header="Upload" Binding="{Binding UploadBytes, Converter={x:Static local:DataStatisticsValueConverter.Instance}}" />
                                    <DataGridTextColumn Width="100" Header="Total" Binding="{Binding TotalBytes, Converter={x:Static local:DataStatisticsValueConverter.Instance}}" />
                                    <DataGridTextColumn Width="90" Header="Packets" Binding="{Binding PacketCount, StringFormat=N0, TargetNullValue=—}" />
                                    <DataGridTextColumn Width="135" Header="Last active" Binding="{Binding LastActiveDisplay}" />
                                    <DataGridTemplateColumn Width="95" Header="Action"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Button Content="View client" Style="{DynamicResource Button.Secondary}" Padding="7,3" Tag="{Binding NormalizedMac}"
                                                Click="ViewDetailDeviceClient_Click" Visibility="{Binding CanViewClient, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource Text.Muted}" Text="No device traffic is available for this application in the current period."
                                       Visibility="{Binding HasNoDetailDevices, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            </StackPanel>

            <StackPanel x:Name="OverviewContent">
            <!-- Live network activity -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.SectionTitle}" Text="History range" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,6,0" Style="{DynamicResource Button.Secondary}" Tag="1H" Content="1H" Click="HistoryRange_Click" />
                    <Button Margin="0,0,6,0" Style="{DynamicResource Button.Secondary}" Tag="24H" Content="24H" Click="HistoryRange_Click" />
                    <Button Margin="0,0,6,0" Style="{DynamicResource Button.Secondary}" Tag="7D" Content="7D" Click="HistoryRange_Click" />
                    <Button Style="{DynamicResource Button.Secondary}" Tag="30D" Content="30D" Click="HistoryRange_Click" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Style="{StaticResource Text.SectionTitle}"
                    Text="Live Network Activity" />
                <Border
                    Grid.Column="1"
                    Background="{DynamicResource Brush.SurfaceMuted}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    Style="{StaticResource Analytics.Badge}">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        Text="{Binding WanInterface, StringFormat=WAN INTERFACE: {0}}" />
                </Border>
            </Grid>

            <WrapPanel Margin="0,0,-12,12">
                <controls:StatisticCard
                    Width="250"
                    Margin="0,0,12,12"
                    AccentBrush="{DynamicResource Brush.Success}"
                    IconBackground="{DynamicResource Brush.SuccessSubtle}"
                    IconGlyph="&#xE896;"
                    Subtitle="Current inbound WAN rate"
                    Title="DOWNLOAD"
                    Value="{Binding CurrentDownload}" />

                <controls:StatisticCard
                    Width="250"
                    Margin="0,0,12,12"
                    AccentBrush="{DynamicResource Brush.Primary}"
                    IconBackground="{DynamicResource Brush.PrimarySubtle}"
                    IconGlyph="&#xE898;"
                    Subtitle="Current outbound WAN rate"
                    Title="UPLOAD"
                    Value="{Binding CurrentUpload}" />

                <controls:StatisticCard
                    Width="250"
                    Margin="0,0,12,12"
                    AccentBrush="{DynamicResource Brush.Warning}"
                    IconBackground="{DynamicResource Brush.WarningSubtle}"
                    IconGlyph="&#xE9D9;"
                    Subtitle="Highest download this session"
                    Title="PEAK DOWNLOAD"
                    Value="{Binding PeakDownload}" />
            </WrapPanel>

            <Border
                MinHeight="300"
                Margin="0,0,0,20"
                Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            Style="{StaticResource Text.SectionTitle}"
                            Text="WAN throughput" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Text.Muted}"
                            Text="Smoothed rolling throughput from the router interface" />
                    </StackPanel>

                    <Border
                        Grid.Row="2"
                        Padding="8"
                        Background="{DynamicResource Brush.SurfaceMuted}"
                        CornerRadius="10">
                        <lvc:CartesianChart
                            MinHeight="210"
                            AnimationsSpeed="0:0:0.25"
                            Background="Transparent"
                            LegendPosition="Top"
                            Series="{Binding NetworkTrafficSeries}"
                            TooltipPosition="Top"
                            XAxes="{Binding NetworkTrafficXAxes}"
                            YAxes="{Binding NetworkTrafficYAxes}" />
                    </Border>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="AVERAGE DOWNLOAD" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding AverageDownload}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="AVERAGE UPLOAD" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding AverageUpload}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="PEAK DOWNLOAD" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding PeakDownload}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="PEAK UPLOAD" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding PeakUpload}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Margin="0,0,0,20" Style="{StaticResource SectionContainerStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Internet Reliability" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="Observed while RouterPilot is running. Unmonitored time is excluded." />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Muted}" Text="{Binding InternetReliabilityObserved}" />
                        </StackPanel>
                        <Button Grid.Column="1" MinWidth="104" Height="32" Style="{DynamicResource Button.Secondary}" Content="Clear History" Click="ClearMetricHistory_Click" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource Text.CardCaption}" Text="AVAILABILITY"/><TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding InternetReliabilityAvailability}"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Text.CardCaption}" Text="CURRENT STATUS"/><TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{Binding InternetStatusColour}" Text="{Binding InternetReliabilityStatus}"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Text.CardCaption}" Text="CURRENT UPTIME"/><TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding InternetReliabilityUptime}"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Text.CardCaption}" Text="OUTAGES"/><TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding InternetReliabilityOutages}"/></StackPanel>
                        <StackPanel Grid.Row="2"><TextBlock Style="{StaticResource Text.CardCaption}" Text="TOTAL DOWNTIME"/><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding InternetReliabilityDowntime}"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Style="{StaticResource Text.CardCaption}" Text="LONGEST OUTAGE"/><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" Text="{Binding InternetReliabilityLongestOutage}"/></StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"><TextBlock Style="{StaticResource Text.CardCaption}" Text="LAST OUTAGE"/><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="{Binding InternetReliabilityLastOutage}"/></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionContainerStyle}">
                <StackPanel x:Name="SpeedTestPanel">
                    <Grid Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Internet Speed Test" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="User-initiated throughput measurement. RouterPilot uses the router only when a verified installed backend is available." />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,0,0,14" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Text="{Binding RouterAvailabilityText}" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="PING" />
                            <TextBlock x:Name="SpeedTestPingText" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding PingDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="DOWNLOAD" />
                            <TextBlock x:Name="SpeedTestDownloadText" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding DownloadDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="UPLOAD" />
                            <TextBlock x:Name="SpeedTestUploadText" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding UploadDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource Text.CardCaption}" Text="SOURCE" />
                            <TextBlock x:Name="SpeedTestSourceText" Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding SourceDisplay}" ToolTip="{Binding SourceToolTip}">
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.Muted}" Text="Provider" />
