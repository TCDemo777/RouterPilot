<Window x:Class="RouterPilot.Views.MaintenanceInteractiveSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="Maintenance Console"
        Width="840"
        Height="700"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleTextBlock" Style="{DynamicResource Text.SectionTitle}"/>
            <Border Margin="0,14,0,0" Padding="12" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.CardCaption}" Text="COMMUNITY PROJECT"/>
                        <TextBlock Margin="0,4,0,0" FontWeight="SemiBold" Text="Community project by Admon"/>
                        <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap" Text="Community-maintained updater used by RouterPilot for this optional maintenance workflow."/>
                    </StackPanel>
                    <Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Button.Secondary}" Content="Admon" Click="OpenAdmon_Click" automation:AutomationProperties.Name="Visit Admon"/>
                </Grid>
            </Border>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{DynamicResource Text.Muted}" Text="Router:"/>
                <TextBlock x:Name="RouterTextBlock" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="1" Style="{DynamicResource Text.Muted}" Text="Connection:"/>
                <TextBlock x:Name="ConnectionTextBlock" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Text="SSH"/>
                <TextBlock Grid.Row="2" Style="{DynamicResource Text.Muted}" Text="Operation:"/>
                <TextBlock x:Name="OperationTextBlock" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Grid>
            <TextBlock Margin="0,14,0,5" Style="{DynamicResource Text.CardCaption}" Text="REVIEWED COMMAND"/>
            <TextBox x:Name="CommandTextBox" IsReadOnly="True" IsTabStop="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" MaxHeight="78" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.SurfaceMuted}" Foreground="{DynamicResource Brush.TextPrimary}" BorderBrush="{DynamicResource Brush.Border}"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="MAINTENANCE CONSOLE"/>
            <TextBox x:Name="TranscriptTextBox" Grid.Row="1" Margin="0,6,0,0" IsReadOnly="True" IsTabStop="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Surface}" Foreground="{DynamicResource Brush.TextPrimary}" BorderBrush="{DynamicResource Brush.Border}"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="InputTextBox" MinHeight="34" VerticalContentAlignment="Center" IsEnabled="False" Background="{DynamicResource Brush.SurfaceMuted}" Foreground="{DynamicResource Brush.TextPrimary}" BorderBrush="{DynamicResource Brush.Border}" KeyDown="InputTextBox_KeyDown" automation:AutomationProperties.Name="Updater response"/>
            <Button x:Name="SendInputButton" Grid.Column="1" Margin="10,0,0,0" MinWidth="86" Style="{DynamicResource Button.Secondary}" Content="Send" IsEnabled="False" Click="SendInput_Click" automation:AutomationProperties.Name="Send updater response"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTextBlock" VerticalAlignment="Center" Style="{DynamicResource Text.Secondary}" Text="Preparing Maintenance SSH session." TextWrapping="Wrap"/>
            <Button x:Name="CancelButton" Grid.Column="1" Margin="12,0,0,0" MinWidth="132" Style="{DynamicResource Button.Danger}" Content="Cancel operation" Click="Cancel_Click"/>
            <Button Grid.Column="2" Margin="10,0,0,0" MinWidth="80" Style="{DynamicResource Button.Secondary}" Content="Close" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
