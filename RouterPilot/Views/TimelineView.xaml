                                            <TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding Category}"/>
                                            <TextBlock Margin="8,0" Style="{DynamicResource Text.Muted}" Text="•"/>
                                            <TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding EventType}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Top" Style="{DynamicResource Text.Muted}" Text="{Binding TimestampDisplay}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate> -->
                </ItemsControl>
                <Border Padding="32" Style="{StaticResource Card}" Visibility="{Binding EmptyStateVisibility}">
                    <StackPanel Style="{StaticResource EmptyState}">
                        <TextBlock Style="{StaticResource Icon.EmptyState}" Text="&#xE81C;"/>
                        <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.EmptyStateTitle}" Text="{Binding EmptyStateText}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
