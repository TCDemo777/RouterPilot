<UserControl x:Class="RouterPilot.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RouterPilot.Models"
             Background="{DynamicResource Brush.WindowBackground}"
             Foreground="{DynamicResource Brush.TextPrimary}">
    <UserControl.Resources>
        <Style x:Key="Timeline.Entry" TargetType="Border" BasedOn="{StaticResource Card.Compact}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="Timeline.FilterTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}"/>
        </Style>
        <DataTemplate DataType="{x:Type models:TimelineEventItem}">
            <Border Style="{StaticResource Timeline.Entry}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border CornerRadius="3"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Brush.Primary}"/><Style.Triggers><DataTrigger Binding="{Binding Event.Severity}" Value="Success"><Setter Property="Background" Value="{DynamicResource Brush.Success}"/></DataTrigger><DataTrigger Binding="{Binding Event.Severity}" Value="Warning"><Setter Property="Background" Value="{DynamicResource Brush.Warning}"/></DataTrigger><DataTrigger Binding="{Binding Event.Severity}" Value="Error"><Setter Property="Background" Value="{DynamicResource Brush.Danger}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border><StackPanel Grid.Column="2"><TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Event.Title}"/><TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Body}" TextWrapping="Wrap" Text="{Binding Event.Message}"/><StackPanel Margin="0,8,0,0" Orientation="Horizontal"><TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding Event.Category}"/><TextBlock Margin="8,0" Style="{DynamicResource Text.Muted}" Text="•"/><TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding Event.EventType}"/></StackPanel></StackPanel><TextBlock Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Top" Style="{DynamicResource Text.Muted}" Text="{Binding Event.TimestampDisplay}"/></Grid></Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:NetworkIncident}">
            <Border Style="{StaticResource Timeline.Entry}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border CornerRadius="3"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Brush.Primary}"/><Style.Triggers><DataTrigger Binding="{Binding IsOngoing}" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Warning}"/></DataTrigger></Style.Triggers></Style></Border.Style></Border><StackPanel Grid.Column="2"><StackPanel Orientation="Horizontal"><TextBlock FontSize="15" FontWeight="SemiBold" Text="NETWORK INTERRUPTION"/><TextBlock Margin="10,1,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding DurationDisplay}"/></StackPanel><TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Body}" TextWrapping="Wrap" Text="{Binding Summary}"/><TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding TimeRangeDisplay}"/><Button Margin="0,8,0,0" HorizontalAlignment="Left" Click="ToggleIncident_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"><Setter Property="Content" Value="Show related events"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Content" Value="Hide related events"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Events}" Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3,0,0"><TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding TimestampDisplay}"/><TextBlock FontWeight="SemiBold" Text="{Binding Title}"/><TextBlock Style="{DynamicResource Text.Body}" TextWrapping="Wrap" Text="{Binding Message}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><TextBlock Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Top" Style="{DynamicResource Text.Muted}" Text="{Binding TimestampDisplay}"/></Grid></Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource Page.Content}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.PageTitle}" Text="Logs"/>
                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}" Text="Chronological RouterPilot activity and safe operation results."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Margin="0,0,8,0" Style="{DynamicResource Button.Secondary}" Command="{Binding ExportCommand}" Content="Export Logs"/><Button Style="{DynamicResource Button.Secondary}" Command="{Binding ClearCommand}" Content="Clear Logs"/></StackPanel>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource SectionContainerStyle}" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TimelineSearchBox" Style="{StaticResource Timeline.FilterTextBox}" Height="36" Padding="36,6,10,6" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search timeline"/>
                <TextBlock Style="{StaticResource Search.Icon}" />
                <TextBlock Margin="36,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextSecondary}" Text="Search">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=TimelineSearchBox}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=TimelineSearchBox}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ComboBox Style="{StaticResource RouterPilot.ComboBox}" Grid.Column="2" Width="128" Height="36" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>
                <ComboBox Style="{StaticResource RouterPilot.ComboBox}" Grid.Column="4" Width="120" Height="36" ItemsSource="{Binding Severities}" SelectedItem="{Binding SelectedSeverity}"/>
                <ComboBox Style="{StaticResource RouterPilot.ComboBox}" Grid.Column="6" Width="128" Height="36" ItemsSource="{Binding DateRanges}" SelectedItem="{Binding SelectedDateRange}"/>
            </Grid>
            </Border>
            <Border Grid.Row="4" Style="{StaticResource SectionContainerStyle}" Margin="0">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Event history"/>
                <ItemsControl ItemsSource="{Binding EventsView}">
                    <!-- <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Timeline.Entry}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border CornerRadius="3">
                                        <Border.Style>
                                            <Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Brush.Primary}"/><Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Success"><Setter Property="Background" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Background" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter Property="Background" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
                                            </Style.Triggers></Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}"/>
                                        <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Body}" TextWrapping="Wrap" Text="{Binding Message}"/>
