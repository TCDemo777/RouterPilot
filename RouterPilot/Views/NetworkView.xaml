<UserControl x:Class="RouterPilot.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Brush.WindowBackground}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="Network.Label"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>

        <Style x:Key="Network.Value"
               TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="Network.HealthBadge"
               TargetType="Border">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Network.ProgressBar"
               TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
        </Style>

        <Style x:Key="Network.MetricLabel"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
        </Style>

        <Style x:Key="Network.SearchTargetRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Small}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.PrimarySubtle}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.PrimarySubtleBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="24,24,24,0">
            <StackPanel>
                <TextBlock Style="{DynamicResource Text.PageTitle}"
                           Text="Network"/>
                <TextBlock Margin="0,5,0,0"
                           Style="{DynamicResource Text.Secondary}"
                           Text="WAN connectivity, DNS configuration, router information and system resources."/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="NetworkTabs"
                    Grid.Row="1"
                    Margin="24,12,24,14"
                    Style="{StaticResource RouterPilotTabControlStyle}"
                    ItemContainerStyle="{StaticResource RouterPilotTabItemStyle}"
                    SelectionChanged="NetworkTabs_SelectionChanged">
            <TabItem Header="Overview"/>
            <TabItem Header="Network Map"/>
            <TabItem Header="Wi-Fi"/>
            <TabItem Header="DHCP"/>
            <TabItem Header="Port Forwarding"/>
            <TabItem Header="Health"/>
            <TabItem Header="Internet Quality"/>
        </TabControl>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,0,24,24">

                <StackPanel x:Name="MapContent" Visibility="Collapsed">
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="LAN topology"/>
                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}" Text="Evidence-based local device relationships. Unknown attachment is shown when the router cannot prove a medium or physical port." TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Copy Network Map Summary" Padding="12,6" Click="CopyNetworkMapSummary_Click"/>
                    </Grid>
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,12" AutomationProperties.Name="Network map router node">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="ROUTER"/>
                            <TextBlock Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" Text="Router"/>
                            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Muted}" Text="Current LAN clients are grouped by authoritative connection evidence."/>
                            <Button Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,6" Content="Open Router Details" Click="OpenMapRouterDetails_Click" AutomationProperties.Name="Open router details"/>
                        </StackPanel>
                    </Border>
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <Border Style="{DynamicResource Card.Compact}" Margin="0,0,8,0"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="CURRENT DEVICES"/><TextBlock x:Name="MapCurrentCountText" Margin="0,5,0,0" FontSize="20" Text="—"/></StackPanel></Border>
                        <Border Style="{DynamicResource Card.Compact}" Margin="4,0,4,0"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="WIRED"/><TextBlock x:Name="MapWiredCountText" Margin="0,5,0,0" FontSize="20" Text="—"/></StackPanel></Border>
                        <Border Style="{DynamicResource Card.Compact}" Margin="8,0,0,0"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="WI-FI / UNKNOWN"/><TextBlock x:Name="MapWirelessCountText" Margin="0,5,0,0" FontSize="20" Text="—"/></StackPanel></Border>
                    </UniformGrid>
                    <TextBlock x:Name="MapStatusText" Margin="0,0,0,8" Style="{DynamicResource Text.Muted}" Text="Loading network map…"/>
                    <ListBox x:Name="MapClientsList" ItemsSource="{Binding LanClients}" SelectedItem="{Binding SelectedMapClient, Mode=TwoWay}" AutomationProperties.Name="Network map devices" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Style="{DynamicResource Card.Compact}" Margin="0,0,0,8">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding ConnectionType}"/></StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{DynamicResource Text.Muted}" Text="{Binding IsOnline, StringFormat=Online: {0}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Border Margin="0,8,0,0" Padding="14" Style="{DynamicResource Card}" AutomationProperties.Name="Network map selected device details">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="SELECTED DEVICE"/>
                            <TextBlock Margin="0,6,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding MapSelectionDisplay}" TextWrapping="Wrap"/>
                            <TextBlock Margin="0,10,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding SelectedMapClient.IpAddress, StringFormat=IPv4: {0}}"/>
                            <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding SelectedMapClient.MacAddress, StringFormat=MAC: {0}}"/>
                            <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding SelectedMapClient.InterfaceDisplay, StringFormat=Attachment: {0}}"/>
                            <Button Margin="0,12,0,0" HorizontalAlignment="Left" Padding="12,6" Content="View Client Details" Click="OpenMapClientDetails_Click" AutomationProperties.Name="View selected client details"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Overview -->
                <ContentControl x:Name="HealthContent" Visibility="Collapsed"/>
                <StackPanel x:Name="InternetQualityContent" Margin="0,0,0,16" Visibility="Collapsed">
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Internet quality"/>
                                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}" Text="Short, manual gateway, Internet and DNS observations. This is not continuous monitoring." TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="RunInternetQualityButton" Padding="12,6" Style="{DynamicResource Button.Primary}" Content="Run Internet Quality Test" Click="RunInternetQuality_Click"/>
                                    <Button x:Name="CancelInternetQualityButton" Margin="8,0,0,0" Padding="12,6" Style="{DynamicResource Button.Secondary}" Content="Cancel" IsEnabled="False" Click="CancelInternetQuality_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="InternetQualityStatusText" Margin="0,14,0,0" Style="{DynamicResource Text.Muted}" Text="No manual test run in this session."/>
                            <TextBlock x:Name="InternetQualityDetailsText" Margin="0,6,0,0" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                            <Button x:Name="CopyInternetQualityButton" Margin="0,12,0,0" HorizontalAlignment="Left" Padding="12,6" Style="{DynamicResource Button.Secondary}" Content="Copy Internet Quality Report" Click="CopyInternetQuality_Click" IsEnabled="False"/>
                            <TextBlock Margin="0,12,0,0" Style="{DynamicResource Text.Muted}" Text="Gateway latency is local gateway timing. Internet latency is the existing router-side diagnostic target. DNS timing measures the diagnostic resolver path and does not prove AdGuard processing time." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,12,0,0" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Recent manual tests"/>
                            <ItemsControl x:Name="InternetQualityHistoryList" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid x:Name="OverviewSummaryContent" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="INTERNET"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding InternetStatusColour}"
                                       Text="{Binding InternetStatusText}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Text="{Binding PublicIpDisplay}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="LATENCY"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding Latency}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Text="Gateway response"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="DNS SERVICE"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding AdGuardServiceDisplay}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Text="{Binding AdGuardVersionDisplay}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="ROUTER"/>
                            <TextBlock Margin="0,8,0,0"
                                       MaxHeight="42"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RouterModel}"
                                       Text="{Binding RouterModel}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Text="{Binding Hostname}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Margin="0,0,0,16" Style="{DynamicResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Connection diagnostics"/>
                                <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}" Text="Run a bounded, read-only DNS and Internet reachability check."/>
                            </StackPanel>
                            <Button x:Name="RunNetworkDiagnosticsButton" Grid.Column="1" Padding="12,6" Style="{DynamicResource Button.Secondary}" Content="Run diagnostics" Click="RunNetworkDiagnostics_Click"/>
                        </Grid>
                        <TextBlock x:Name="NetworkDiagnosticsStatusText" Margin="0,12,0,0" Style="{DynamicResource Text.Muted}" Text="No diagnostic run in this session."/>
                        <TextBlock x:Name="NetworkDiagnosticsDetailsText" Margin="0,4,0,0" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="OverviewMaintenanceContent" Margin="0,0,0,16" Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Quick maintenance"/>
                        <TextBlock Margin="0,5,0,14" Style="{DynamicResource Text.Secondary}"
                                   Text="Safely restart wireless services or reconnect the internet uplink."/>
                        <WrapPanel>
                            <Button MinWidth="132" Margin="0,0,8,8" Padding="16,9"
                                    Click="RestartWifi_Click" Content="Restart Wi-Fi"/>
                            <Button MinWidth="132" Margin="0,0,0,8" Padding="16,9"
                                    Click="ReconnectWan_Click" Content="Reconnect WAN"/>
                        </WrapPanel>
                        <TextBlock x:Name="MaintenanceStatusText" Margin="0,8,0,0"
                                   Style="{DynamicResource Text.Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Wi-Fi -->
                <StackPanel x:Name="WifiContent" Margin="0,0,0,16" Visibility="Collapsed">

                    <Border Margin="0,0,0,16" Style="{DynamicResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Wi-Fi"/>
                                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}"
                                               Text="Configured wireless networks and currently associated clients."/>
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Top" Padding="12,6"
                                        Style="{DynamicResource Button.Secondary}" Click="RestartWifi_Click" Content="Restart Wi-Fi"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Style="{DynamicResource Text.Muted}" Text="Wi-Fi networks"/><TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding WifiNetworks.Count}"/></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Style="{DynamicResource Text.Muted}" Text="Connected Wi-Fi clients"/><TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding WifiUniqueClientTotal}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Style="{DynamicResource Text.Muted}" Text="Bands"/><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="2.4 GHz • 5 GHz • 6 GHz"/></StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding WifiNetworks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Background="{DynamicResource Brush.SurfaceMuted}"
                                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Padding="14">
                                                <Expander.Header>
                                                    <Grid MinHeight="42">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Ssid}" Text="{Binding Ssid}"/>
                                                                <Border Margin="10,0,0,0" Padding="7,2" Background="{DynamicResource Brush.PrimarySubtle}" CornerRadius="8">
                                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsVerifiedGuestNetwork}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" Text="Guest"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding CollapsedSummary}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{Binding StatusColour}" Text="{Binding StatusDisplay}"/>
                                                    </Grid>
                                                </Expander.Header>
                                                <StackPanel Margin="0,14,0,0">
                                                    <Border Height="1" Background="{DynamicResource Brush.Border}"/>
                                                    <TextBlock Margin="0,14,0,8" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="NETWORK DETAILS"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel><TextBlock Style="{DynamicResource Text.Muted}" Text="Band"/><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding Band}"/></StackPanel>
                                                        <StackPanel Grid.Column="1"><TextBlock Style="{DynamicResource Text.Muted}" Text="Channel"/><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding Channel}"/></StackPanel>
                                                        <StackPanel Grid.Column="2"><TextBlock Style="{DynamicResource Text.Muted}" Text="Channel width"/><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding ChannelWidth}"/></StackPanel>
                                                    </Grid>
                                                    <Grid Margin="0,12,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel><TextBlock Style="{DynamicResource Text.Muted}" Text="Security"/><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding Security}"/></StackPanel>
                                                        <StackPanel Grid.Column="1"><TextBlock Style="{DynamicResource Text.Muted}" Text="Interface"/><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding Interface}"/></StackPanel>
                                                        <StackPanel Grid.Column="2"><TextBlock Style="{DynamicResource Text.Muted}" Text="Status"/><TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding StatusDisplay}"/></StackPanel>
                                                    </Grid>
                                                    <TextBlock Margin="0,16,0,8" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="CONNECTED CLIENTS"/>
                                                    <TextBlock Margin="0,0,0,8" Text="No clients currently associated with this network.">
                                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.EmptyStateMessage}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ClientCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding Clients}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,4">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                                                        <TextBlock Grid.Column="1" Margin="16,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding DisplayIpAddress}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Expander>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No Wi-Fi networks configured.">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.EmptyStateMessage}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasWifiNetworks}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,16" Style="{DynamicResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Wi-Fi Overview"/>
                                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}"
                                               Text="Current radio status, connected clients and signal quality."/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <ItemsControl ItemsSource="{Binding WifiNetworks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="330" Margin="0,0,12,12" Padding="16"
                                                    Background="{DynamicResource Brush.SurfaceMuted}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1" CornerRadius="10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="8"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="12"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="17" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                                   Text="{Binding Band}"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Border Margin="0,0,8,0" Padding="7,3" Background="{DynamicResource Brush.PrimarySubtle}" CornerRadius="9">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsVerifiedGuestNetwork}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Primary}" Text="Guest"/>
                                                            </Border>
                                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                                                       Foreground="{Binding StatusColour}" Text="{Binding StatusDisplay}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Grid.Row="2" FontSize="15" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Ssid}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Ssid}"/>
                                                    <StackPanel Grid.Row="4">
                                                        <TextBlock Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ChannelSummary}"/>
                                                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Security}"/>
                                                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding ClientCountDisplay}"/>
                                                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                                                                   Text="{Binding AverageSignalDisplay}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasAverageSignal}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWifiNetworks}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Style="{DynamicResource Text.EmptyStateTitle}" Text="No Wi-Fi networks configured"/>
                                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.EmptyStateMessage}"
                                               Text="Configured wireless networks will appear after the next refresh."/>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,4,0,12" Padding="16"
                                    Background="{DynamicResource Brush.SurfaceMuted}"
                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Client Distribution"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Style="{DynamicResource Text.Muted}" Text="Wi-Fi clients"/><TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding WifiUniqueClientTotal}"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Style="{DynamicResource Text.Muted}" Text="2.4 GHz"/><TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding Wifi24ClientTotal}"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Style="{DynamicResource Text.Muted}" Text="5 GHz"/><TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding Wifi5ClientTotal}"/></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Style="{DynamicResource Text.Muted}" Text="6 GHz"/><TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding Wifi6ClientTotal}"/></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Style="{DynamicResource Text.Muted}" Text="Guest"/><TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding WifiGuestClientTotal}"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <WrapPanel Margin="0,4,0,0">
                                <WrapPanel.Style>
                                    <Style TargetType="WrapPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasWifiSignalData}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </WrapPanel.Style>
                                <Border Width="420" Margin="0,0,12,12" Padding="16"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Signal Quality"/>
                                        <TextBlock Margin="0,4,0,12" Style="{DynamicResource Text.Muted}"
                                                   Text="{Binding WifiSignalAvailabilityDisplay}"/>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasWifiSignalData}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ItemsControl ItemsSource="{Binding WifiSignalQuality}" Grid.ColumnSpan="4">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding Quality}"/>
                                                            <TextBlock Margin="0,3,0,0" FontSize="20" FontWeight="SemiBold" Text="{Binding Count}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Quality}" Value="Fair"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Quality}" Value="Poor"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <TextBlock Text="{Binding WifiSignalEmptyMessage}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.EmptyStateMessage}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasWifiSignalData}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Width="420" Margin="0,0,12,12" Padding="16"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Needs attention"/>
                                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding WeakWifiClients}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}"/>
                                                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Band}"/><Run Text=" • "/><Run Text="{Binding Ssid}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SignalQuality}" Value="Poor"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding SignalQuality}"/><Run Text=" • "/><Run Text="{Binding Signal}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="0,10,0,0" Text="{Binding WifiSignalEmptyMessage}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.EmptyStateMessage}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasWeakWifiClients}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Wi-Fi networks"/>
                                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}"
                                               Text="Configured wireless networks and the clients associated with each SSID."/>
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Network.HealthBadge}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Success}"
                                               Text="{Binding WifiNetworks.Count, Mode=OneWay, StringFormat={}{0} networks}"/>
                                </Border>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding WifiNetworks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,12"
                                                Padding="16"
                                                Background="{DynamicResource Brush.SurfaceMuted}"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="17" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                                   Text="{Binding Ssid}"/>
                                                        <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Muted}">
                                                            <Run Text="{Binding Band}"/><Run Text="  •  Channel "/><Run Text="{Binding Channel}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusColour, Mode=OneWay}"
                                                                   Text="{Binding StatusDisplay, Mode=OneWay}"/>
                                                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right"
                                                                   Style="{DynamicResource Text.Muted}"
                                                                   Text="{Binding ClientCount, Mode=OneWay, StringFormat={}{0} connected}"/>
                                                    </StackPanel>
                                                </Grid>

                                                    <Grid Margin="0,12,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Style="{StaticResource Network.Label}" Text="INTERFACE"/>
                                                        <TextBlock Style="{StaticResource Network.Value}" Text="{Binding Interface}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Style="{StaticResource Network.Label}" Text="RADIO"/>
                                                        <TextBlock Style="{StaticResource Network.Value}" Text="{Binding Radio}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource Network.Label}" Text="SECURITY"/>
                                                        <TextBlock Style="{StaticResource Network.Value}" Text="{Binding Security}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Style="{StaticResource Network.Label}" Text="CHANNEL WIDTH"/>
                                                        <TextBlock Style="{StaticResource Network.Value}" Text="{Binding ChannelWidth}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Margin="0,4,0,8" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           Text="Connected clients"/>
                                                <Grid MaxWidth="620" Margin="0,0,0,3" HorizontalAlignment="Left">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" MinWidth="150"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource Network.Label}" Text="DEVICE"/>
                                                    <TextBlock Grid.Column="1" Margin="18,0,0,0" Text="IP ADDRESS">
                                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Network.Label}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasUsefulClientIpAddress}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Margin="18,0,0,0" Text="MAC ADDRESS">
                                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Network.Label}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasUsefulClientMacAddress}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Clients}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid MaxWidth="620" Margin="0,3" HorizontalAlignment="Left">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" MinWidth="150"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                                <TextBlock Grid.Column="1" Margin="18,0,0,0" Text="{Binding DisplayIpAddress}" Foreground="{DynamicResource Brush.TextSecondary}">
                                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.HasUsefulClientIpAddress, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="2" Margin="18,0,0,0" Text="{Binding DisplayMacAddress}" Foreground="{DynamicResource Brush.TextMuted}">
                                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.HasUsefulClientMacAddress, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasGuestWifiNetworks, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,8,0,4" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}" Text="Guest networks"/>
                                <ItemsControl ItemsSource="{Binding GuestWifiNetworks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2" Foreground="{DynamicResource Brush.TextSecondary}">
                                                <Run Text="{Binding Band, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding Ssid, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding StatusDisplay, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding ClientCount, Mode=OneWay, StringFormat={}{0} clients}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Margin="0,16,0,0"
                                       Text="No guest Wi-Fi network detected.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Network.Value}">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasGuestWifiNetworks, Mode=OneWay}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- DHCP -->
                <StackPanel x:Name="DhcpContent" Margin="0,0,0,16" Visibility="Collapsed">
                    <Border Margin="0,0,0,16" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="DHCP status"/>
                            <TextBlock Margin="0,5,0,14" Style="{DynamicResource Text.Secondary}"
                                       Text="Read-only DHCP scopes and address allocation settings."/>
                            <TextBlock FontSize="18" FontWeight="SemiBold"
                                       Foreground="{Binding DhcpStatusColour, Mode=OneWay}"
                                       Text="{Binding DhcpStatusDisplay, Mode=OneWay}"/>
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DhcpConfigurations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"><TextBlock Style="{StaticResource Network.Label}" Text="INTERFACE"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding Interface}"/></StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource Network.Label}" Text="START OFFSET"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding Start}"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Network.Label}" Text="MAXIMUM LEASES"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding Limit}"/></StackPanel>
                                            <StackPanel Grid.Column="3"><TextBlock Style="{StaticResource Network.Label}" Text="LEASE TIME"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding LeaseTime}"/></StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding DhcpWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2" Foreground="{DynamicResource Brush.Warning}" Text="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,16" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="DHCP scope capacity"/>
                            <TextBlock Margin="0,5,0,12" Style="{DynamicResource Text.Secondary}"
                                       Text="Current dynamic-pool usage. Reservations are shown separately because they can be outside the pool."/>
                            <ItemsControl ItemsSource="{Binding DhcpScopeCapacities}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12" Background="{DynamicResource Brush.SurfaceMuted}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Network.Label}" Text="SCOPE"/>
                                                    <TextBlock Style="{StaticResource Network.Value}" Text="{Binding Scope.DisplayName, Mode=OneWay}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Bottom" FontWeight="SemiBold" Text="{Binding CapacityState, Mode=OneWay}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CapacityState}" Value="Unavailable"><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding CapacityState}" Value="Getting full"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding CapacityState}" Value="Low capacity"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding CapacityState}" Value="Full"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding Scope.DynamicRangeDisplay, Mode=OneWay}"/>
                                            <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding CapacitySummary, Mode=OneWay}"/>
                                            <WrapPanel Margin="0,12,0,0">
                                                <StackPanel Margin="0,0,28,8"><TextBlock Style="{StaticResource Network.Label}" Text="INTERFACE"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding Scope.InterfaceName, Mode=OneWay}"/></StackPanel>
                                                <StackPanel Margin="0,0,28,8"><TextBlock Style="{StaticResource Network.Label}" Text="SUBNET"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding Scope.SubnetDisplay, Mode=OneWay}"/></StackPanel>
                                                <StackPanel Margin="0,0,28,8"><TextBlock Style="{StaticResource Network.Label}" Text="ROUTER ADDRESS"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding Scope.RouterAddress, Mode=OneWay, TargetNullValue=N/A}"/></StackPanel>
                                                <StackPanel Margin="0,0,28,8"><TextBlock Style="{StaticResource Network.Label}" Text="STATUS"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding Scope.Status, Mode=OneWay}"/></StackPanel>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,12,0,0">
                                                <StackPanel Margin="0,0,28,8"><TextBlock Style="{StaticResource Network.Label}" Text="ACTIVE LEASES"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding ActiveLeaseCount, Mode=OneWay}"/></StackPanel>
                                                <StackPanel Margin="0,0,28,8"><TextBlock Style="{StaticResource Network.Label}" Text="RESERVATIONS"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding EnabledReservationCount, Mode=OneWay}"/></StackPanel>
                                                <StackPanel Margin="0,0,28,8"><TextBlock Style="{StaticResource Network.Label}" Text="AVAILABLE"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding AvailableAddressDisplay, Mode=OneWay}"/></StackPanel>
                                                <StackPanel Margin="0,0,28,8"><TextBlock Style="{StaticResource Network.Label}" Text="UTILISATION"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding UtilisationDisplay, Mode=OneWay}"/></StackPanel>
                                                <StackPanel Margin="0,0,28,8"><TextBlock Style="{StaticResource Network.Label}" Text="LEASE TIME"/><TextBlock Style="{StaticResource Network.Value}" Text="{Binding Scope.LeaseTime, Mode=OneWay}"/></StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,16" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Active leases"/>
                            <TextBlock Margin="0,5,0,12" Style="{DynamicResource Text.Secondary}"
                                       Text="Devices currently listed by the router DHCP lease table."/>
                            <ListBox x:Name="DhcpLeasesList"
                                     ItemsSource="{Binding DhcpLeases}"
                                     ItemContainerStyle="{StaticResource Network.SearchTargetRow}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ClientName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding IpAddress}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding MacAddress}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding RemainingLease, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding DeviceType}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            <Button Grid.Column="5" Content="View client" Padding="9,5" Margin="8,0,0,0"
                                                    Tag="{Binding}" Click="ViewDhcpClient_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanViewClient}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="0,4,0,0" Text="No active DHCP leases.">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Network.Value}"><Setter Property="FontWeight" Value="Normal"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDhcpLeases, Mode=OneWay}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,16" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Active leases without reservations"/>
                            <TextBlock Margin="0,5,0,12" Style="{DynamicResource Text.Secondary}"
                                       Text="Current leases without an enabled DHCP reservation. Reservations are optional."/>
                            <TextBlock Margin="0,0,0,8" FontWeight="SemiBold"
                                       Text="{Binding UnreservedDhcpLeaseCount, Mode=OneWay, StringFormat={}{0} active leases without reservations}"/>
                            <ListBox ItemsSource="{Binding UnreservedDhcpLeases}"
                                     ItemContainerStyle="{StaticResource Network.SearchTargetRow}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ClientName}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding IpAddress}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding MacAddress}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding RemainingLease, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            <Button Grid.Column="4" Content="View client" Padding="9,5" Margin="8,0,0,0"
                                                    Tag="{Binding}" Click="ViewDhcpClient_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanViewClient}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="0,4,0,0" Text="All current DHCP leases have an enabled reservation.">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Network.Value}"><Setter Property="FontWeight" Value="Normal"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasUnreservedDhcpLeases, Mode=OneWay}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Static reservations"/>
                                <Button Grid.Column="1" Content="+ Add Reservation" Style="{DynamicResource Button.Primary}"
                                        Click="AddDhcpReservation_Click"
                                        IsEnabled="{Binding CanManageDhcpReservations, Mode=OneWay}"/>
                            </Grid>
                            <TextBlock Margin="0,5,0,12" Style="{DynamicResource Text.Secondary}"
                                       Text="Configured DHCP host reservations."/>
                            <TextBlock Margin="0,0,0,8" Foreground="{DynamicResource Brush.TextSecondary}" Text="Pending…"
                                       Visibility="{Binding DhcpReservationMutationInProgress, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}"/>
                            <ListBox x:Name="DhcpReservationsList"
                                     ItemsSource="{Binding DhcpReservations}"
                                     ItemContainerStyle="{StaticResource Network.SearchTargetRow}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Hostname}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MacAddress}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding IpAddress}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding ScopeDisplay, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                <Button Content="View client" Padding="9,5" Margin="8,0,0,0" Tag="{Binding}" Click="ViewDhcpClient_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanViewClient}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="Edit" Padding="9,5" Margin="8,0,0,0" Style="{DynamicResource Button.Secondary}"
                                                        Tag="{Binding}" Click="EditDhcpReservation_Click"
                                                        IsEnabled="{Binding DataContext.CanManageDhcpReservations, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                                <Button Content="Delete" Padding="9,5" Margin="6,0,0,0" Style="{DynamicResource Button.Secondary}"
                                                        Tag="{Binding}" Click="DeleteDhcpReservation_Click"
                                                        IsEnabled="{Binding DataContext.CanManageDhcpReservations, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="0,4,0,0" Text="No static DHCP reservations configured.">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Network.Value}"><Setter Property="FontWeight" Value="Normal"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDhcpReservations, Mode=OneWay}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="PortForwardContent" Margin="0,0,0,16" Visibility="Collapsed">
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Port Forwarding"/>
                                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}" Text="Forward inbound WAN traffic to a LAN device."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh" Margin="8,0,0,0" Click="RefreshPortForward_Click"/>
                                <Button Grid.Column="2" Content="Add Port Forward" Margin="8,0,0,0" Click="AddPortForward_Click" IsEnabled="{Binding PortForwardingWriteSupported, Mode=OneWay}"/>
                            </Grid>
                            <TextBlock Text="{Binding PortForwardStatus, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}"/>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{DynamicResource Text.Secondary}" Text="Show:"/>
                                <ComboBox x:Name="PortForwardFilterComboBox"
                                          MinWidth="150"
                                          Style="{StaticResource RouterPilot.ComboBox}"
                                          ItemContainerStyle="{StaticResource RouterPilot.ComboBoxItem}"
                                          SelectedIndex="0"
                                          SelectionChanged="PortForwardFilter_SelectionChanged">
                                    <ComboBoxItem Content="All"/>
                                    <ComboBoxItem Content="Needs attention"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Margin="0,10,0,0" Text="Loading port forwarding rules…" Visibility="{Binding PortForwardIsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ListBox x:Name="PortForwardRulesList"
                                     ItemsSource="{Binding PortForwardRules}"
                                     ItemContainerStyle="{StaticResource Network.SearchTargetRow}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,10,0,0" Padding="14" Background="{DynamicResource Brush.SurfaceMuted}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="8">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"/><TextBlock Text="{Binding Enabled, StringFormat=Enabled: {0}}" Style="{DynamicResource Text.Secondary}"/></StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Protocol, Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ExternalPort, Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding DestinationIp, Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding InternalPort, Mode=OneWay}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                                                        <Button Content="Edit" Tag="{Binding}" Click="EditPortForward_Click" IsEnabled="{Binding DataContext.PortForwardingWriteSupported, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <Button Content="Enable / Disable" Tag="{Binding}" Margin="6,0,0,0" Click="TogglePortForward_Click" IsEnabled="{Binding DataContext.PortForwardingWriteSupported, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <Button Content="Delete" Tag="{Binding}" Margin="6,0,0,0" Click="DeletePortForward_Click" IsEnabled="{Binding DataContext.PortForwardingWriteSupported, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Margin="0,8,0,0" Text="{Binding TargetClientName}" Foreground="{DynamicResource Brush.TextSecondary}" Visibility="{Binding HasTargetClientName, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <StackPanel Margin="0,5,0,0" Visibility="{Binding HasTargetStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding TargetStatusTitle}" FontSize="12" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TargetStatusSeverity}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding TargetStatusSeverity}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding TargetStatusSeverity}" Value="Critical"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0" Text="{Binding TargetStatusDetail}" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Visibility="{Binding HasTargetStatusDetail, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Margin="0,12,0,0" Padding="14" Background="{DynamicResource Brush.SurfaceMuted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8"><TextBlock Text="No port forwarding rules are configured."><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Network.Value}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding PortForwardRules.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                            <Border x:Name="NoPortForwardAttentionRulesState" Margin="0,12,0,0" Padding="14" Background="{DynamicResource Brush.SurfaceMuted}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                                <TextBlock Style="{DynamicResource Network.Value}" FontWeight="Normal" Text="No port forwarding rules need attention."/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- Overview details -->
                <Grid x:Name="OverviewDetailsContent" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                       Text="Internet"/>
                            <TextBlock Margin="0,5,0,6"
                                       Style="{DynamicResource Text.Secondary}"
                                       Text="WAN connection and upstream gateway."/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="PHYSICAL WAN ADDRESS"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding WanIp}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="PUBLIC INTERNET"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding PublicIpDisplay}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Visibility="{Binding IsVpnConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Text="VPN"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Visibility="{Binding IsVpnConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Text="{Binding VpnContextLine}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="GATEWAY"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding Gateway}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="LATENCY"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding Latency}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                       Text="DNS"/>
                            <TextBlock Margin="0,5,0,6"
                                       Style="{DynamicResource Text.Secondary}"
                                       Text="Upstream and advertised resolver details."/>

                            <Border Margin="0,12,0,6"
                                    Padding="12"
                                    Background="{DynamicResource Brush.SurfaceMuted}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Network.Label}"
                                               Text="DNS PATH"/>
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{DynamicResource Text.Secondary}"
                                               Text="{Binding DnsResolverPath.State}"/>
                                    <TextBlock Margin="0,3,0,8"
                                               Style="{DynamicResource Text.Muted}"
                                               TextWrapping="Wrap"
                                               Text="{Binding DnsResolverPath.Explanation}"/>

                                    <TextBlock Style="{StaticResource Network.Label}"
                                               Text="ROUTER LAN ADDRESS"/>
                                    <TextBlock Style="{StaticResource Network.Value}"
                                               TextWrapping="Wrap"
                                               Text="{Binding DnsResolverPath.RouterAddressDisplay}"/>

                                    <TextBlock Margin="0,7,0,0"
                                               Style="{StaticResource Network.Label}"
                                               Text="UPSTREAM RESOLVERS"/>
                                    <TextBlock Style="{StaticResource Network.Value}"
                                               TextWrapping="Wrap"
                                               Text="{Binding DnsResolverPath.UpstreamDisplay}"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="0,2,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Visibility="{Binding IsVpnConnected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Text="{Binding VpnDnsContext}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="ADGUARD SERVICE"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding AdGuardServiceDisplay}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="VERSION"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding AdGuardVersionDisplay}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                       Text="Router"/>
                            <TextBlock Margin="0,5,0,6"
                                       Style="{DynamicResource Text.Secondary}"
                                       Text="Router identity and runtime information."/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="MODEL"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding RouterModel}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="HOSTNAME"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding Hostname}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="OPENWRT SNAPSHOT"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding FirmwareVersion}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="ROUTER FIRMWARE"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding RouterFirmwareVersion}"/>

                            <TextBlock Style="{StaticResource Network.Label}"
                                       Text="UPTIME"/>
                            <TextBlock Style="{StaticResource Network.Value}"
                                       Text="{Binding Uptime}"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
