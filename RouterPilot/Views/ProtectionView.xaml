<UserControl x:Class="RouterPilot.Views.ProtectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{DynamicResource Brush.WindowBackground}">
    <UserControl.Resources>
        <Style x:Key="Protection.ActionButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>

        <Style x:Key="Protection.DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
        </Style>

        <Style x:Key="Protection.EnableButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Primary}">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding StatusText}" Value="Disabled"/>
                        <Condition Binding="{Binding ControlsEnabled}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="True"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Protection.DisableButton"
               TargetType="Button"
               BasedOn="{StaticResource Protection.DangerButton}">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding StatusText}" Value="Active"/>
                        <Condition Binding="{Binding ControlsEnabled}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="True"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Protection.SectionLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.CardCaption}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Protection.Option"
               TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Protection.Input"
               TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Protection.ComboBox"
               TargetType="ComboBox"
               BasedOn="{StaticResource RouterPilot.ComboBox}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="Protection.List"
               TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceMuted}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="Schedule.CompactButton"
               TargetType="Button"
               BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Schedule.FieldLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.CardCaption}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Schedule.Badge" TargetType="Border" BasedOn="{StaticResource Badge}"/>

        <DataTemplate x:Key="Schedule.ServiceSelector">
            <Grid Height="230">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Schedule.FieldLabel}" Text="SERVICES"/>
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Text.Muted}" Text="{Binding SelectedServicesSummary}"/>
                    <TextBox Grid.Column="2" Style="{StaticResource Protection.Input}"
                             Text="{Binding WindowServiceSearch, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search all services by name, category or ID"/>
                </Grid>
                <Border Grid.Row="2" Padding="10" Background="{DynamicResource Brush.SurfaceMuted}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding WindowServicesView}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="220"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <CheckBox Width="210" Margin="0,0,10,8" Style="{StaticResource Protection.Option}" IsChecked="{Binding IsSelected}">
                                    <StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding Category}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                </CheckBox>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Grid Margin="24,24,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{DynamicResource Text.PageTitle}"
                           Text="Protection"/>
                <TextBlock Margin="0,5,0,0"
                           Style="{DynamicResource Text.Secondary}"
                           Text="Manage AdGuard Home protection, filtering profiles, services and DNS rules."/>
            </StackPanel>

            <Button Grid.Column="1"
                    MinWidth="112"
                    Height="38"
                    Style="{DynamicResource Button.Secondary}"
                    Content="Refresh all"
                    Command="{Binding RefreshAllCommand}"/>
        </Grid>

        <TabControl x:Name="ProtectionTabs" Grid.Row="2" Margin="24,0,0,0"
                     Style="{StaticResource RouterPilotTabControlStyle}"
                     ItemContainerStyle="{StaticResource RouterPilotTabItemStyle}"
                     SelectionChanged="ProtectionTabs_SelectionChanged">
            <TabControl.Resources>
                <DataTemplate x:Key="ProtectionTab.Core">
                    <StackPanel>

                <TextBlock Margin="0,0,0,16"
                           Style="{DynamicResource Text.Secondary}"
                           Foreground="{DynamicResource Brush.Warning}"
                           Text="{Binding AdGuardAvailabilityMessage}"/>

                <!-- Summary cards -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="PROTECTION"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding StatusColour}"
                                       Text="{Binding StatusText}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Remaining}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="DNS FILTERING"/>
                            <CheckBox Margin="0,12,0,0"
                                      Style="{StaticResource Protection.Option}"
                                      Content="Filtering enabled"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding FilteringEnabled, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="SAFE BROWSING"/>
                            <CheckBox Margin="0,12,0,0"
                                      Style="{StaticResource Protection.Option}"
                                      Content="Protection enabled"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding SafeBrowsingEnabled, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}"
                                       Text="CURRENT PROFILE"/>
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding ProfileName}"/>
                            <TextBlock Margin="0,5,0,0"
                                       Style="{DynamicResource Text.Muted}"
                                       Text="Protection preset"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Confirmed global protection actions -->
                <Border Margin="0,0,0,16" Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                   Text="Protection Actions"/>
                        <TextBlock Margin="0,5,0,16"
                                   Style="{DynamicResource Text.Secondary}"
                                   Text="Enable or disable AdGuard Home protection."/>
                        <StackPanel Orientation="Horizontal">
                            <Button Height="38"
                                    Margin="0,0,10,0"
                                    Padding="18,8"
                                    Style="{StaticResource Protection.EnableButton}"
                                    Content="Enable"
                                    Command="{Binding EnableProtectionCommand}"/>
                            <Button Height="38"
                                    Margin="0"
                                    Padding="18,8"
                                    Style="{StaticResource Protection.DisableButton}"
                                    Content="Disable"
                                    Command="{Binding DisableProtectionCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Read-only statistics are presented on the Insights tab. -->
                <Grid Margin="0,0,0,16" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.35*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="DNS QUERIES"/>
                            <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding TotalQueriesText}"/>
                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}"
                                       Text="Current AdGuard statistics window"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="BLOCKED QUERIES"/>
                            <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding BlockedQueriesText}"/>
                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}"
                                       Text="Ads, trackers and threats blocked"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="BLOCK RATE"/>
                            <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding BlockPercentageText}"/>
                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}"
                                       Text="Percentage of queries blocked"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{DynamicResource Card.Compact}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.CardCaption}" Text="TOP BLOCKED DOMAIN"/>
                            <TextBlock Margin="0,8,0,0" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding TopBlockedDomain}"
                                       Text="{Binding TopBlockedDomain}"/>
                            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}"
                                       Text="Most frequently blocked domain"/>
                            <Button Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource Button.Secondary}"
                                    Content="View activity"
                                    ToolTip="View matching DNS activity"
                                    Visibility="{Binding HasTopBlockedDomain, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Click="ViewTopBlockedDomainActivity_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Status and options -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                               Text="Protection status"/>
                                    <TextBlock Margin="0,5,0,0"
                                               Style="{DynamicResource Text.Secondary}"
                                               Text="{Binding StatusDetail}"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Margin="16,0,0,0"
                                        Padding="12,6"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.SurfaceMuted}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               Text="{Binding StatusText}"/>
                                </Border>
                            </Grid>

                            <TextBlock Margin="0,18,0,6"
                                       Style="{StaticResource Protection.SectionLabel}"
                                       Text="PAUSE PRESETS"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Content="30 minutes"
                                        Command="{Binding Pause30Command}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Content="1 hour"
                                        Command="{Binding Pause1HourCommand}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Content="4 hours"
                                        Command="{Binding Pause4HoursCommand}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Content="Until tomorrow"
                                        Command="{Binding PauseUntilTomorrowCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                       Text="Protection options"/>
                            <TextBlock Margin="0,5,0,16"
                                       Style="{DynamicResource Text.Secondary}"
                                       Text="Changes are applied immediately to AdGuard Home."/>

                            <CheckBox Style="{StaticResource Protection.Option}"
                                      Content="DNS filtering"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding FilteringEnabled, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource Protection.Option}"
                                      Content="Safe Browsing"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding SafeBrowsingEnabled, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource Protection.Option}"
                                      Content="Safe Search"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding SafeSearchEnabled, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource Protection.Option}"
                                      Content="Parental Control"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding ParentalEnabled, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource Protection.Option}"
                                      Content="Query logging"
                                      IsEnabled="{Binding ControlsEnabled}"
                                      IsChecked="{Binding QueryLogEnabled, Mode=TwoWay}"/>

                            <Border Margin="0,8,0,16"
                                    Height="1"
                                    Background="{DynamicResource Brush.Border}"/>

                            <TextBlock Style="{StaticResource Protection.SectionLabel}"
                                       Text="QUICK PROFILES"/>
                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Margin="0,0,8,0"
                                        Content="Standard"
                                        Command="{Binding ApplyStandardProfileCommand}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Margin="0,0,8,0"
                                        Content="Family"
                                        Command="{Binding ApplyFamilyProfileCommand}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        Content="Privacy"
                                        Margin="0,0,0,0"
                                        Command="{Binding ApplyPrivacyProfileCommand}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </Grid>
                    </StackPanel>
                </DataTemplate>

                <!-- Blocked services -->
                <DataTemplate x:Key="ProtectionTab.BlockedServices">
                <Border Margin="0,0,0,16" Style="{DynamicResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                           Text="Blocked services"/>
                                <TextBlock Margin="0,5,0,0"
                                           Style="{DynamicResource Text.Secondary}"
                                           Text="Choose online services to block across the network."/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Margin="16,2,0,0"
                                       VerticalAlignment="Top"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       Text="{Binding BlockedServicesSelectionSummary}"/>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Style="{StaticResource Protection.Input}"
                                     Text="{Binding BlockedServicesSearch, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search services by name, ID or category"/>

                            <ComboBox Grid.Column="2"
                                      Height="36"
                                      Style="{StaticResource RouterPilot.ComboBox}"
                                      ItemsSource="{Binding BlockedServiceCategories}"
                                      SelectedItem="{Binding SelectedBlockedServiceCategory, Mode=TwoWay}"
                                      ToolTip="Filter services by category"/>

                            <CheckBox Grid.Column="3"
                                      Margin="16,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource Protection.Option}"
                                      Content="Blocked only"
                                      IsChecked="{Binding ShowBlockedOnly}"/>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Style="{DynamicResource Text.Secondary}"
                                       Text="{Binding BlockedServicesStatus}"/>

                            <WrapPanel Grid.Column="1" Margin="16,0,0,0">
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        MinWidth="88"
                                        Content="Select all"
                                        Command="{Binding SelectAllServicesCommand}"/>
                                <Button Style="{StaticResource Protection.ActionButton}"
                                        MinWidth="88"
                                        Content="Clear all"
                                        Command="{Binding ClearAllServicesCommand}"/>
                                <Button Style="{DynamicResource Button.Primary}"
                                        MinWidth="120"
                                        Margin="0,0,0,8"
                                        Content="Save changes"
                                        Command="{Binding SaveBlockedServicesCommand}"/>
                            </WrapPanel>
                        </Grid>

                        <ListBox Grid.Row="4"
                                         HorizontalAlignment="Stretch"
                                         ItemsSource="{Binding BlockedServicesView}"
                                         Padding="8"
                                         BorderBrush="{DynamicResource Brush.Border}"
                                         BorderThickness="1"
                                         Background="{DynamicResource Brush.SurfaceMuted}"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.CanContentScroll="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemWidth="220"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Height" Value="64"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="48"
                                                    Margin="8"
                                                    Padding="10,6"
                                                    Background="{DynamicResource Brush.Surface}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <CheckBox VerticalAlignment="Center"
                                                          HorizontalAlignment="Stretch"
                                                          HorizontalContentAlignment="Left"
                                                          FontWeight="SemiBold"
                                                          Foreground="{DynamicResource Brush.TextPrimary}"
                                                          ToolTip="{Binding Name}"
                                                          IsChecked="{Binding IsBlocked, Mode=TwoWay}"
                                                          IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                                </CheckBox>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                </DataTemplate>

                <!-- AdGuard service schedules -->
                <DataTemplate x:Key="ProtectionTab.Schedules">
                <Border Margin="0,0,0,16" Style="{DynamicResource Card}" DataContext="{Binding Schedules}"
                        IsEnabled="{Binding DataContext.ControlsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Schedules"/>
                                <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Secondary}"
                                           Text="Allow or block AdGuard services automatically at selected local times."/>
                            </StackPanel>
                            <Button Grid.Column="1" MinWidth="190" Height="36" Margin="12,0,0,0"
                                    Style="{DynamicResource Button.Primary}" Content="Add allowed-time window"
                                    Command="{Binding NewWindowCommand}" Click="OpenAllowedWindow_Click"/>
                            <Button Grid.Column="2" MinWidth="188" Height="36" Margin="8,0,0,0"
                                    Style="{DynamicResource Button.Secondary}" Content="Advanced single action"
                                    Command="{Binding NewScheduleCommand}" Click="AddSchedule_Click"/>
                        </Grid>

                        <Border Margin="0,14,0,0" Padding="10,8"
                                Background="{DynamicResource Brush.SurfaceMuted}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
                            <TextBlock Style="{DynamicResource Text.Muted}"
                                       Text="RouterPilot must be running in the notification area for schedules to run."/>
                        </Border>

                        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Windows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="14" Background="{DynamicResource Brush.SurfaceMuted}"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                            <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Name}"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <CheckBox Margin="0" VerticalAlignment="Center" Style="{StaticResource Protection.Option}"
                                                          Content="Enabled" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleWindowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                                <Button Margin="12,0,0,0" MinWidth="72" Height="32" Padding="12,4"
                                                        Style="{DynamicResource Button.Primary}" Content="Edit"
                                                        Click="EditWindow_Click"
                                                        Command="{Binding DataContext.EditWindowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource Schedule.CompactButton}" Content="⋯"
                                                        ToolTip="More allowed-time window actions" Click="WindowMenu_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="Run Allow Now" Click="RunWindowAllowNow_Click"/>
                                                            <MenuItem Header="Run Block Now" Click="RunWindowBlockNow_Click"/>
                                                            <Separator/>
                                                            <MenuItem Header="Duplicate" Click="DuplicateWindow_Click"/>
                                                            <MenuItem Header="Delete" Click="DeleteWindow_Click"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Orientation="Horizontal">
                                                <Border Style="{StaticResource Schedule.Badge}">
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Allowed-time window"/>
                                                </Border>
                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Text.Secondary}"
                                                           Text="{Binding ServiceDisplay}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="ALLOWED TIME"/>
                                                    <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding TimeRangeDisplay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="RECURRENCE / NEXT ACTION"/>
                                                    <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding RecurrenceDisplay}"/>
                                                    <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding NextActionDisplay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="LAST RESULT"/>
                                                    <TextBlock Style="{DynamicResource Text.Secondary}" Text="{Binding LastResultDisplay}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander x:Name="ScheduleEditor" Margin="0,8,0,0" Header="Advanced single-action schedule">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="SCHEDULE NAME"/>
                                    <TextBox Style="{StaticResource Protection.Input}" Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="ACTION"/>
                                    <ComboBox Style="{StaticResource Protection.ComboBox}" ItemsSource="{Binding Actions}" SelectedItem="{Binding EditorAction}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="TIMING"/>
                                    <TextBox Style="{StaticResource Protection.Input}" Text="{Binding EditorTime}" ToolTip="Local time (HH:mm)"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="RECURRENCE"/>
                                    <ComboBox Style="{StaticResource Protection.ComboBox}" ItemsSource="{Binding Recurrences}" SelectedItem="{Binding EditorRecurrence}"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Mon" IsChecked="{Binding Monday}"/>
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Tue" IsChecked="{Binding Tuesday}"/>
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Wed" IsChecked="{Binding Wednesday}"/>
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Thu" IsChecked="{Binding Thursday}"/>
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Fri" IsChecked="{Binding Friday}"/>
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Sat" IsChecked="{Binding Saturday}"/>
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Sun" IsChecked="{Binding Sunday}"/>
                                    </WrapPanel>
                                    <DatePicker Width="180" HorizontalAlignment="Left" SelectedDate="{Binding EditorOneTimeDate}" ToolTip="Date for a one-time schedule"/>
                                    <CheckBox Margin="0,8,0,0" Style="{StaticResource Protection.Option}" Content="Enabled" IsChecked="{Binding EditorIsEnabled}"/>
                                </StackPanel>
                                <ContentControl Grid.Row="4" Grid.ColumnSpan="3" Content="{Binding}" ContentTemplate="{StaticResource Schedule.ServiceSelector}"/>
                                <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Margin="0,10,0,8"
                                           Foreground="{DynamicResource Brush.Warning}" Text="{Binding Status}"/>
                                <StackPanel Grid.Row="6" Grid.ColumnSpan="3" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button MinWidth="90" Height="36" Margin="0,0,8,0" Style="{DynamicResource Button.Secondary}"
                                            Content="Cancel" Command="{Binding NewScheduleCommand}" Click="CancelSchedule_Click"/>
                                    <Button MinWidth="120" Height="36" Style="{DynamicResource Button.Primary}" Content="Save schedule" Command="{Binding SaveCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander x:Name="AllowedWindowEditor" Margin="0,10,0,0" Header="Allowed-time window editor">
                            <Grid Margin="0,12,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="WINDOW NAME"/>
                                    <TextBox Style="{StaticResource Protection.Input}" Text="{Binding WindowName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="SELECTED SERVICES"/>
                                    <TextBlock MinHeight="36" VerticalAlignment="Center" Style="{DynamicResource Text.Secondary}" Text="{Binding SelectedServicesSummary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="TIMING"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Style="{DynamicResource Text.Muted}" Text="Allow at"/><TextBox Style="{StaticResource Protection.Input}" Text="{Binding WindowAllowTime}" ToolTip="HH:mm"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Style="{DynamicResource Text.Muted}" Text="Block again"/><TextBox Style="{StaticResource Protection.Input}" Text="{Binding WindowBlockTime}" ToolTip="HH:mm"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Style="{StaticResource Schedule.FieldLabel}" Text="RECURRENCE"/>
                                    <ComboBox Style="{StaticResource Protection.ComboBox}" ItemsSource="{Binding Recurrences}" SelectedItem="{Binding WindowRecurrence}"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Mon" IsChecked="{Binding WindowMonday}"/><CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Tue" IsChecked="{Binding WindowTuesday}"/><CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Wed" IsChecked="{Binding WindowWednesday}"/><CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Thu" IsChecked="{Binding WindowThursday}"/><CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Fri" IsChecked="{Binding WindowFriday}"/><CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Sat" IsChecked="{Binding WindowSaturday}"/><CheckBox Style="{StaticResource Protection.Option}" Margin="0,0,10,8" Content="Sun" IsChecked="{Binding WindowSunday}"/>
                                    </WrapPanel>
                                    <DatePicker Width="180" HorizontalAlignment="Left" SelectedDate="{Binding WindowOneTimeDate}" ToolTip="Date for a one-time window"/>
                                    <CheckBox Margin="0,8,0,0" Style="{StaticResource Protection.Option}" Content="Enabled" IsChecked="{Binding WindowIsEnabled}"/>
                                </StackPanel>
                                <ContentControl Grid.Row="4" Grid.ColumnSpan="3" Content="{Binding}" ContentTemplate="{StaticResource Schedule.ServiceSelector}"/>
                                <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Margin="0,10,0,8" Foreground="{DynamicResource Brush.Warning}" Text="{Binding Status}"/>
                                <StackPanel Grid.Row="6" Grid.ColumnSpan="3" HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button MinWidth="90" Height="36" Margin="0,0,8,0" Style="{DynamicResource Button.Secondary}" Content="Cancel" Click="CancelWindow_Click"/>
                                    <Button MinWidth="120" Height="36" Style="{DynamicResource Button.Primary}" Content="Save window" Command="{Binding SaveWindowCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander Margin="0,12,0,0" Header="Advanced schedules">
                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding AdvancedSchedules}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12" Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding ServiceDisplay}"/><TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding NextExecutionDisplay}"/></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource Schedule.CompactButton}" Content="Edit" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Click="EditSchedule_Click"/><Button Style="{StaticResource Schedule.CompactButton}" Content="Run now" Click="RunScheduleNow_Click"/><Button Style="{StaticResource Schedule.CompactButton}" Content="Duplicate" Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/><Button Style="{StaticResource Schedule.CompactButton}" Content="Delete" Click="DeleteSchedule_Click"/></StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Border>
                </DataTemplate>

                <DataTemplate x:Key="ProtectionTab.ConfigurationDetails">
                    <Border Margin="0,0,0,16" Padding="14" Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Configuration details"/>
                            <TextBlock Margin="0,4,0,12" Style="{DynamicResource Text.Muted}"
                                       Text="Read-only context reported by AdGuard Home."/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.CardCaption}" Text="FILTERING"/>
                                    <Grid Margin="0,6,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{DynamicResource Text.Secondary}" Text="State"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding FilteringStateDisplay}"/>
                                    </Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{DynamicResource Text.Secondary}" Text="Filter update interval"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding FilteringUpdateIntervalDisplay}"/>
                                    </Grid>
                                    <TextBlock Margin="0,16,0,0" Style="{DynamicResource Text.CardCaption}" Text="QUERY LOG"/>
                                    <Grid Margin="0,6,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{DynamicResource Text.Secondary}" Text="State"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding QueryLogStateDisplay}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{DynamicResource Text.Secondary}" Text="Client IP anonymization"/><TextBlock Grid.Column="1" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Off"/><Style.Triggers><DataTrigger Binding="{Binding QueryLogAnonymizeClientIp}" Value="True"><Setter Property="Text" Value="On"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Grid>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{DynamicResource Text.Secondary}" Text="Retention"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding QueryLogRetentionDisplay}"/>
                                    </Grid>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{DynamicResource Text.Secondary}" Text="Ignored entries"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding IgnoredQueryLogEntryCount, StringFormat={}{0:N0}}"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{DynamicResource Text.CardCaption}" Text="PROTECTION SERVICES"/>
                                    <Grid Margin="0,6,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{DynamicResource Text.Secondary}" Text="Safe Browsing"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SafeBrowsingStateDisplay}"/></Grid>
                                    <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{DynamicResource Text.Secondary}" Text="Parental protection"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding ParentalStateDisplay}"/></Grid>
                                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{DynamicResource Text.Secondary}" Text="Safe Search"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SafeSearchStateDisplay}"/></Grid>
                                    <TextBlock Style="{DynamicResource Text.CardCaption}" Text="SAFE SEARCH SERVICES"/>
                                    <StackPanel Margin="0,6,0,0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{DynamicResource Text.Secondary}" Text="Bing"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SafeSearchBingDisplay}"/></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{DynamicResource Text.Secondary}" Text="DuckDuckGo"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SafeSearchDuckDuckGoDisplay}"/></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{DynamicResource Text.Secondary}" Text="Ecosia"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SafeSearchEcosiaDisplay}"/></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{DynamicResource Text.Secondary}" Text="Google"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SafeSearchGoogleDisplay}"/></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{DynamicResource Text.Secondary}" Text="Pixabay"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SafeSearchPixabayDisplay}"/></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{DynamicResource Text.Secondary}" Text="Yandex"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SafeSearchYandexDisplay}"/></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{DynamicResource Text.Secondary}" Text="YouTube"/><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SafeSearchYouTubeDisplay}"/></Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>

                <DataTemplate x:Key="ProtectionTab.DnsManagement">
                <StackPanel>
                <!-- Rules and rewrites -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                           Text="Allow and block rules"/>
                                <TextBlock Margin="0,5,0,0"
                                           Style="{DynamicResource Text.Secondary}"
                                           Text="Enter a domain without a protocol or path."/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,16,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Style="{StaticResource Protection.Input}"
                                         Text="{Binding NewRuleDomain, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1"
                                        Width="84"
                                        Margin="8,0,0,0"
                                        Style="{DynamicResource Button.Secondary}"
                                        Content="Block"
                                        Command="{Binding AddDenyRuleCommand}"/>
                                <Button Grid.Column="2"
                                        Width="84"
                                        Margin="8,0,0,0"
                                        Style="{DynamicResource Button.Secondary}"
                                        Content="Allow"
                                        Command="{Binding AddAllowRuleCommand}"/>
                            </Grid>

                            <ListBox Grid.Row="2"
                                     Height="205"
                                     Style="{StaticResource Protection.List}"
                                     ItemsSource="{Binding FilteringRules}"
                                     SelectedItem="{Binding SelectedRule}"
                                     DisplayMemberPath="Display"/>

                            <Button Grid.Row="3"
                                    Margin="0,12,0,0"
                                    MinWidth="136"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource Protection.DangerButton}"
                                    Content="Delete selected"
                                    Command="{Binding DeleteRuleCommand}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}"
                                           Text="DNS rewrites"/>
                                <TextBlock Margin="0,5,0,0"
                                           Style="{DynamicResource Text.Secondary}"
                                           Text="Return a custom IP address or domain for a DNS name."/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,16,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource Protection.SectionLabel}"
                                               Text="DOMAIN"/>
                                    <TextBox Style="{StaticResource Protection.Input}"
                                             Text="{Binding NewRewriteDomain, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Protection.SectionLabel}"
                                               Text="ANSWER"/>
                                    <TextBox Style="{StaticResource Protection.Input}"
                                             Text="{Binding NewRewriteAnswer, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Button Grid.Row="2"
                                    MinWidth="108"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource Button.Primary}"
                                    Content="Add rewrite"
                                    Command="{Binding AddRewriteCommand}"/>

                            <ListBox Grid.Row="3"
                                     Height="205"
                                     Style="{StaticResource Protection.List}"
                                     ItemsSource="{Binding DnsRewrites}"
                                     SelectedItem="{Binding SelectedRewrite}"
                                     DisplayMemberPath="Display"/>

                            <Button Grid.Row="4"
                                    Margin="0,12,0,0"
                                    MinWidth="136"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource Protection.DangerButton}"
                                    Content="Delete selected"
                                    Command="{Binding DeleteRewriteCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
                </StackPanel>
                </DataTemplate>
            </TabControl.Resources>

            <TabItem Header="Protection">
                <ScrollViewer x:Name="ProtectionScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,24,24">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProtectionTab.Core}"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProtectionTab.ConfigurationDetails}"/>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ProtectionTab.DnsManagement}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="InsightsTab" Header="Insights">
                <ScrollViewer x:Name="InsightsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,24,24">
                        <TextBlock Margin="0,0,0,16" Style="{DynamicResource Text.Secondary}"
                                   Text="Read-only AdGuard Home activity and protection statistics." />

                        <WrapPanel Margin="0,0,-12,16">
                            <Border Width="220" Margin="0,0,12,12" Style="{DynamicResource Card.Compact}">
                                <StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="DNS REQUESTS"/>
                                    <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding AdGuardQueriesDisplay}"/>
                                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}" Text="Current statistics period"/></StackPanel>
                            </Border>
                            <Border Width="220" Margin="0,0,12,12" Style="{DynamicResource Card.Compact}">
                                <StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="BLOCKED"/>
                                    <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding AdGuardBlockedDisplay}"/>
                                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}" Text="Requests stopped by protection"/></StackPanel>
                            </Border>
                            <Border Width="220" Margin="0,0,12,12" Style="{DynamicResource Card.Compact}">
                                <StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="PROTECTION RATE"/>
                                    <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding AdGuardBlockRateDisplay}"/>
                                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Muted}" Text="DNS requests blocked"/></StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border Margin="0,0,0,16" Padding="12" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="DNS activity trend"/>
                                <TextBlock Margin="0,4,0,10" Style="{DynamicResource Text.Muted}" Text="Requests and blocked requests reported by AdGuard Home."/>
                                <lvc:CartesianChart MinHeight="220" Background="Transparent" LegendPosition="Top"
                                                    Series="{Binding QueryHistorySeries}"
                                                    XAxes="{Binding QueryHistoryXAxes}"
                                                    YAxes="{Binding QueryHistoryYAxes}" />
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Padding="14" Style="{DynamicResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Top blocked domains"/>
                                    <TextBlock Margin="0,4,0,10" Style="{DynamicResource Text.Muted}" Text="Most frequently blocked domains."/>
                                    <ItemsControl ItemsSource="{Binding TopBlockedDomains}">
                                        <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}"/><TextBlock Grid.Column="1" Margin="10,0" Style="{DynamicResource Text.Secondary}" Text="{Binding Count, StringFormat={}{0:N0}}"/>
                                            <Button Grid.Column="2" Padding="8,3" Style="{DynamicResource Button.Secondary}" Tag="{Binding Name}" Content="View activity" Click="ViewInsightsDomainActivity_Click"/>
                                        </Grid></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding TopBlockedDomainsEmptyText}">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TopBlockedDomains.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="14" Style="{DynamicResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Top requested domains"/>
                                    <TextBlock Margin="0,4,0,10" Style="{DynamicResource Text.Muted}" Text="Most frequently requested domains."/>
                                    <ItemsControl ItemsSource="{Binding TopQueriedDomains}">
                                        <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}"/><TextBlock Grid.Column="1" Margin="10,0" Style="{DynamicResource Text.Secondary}" Text="{Binding Count, StringFormat={}{0:N0}}"/>
                                            <Button Grid.Column="2" Padding="8,3" Style="{DynamicResource Button.Secondary}" Tag="{Binding Name}" Content="View activity" Click="ViewInsightsDomainActivity_Click"/>
                                        </Grid></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding TopQueriedDomainsEmptyText}">
                                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TopQueriedDomains.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Margin="0,16,0,0" Padding="14" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Top clients"/>
                                <TextBlock Margin="0,4,0,10" Style="{DynamicResource Text.Muted}" Text="AdGuard client identifiers are shown for statistics only."/>
                                <ItemsControl ItemsSource="{Binding TopClients}">
                                    <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Name}"/><TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding Count, StringFormat={}{0:N0}}"/>
                                    </Grid></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding TopClientsEmptyText}">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding TopClients.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Filters">
                <ScrollViewer x:Name="FiltersScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,24,24">
                        <TextBlock Margin="0,0,0,16" Style="{DynamicResource Text.Secondary}"
                                   Text="Read-only DNS filtering configuration and custom rules reported by AdGuard Home." />

                        <WrapPanel Margin="0,0,-12,16">
                            <Border Width="170" Margin="0,0,12,12" Style="{DynamicResource Card.Compact}"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="TOTAL RULES"/><TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding TotalFilteringRuleCount, StringFormat={}{0:N0}}"/></StackPanel></Border>
                            <Border Width="170" Margin="0,0,12,12" Style="{DynamicResource Card.Compact}"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="BLOCK"/><TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding BlockFilteringRuleCount, StringFormat={}{0:N0}}"/></StackPanel></Border>
                            <Border Width="170" Margin="0,0,12,12" Style="{DynamicResource Card.Compact}"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="ALLOW"/><TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding AllowFilteringRuleCount, StringFormat={}{0:N0}}"/></StackPanel></Border>
                            <Border Width="170" Margin="0,0,12,12" Style="{DynamicResource Card.Compact}"><StackPanel><TextBlock Style="{DynamicResource Text.CardCaption}" Text="CUSTOM"/><TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding CustomFilteringRuleCount, StringFormat={}{0:N0}}"/></StackPanel></Border>
                        </WrapPanel>

                        <Border Padding="14" Style="{DynamicResource Card}">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Custom filtering rules"/>
                                <TextBlock Margin="0,4,0,10" Style="{DynamicResource Text.Muted}" Text="Read-only rules reported by AdGuard Home. Allow is a rule classification, not a separate allowlist."/>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="220"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{DynamicResource Text.Secondary}" Text="Show"/>
                                    <ComboBox Grid.Column="2"
                                              SelectedValue="{Binding FilterRulesType}"
                                              SelectedValuePath="Content"
                                              Style="{StaticResource RouterPilot.ComboBox}"
                                              ItemContainerStyle="{StaticResource RouterPilot.ComboBoxItem}">
                                        <ComboBoxItem Content="All"/><ComboBoxItem Content="Block"/><ComboBoxItem Content="Allow"/><ComboBoxItem Content="Custom"/>
                                    </ComboBox>
                                    <Grid Grid.Column="4">
                                        <TextBox x:Name="FilterRulesSearchBox"
                                                 Style="{StaticResource Protection.Input}"
                                                 Text="{Binding FilterRulesSearch, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Search rules"/>
                                        <TextBlock Panel.ZIndex="1"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="Search">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Text, ElementName=FilterRulesSearchBox}" Value=""/>
                                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FilterRulesSearchBox}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Style="{DynamicResource Text.CardCaption}" Text="TYPE"/><TextBlock Grid.Column="1" Style="{DynamicResource Text.CardCaption}" Text="RULE"/></Grid>
                                <ListBox MaxHeight="420" IsHitTestVisible="False" ItemsSource="{Binding FilteringRulesView}"
                                         Style="{StaticResource Protection.List}"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.CanContentScroll="True">
                                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="6,4"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{DynamicResource Text.Muted}" Text="{Binding Type}"/>
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Rule}"/>
                                    </Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Margin="0,10,0,0" Text="No custom filtering rules are configured.">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasFilteringRulesData}" Value="True"/><Condition Binding="{Binding TotalFilteringRuleCount}" Value="0"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,10,0,0" Text="Filtering rules are temporarily unavailable.">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFilteringRulesData}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,16,0,0" Style="{DynamicResource Text.Muted}" TextWrapping="Wrap"
                                   Text="Filter-list names, source URLs, per-list rule counts, and update status are not supplied by RouterPilot's current proven AdGuard read contract." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Blocklists">
                <ScrollViewer x:Name="BlocklistsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,24,24">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Blocklists"/>
                            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Secondary}" TextWrapping="Wrap"
                                       Text="Manage AdGuard Home DNS blocklist subscriptions. AdGuard Home downloads and processes the lists."/>
                        </StackPanel>

                        <TextBlock Margin="0,0,0,12" Style="{DynamicResource Text.Secondary}" Text="{Binding BlocklistsStatus}"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="BlocklistSearchBox" Grid.Column="0" Width="280" HorizontalAlignment="Left"
                                     Style="{StaticResource Protection.Input}"
                                     Text="{Binding BlocklistSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search blocklists by name or URL"/>
                            <TextBlock Panel.ZIndex="1" Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextSecondary}" Text="Search">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=BlocklistSearchBox}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=BlocklistSearchBox}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="2" Style="{DynamicResource Button.Secondary}" Content="Update all"
                                    Command="{Binding UpdateAllBlocklistsCommand}"/>
                            <Button Grid.Column="4" Style="{DynamicResource Button.Primary}" Content="Add blocklist" Click="AddBlocklist_Click"/>
                        </Grid>

                        <ListBox ItemsSource="{Binding BlocklistsView}" Style="{StaticResource Protection.List}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Secondary}" Text="{Binding Url}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>
                                                <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Muted}" Text="{Binding Status}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"><TextBlock Style="{DynamicResource Text.CardCaption}" Text="STATE"/><TextBlock Margin="0,4,0,0" Text="{Binding EnabledDisplay}"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Style="{DynamicResource Text.CardCaption}" Text="RULES"/><TextBlock Margin="0,4,0,0" Text="{Binding RuleCountDisplay}"/></StackPanel>
                                            <StackPanel Grid.Column="3"><TextBlock Style="{DynamicResource Text.CardCaption}" Text="UPDATED"/><TextBlock Margin="0,4,0,0" Text="{Binding LastUpdatedDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastUpdated}"/></StackPanel>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Margin="0,0,8,0" Style="{DynamicResource Button.Secondary}" Content="Edit" Tag="{Binding}" Click="EditBlocklist_Click"/>
                                                <Button Margin="0,0,8,0" Style="{DynamicResource Button.Secondary}" Content="Enable/Disable"
                                                        Command="{Binding DataContext.ToggleBlocklistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <Button Style="{DynamicResource Button.Secondary}" Content="Remove" Tag="{Binding}" Click="RemoveBlocklist_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="0,12,0,0" Text="No blocklists match the current search.">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding BlocklistsLoaded}" Value="True"/><Condition Binding="{Binding Blocklists.Count}" Value="0"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Blocked Services">
                <ScrollViewer x:Name="BlockedServicesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Margin="0,0,24,24" Content="{Binding}" ContentTemplate="{StaticResource ProtectionTab.BlockedServices}"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Schedules">
                <ScrollViewer x:Name="SchedulesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Margin="0,0,24,24" Content="{Binding}" ContentTemplate="{StaticResource ProtectionTab.Schedules}"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
